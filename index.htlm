<!DOCTYPE html>
<html lang="fr">
<head>
<meta name="application-name" content="VLT Food Management">
<meta name="theme-color" content="#101827">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VLT Food Management — V1.41 Équipe & établissements — Carte mentale interactive</title>
<style>
:root{--bg:#f2f5f8;--panel:#fff;--ink:#18212f;--muted:#697586;--line:#e1e7ef;--accent:#f3a712;--accent-dark:#b87500;--nav:#121c29;--green:#19734a;--red:#b93838;--shadow:0 8px 24px #17212d0a}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:var(--bg);color:var(--ink)}
.app{display:grid;grid-template-columns:235px 1fr;min-height:100vh}.sidebar{background:linear-gradient(180deg,#121c29 0%,#1c2a3a 100%);color:white;padding:24px 16px;box-shadow:4px 0 24px #17212d0b}.brand{font-size:21px;font-weight:800;letter-spacing:-.5px;margin:0 8px 5px}.brand span{color:var(--accent)}.subbrand{font-size:12px;color:#aeb8c5;margin:0 8px 28px}.nav{display:grid;gap:6px}.nav button{border:0;background:transparent;color:#d4dbe4;text-align:left;padding:12px;border-radius:9px;font-size:14px;cursor:pointer}.nav button.active,.nav button:hover{background:#2a3746;color:#fff}.nav button.active{box-shadow:inset 3px 0 var(--accent)}.sidebar-note{font-size:12px;color:#aeb8c5;line-height:1.5;margin:30px 8px}
main{padding:26px;max-width:1400px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:24px}.eyebrow{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:700}.top h1{font-size:29px;margin:5px 0 0;letter-spacing:-.8px}.demo{font-size:12px;background:#fff4d9;color:#805500;padding:8px 11px;border-radius:999px;font-weight:700}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.card,.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow)}.stat-label{font-size:13px;color:var(--muted)}.stat-value{font-size:27px;font-weight:800;margin:9px 0 4px;letter-spacing:-.7px}.stat-foot{font-size:12px;color:var(--muted)}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(270px,.85fr);gap:16px}.panel{margin-bottom:16px}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px}.panel h2{font-size:16px;margin:0}.muted{color:var(--muted);font-size:13px}.btn{border:1px solid var(--line);background:white;padding:10px 13px;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;color:var(--ink);transition:transform .12s ease,box-shadow .12s ease}.btn:hover{box-shadow:0 4px 12px #17212d12;transform:translateY(-1px)}.btn.primary{background:var(--accent);border-color:var(--accent);color:#241a06}.btn:hover{filter:brightness(.97)}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th{text-align:left;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;padding:10px 8px;border-bottom:1px solid var(--line)}td{padding:12px 8px;border-bottom:1px solid var(--line)}tr:last-child td{border-bottom:0}.pill{display:inline-block;border-radius:999px;padding:5px 8px;font-size:11px;font-weight:700}.pill.low{background:#fff0ee;color:var(--red)}.pill.ok{background:#e7f6ed;color:var(--green)}.pill.warn{background:#fff4d9;color:#805500}.empty{padding:24px;text-align:center;color:var(--muted);font-size:13px}.quick-list{display:grid;gap:10px}.quick{display:flex;align-items:center;gap:10px;border:1px solid var(--line);padding:11px;border-radius:10px}.dot{width:9px;height:9px;border-radius:50%;background:var(--accent);flex:none}.quick strong{font-size:13px;display:block}.quick small{font-size:12px;color:var(--muted)}.page{display:none}.page.active{display:block}.role-note{font-size:12px;color:var(--muted);margin:0 0 15px}.photo-preview{max-width:100%;max-height:240px;border-radius:10px;border:1px solid var(--line);display:none;margin-top:10px}.history-row{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}.history-row:last-child{border-bottom:0}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:700;color:var(--muted)}input,select,textarea{font:inherit;font-size:14px;padding:10px 11px;border:1px solid #d9dfe7;border-radius:8px;background:#fff;width:100%;color:var(--ink)}.form-actions{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}.notice{background:#fff8e8;border:1px solid #f3dfb1;color:#76510b;padding:12px;border-radius:10px;font-size:12px;line-height:1.5;margin-bottom:15px}.recipe-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ingredient-row{display:grid;grid-template-columns:minmax(150px,1.4fr) minmax(90px,.7fr) minmax(85px,.6fr) 38px;gap:8px;align-items:end;padding:10px 0;border-bottom:1px solid var(--line)}.ingredient-cost{font-size:13px;font-weight:800;padding:10px 0;text-align:right}.stock-hint{font-size:11px;color:var(--muted);margin-top:4px}@media(max-width:600px){.ingredient-row{grid-template-columns:minmax(0,1fr) minmax(90px,.6fr)}.ingredient-row .ingredient-cost{padding:0;text-align:left}.ingredient-row .field{min-width:0}}.recipe{border:1px solid var(--line);border-radius:11px;padding:14px}.recipe h3{font-size:14px;margin:0 0 6px}.recipe p{font-size:12px;color:var(--muted);margin:0 0 10px}.recipe .cost{font-size:20px;font-weight:800}.recipe .cost small{font-size:12px;color:var(--muted);font-weight:500}.checkrow{display:flex;gap:9px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px}.checkrow input{width:auto;margin-top:3px}.footer{font-size:11px;color:var(--muted);padding:10px 2px 20px}
@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{padding:15px}.brand{display:inline-block}.subbrand{display:inline-block;margin:0 0 0 8px}.nav{display:flex;overflow:auto;margin-top:15px}.nav button{white-space:nowrap}.sidebar-note{display:none}main{padding:17px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.layout{grid-template-columns:1fr}}
@media(max-width:520px){.top{align-items:flex-start;flex-direction:column}.top h1{font-size:24px}.stats{gap:9px}.card{padding:13px}.stat-value{font-size:23px}.form-grid,.recipe-grid{grid-template-columns:1fr}.panel{padding:14px}}

.low-stock-list{display:grid;gap:9px}
.low-stock-item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid #f0d8a5;border-radius:12px;background:#fffaf0}
.low-stock-item strong{display:block}
.low-stock-item small{display:block;color:var(--muted);margin-top:4px}
.low-stock-item.is-out{border-color:#efb4b4;background:#fff4f4}
.low-stock-badge{font-size:11px;font-weight:800;white-space:nowrap;padding:5px 8px;border-radius:999px;background:#ffedc2;color:#805400}
.is-out .low-stock-badge{background:#ffe0e0;color:#9c2424}
.empty-state{padding:18px 12px;text-align:center;color:var(--muted);background:#f7faf8;border-radius:12px}

.event-list{display:grid;gap:12px}
.event-card{border:1px solid var(--line);border-radius:14px;padding:15px;background:#fff}
.event-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}
.event-meta{color:var(--muted);font-size:13px;margin-top:5px}
.event-detail{margin-top:12px;padding:10px 12px;border-radius:9px;background:#f6f8fb;white-space:pre-wrap;overflow-wrap:anywhere}
.event-detail strong{display:block;margin-bottom:4px}
.event-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.event-past{opacity:.7}

.quote-card,.calendar-item{border:1px solid var(--line);border-radius:13px;padding:14px;margin-bottom:10px;background:#fff}
.quote-card h3,.calendar-item h3{margin:0 0 5px}
.quote-status{font-size:12px;font-weight:800;border-radius:20px;padding:5px 9px;background:#edf2f7;display:inline-block}
.quote-status.accepted{background:#e0f5e8;color:#17663c}
.quote-status.rejected{background:#ffe4e4;color:#992a2a}
.quote-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.calendar-item{display:flex;gap:14px;align-items:flex-start}
.calendar-date{min-width:88px;text-align:center;padding:10px;border-radius:10px;background:#f2f5f9;font-weight:800}

.quote-line-row{display:grid;grid-template-columns:minmax(130px,1.5fr) minmax(70px,.5fr) minmax(90px,.7fr) minmax(90px,.7fr) 38px;gap:7px;align-items:end;padding:10px 0;border-bottom:1px solid var(--line)}
@media(max-width:650px){.quote-line-row{grid-template-columns:1fr 1fr}.quote-line-row .quote-line-description{grid-column:1/-1}}

/* Notifications locales V1.7 */
#notification-panel{display:none;position:fixed;z-index:1000;right:16px;top:82px;width:min(420px,calc(100vw - 24px));max-height:75vh;overflow:auto;background:#fff;border:1px solid #dce3ec;border-radius:14px;box-shadow:0 16px 48px #17212d30;padding:16px;color:#18212f}
#notification-panel.open{display:block}
#notification-panel .notif-item{padding:12px 0;border-bottom:1px solid #e1e7ef}
#notification-panel .notif-item:last-child{border-bottom:0}
#notification-panel .notif-title{font-weight:750}
#notification-panel .notif-muted{font-size:13px;color:#697586;margin-top:4px}
#notification-panel .notif-empty{padding:18px 0;color:#697586}
@media(max-width:700px){#notification-panel{top:70px;right:8px}}


/* V1.40 — navigation en carte mentale, indépendante des données métier */
.vlt-mindmap-launch{background:#17283a!important;color:#fff!important;border-color:#17283a!important;font-weight:750!important}
.vlt-mindmap{display:none;position:fixed;inset:0;z-index:10000;background:rgba(9,17,29,.72);backdrop-filter:blur(8px);padding:clamp(8px,2vw,24px);overflow:auto}
.vlt-mindmap.open{display:block}
.vlt-mindmap-shell{max-width:1180px;min-height:min(850px,calc(100vh - 32px));margin:0 auto;background:#f4f7fb;border:1px solid #dfe6ef;border-radius:24px;box-shadow:0 24px 80px #0004;overflow:hidden;display:flex;flex-direction:column}
.vlt-mindmap-header{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding:25px 28px 20px;background:linear-gradient(120deg,#111d2c,#213a51);color:#fff}
.vlt-mindmap-header h2{font-size:clamp(22px,3vw,31px);margin:5px 0 7px;letter-spacing:-.7px}.vlt-mindmap-header p{margin:0;color:#c4d0dc;font-size:14px;line-height:1.5}.vlt-mm-kicker{font-size:11px;letter-spacing:1.6px;font-weight:800;color:#f3bf4f}
.vlt-mm-close{border:1px solid #ffffff40;background:#ffffff12;color:#fff;border-radius:12px;width:42px;height:42px;font-size:20px;cursor:pointer;flex:0 0 auto}.vlt-mm-tools{display:flex;gap:10px;padding:16px 24px 5px;align-items:center}.vlt-mm-search{display:flex;align-items:center;gap:9px;flex:1;background:#fff;border:1px solid #dbe3ec;border-radius:12px;padding:0 13px;min-width:0}.vlt-mm-search span{font-size:24px;color:#6d7d90}.vlt-mm-search input{border:0!important;outline:none!important;box-shadow:none!important;background:transparent!important;width:100%;min-width:0;padding:12px 0!important;font-size:14px!important}
.vlt-mm-canvas{position:relative;padding:22px 24px 24px;flex:1}.vlt-mm-root{display:flex;justify-content:center;align-items:center;gap:13px;width:max-content;max-width:100%;margin:0 auto 25px;padding:15px 22px;background:#17283a;color:#fff;border:1px solid #2d4359;border-radius:16px;box-shadow:0 8px 20px #17283a20;position:relative}.vlt-mm-root:after{content:"";position:absolute;height:25px;width:2px;background:#c3cedb;top:100%;left:50%}.vlt-mm-root-icon{display:grid;place-items:center;width:40px;height:40px;background:#f3bd4e;color:#17283a;border-radius:12px;font-size:23px}.vlt-mm-root strong{display:block;font-size:14px;letter-spacing:.4px}.vlt-mm-root small{display:block;color:#c7d2de;font-size:12px;margin-top:4px}
.vlt-mm-branches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;position:relative}.vlt-mm-branch{align-self:start;min-width:0;background:#fff;border:1px solid #dfe6ee;border-radius:16px;box-shadow:0 4px 14px #17212d08;overflow:hidden;transition:border-color .15s,box-shadow .15s}.vlt-mm-branch.open{border-color:#e7b343;box-shadow:0 8px 22px #17212d10}.vlt-mm-branch-head{width:100%;display:flex;align-items:center;gap:11px;text-align:left;padding:15px 13px;border:0;background:#fff;cursor:pointer;color:#182536}.vlt-mm-branch-head:hover{background:#f9fbfe}.vlt-mm-icon{width:40px;height:40px;display:grid;place-items:center;flex:0 0 40px;border-radius:12px;background:#edf2f8;color:#243d57;font-size:22px}.vlt-mm-branch:nth-child(3n+2) .vlt-mm-icon{background:#fff3d8;color:#9b6900}.vlt-mm-branch:nth-child(3n) .vlt-mm-icon{background:#e3f5ed;color:#16724c}.vlt-mm-branch-head strong{display:block;font-size:14px}.vlt-mm-branch-head small{display:block;font-size:11px;line-height:1.4;color:#718096;margin-top:4px}.vlt-mm-chevron{margin-left:auto;color:#7b8796;font-size:20px;font-weight:400}.vlt-mm-children{display:none;padding:0 12px 12px 64px;gap:7px}.vlt-mm-branch.open .vlt-mm-children{display:grid;animation:vlt-mm-in .16s ease-out}.vlt-mm-children button{display:block;text-align:left;width:100%;border:1px solid #e5eaf1;background:#f7f9fc;border-radius:9px;padding:10px 11px;color:#27384b;font-size:12px;cursor:pointer;line-height:1.3}.vlt-mm-children button:after{content:' ↗';float:right;color:#a17a25}.vlt-mm-children button:hover{border-color:#e6b546;background:#fff8e7;color:#17283a}.vlt-mm-children button[hidden],.vlt-mm-branch[hidden]{display:none!important}.vlt-mm-empty{text-align:center;padding:28px;color:#6b7788}.vlt-mm-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 24px;border-top:1px solid #e0e7ef;background:#fff;color:#657386;font-size:12px}.vlt-mm-footer .primary{background:#17283a;color:#fff;border-color:#17283a}
@keyframes vlt-mm-in{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:820px){.vlt-mm-branches{grid-template-columns:repeat(2,minmax(0,1fr))}.vlt-mindmap-header{padding:20px}.vlt-mm-canvas{padding:18px 14px}.vlt-mm-tools{padding:13px 14px 4px}.vlt-mm-footer{padding:12px 14px}}
@media(max-width:520px){.vlt-mindmap{padding:0}.vlt-mindmap-shell{min-height:100vh;border-radius:0}.vlt-mindmap-header{padding:18px 15px}.vlt-mindmap-header p{font-size:12px}.vlt-mm-branches{grid-template-columns:1fr;gap:9px}.vlt-mm-root{margin-bottom:23px;padding:12px 15px}.vlt-mm-tools{flex-wrap:wrap}.vlt-mm-search{flex-basis:100%}.vlt-mm-footer{align-items:stretch;flex-direction:column}.vlt-mm-footer .btn{width:100%}}
@media(prefers-reduced-motion:reduce){.vlt-mm-children{animation:none!important}}

</style>

<style>
#staff-calendar .km-cal-grid{display:grid;grid-template-columns:repeat(7,minmax(105px,1fr));gap:6px;overflow-x:auto}
#staff-calendar .km-cal-day{border:1px solid var(--border-color,#ddd);border-radius:10px;padding:8px;min-height:125px;background:var(--card-bg,transparent);cursor:pointer}
#staff-calendar .km-cal-day:hover{border-color:var(--accent,#888)}
#staff-calendar .km-cal-day.km-today{outline:2px solid var(--accent,#888)}
#staff-calendar .km-cal-day.km-other{opacity:.55}
#staff-calendar .km-cal-dayhead{font-weight:700;font-size:12px;margin-bottom:8px}
#staff-calendar .km-cal-shift{font-size:11px;line-height:1.35;border-radius:6px;padding:5px;margin:4px 0;background:var(--surface-secondary,#eee);overflow-wrap:anywhere}
#staff-calendar .km-cal-shift strong{display:block}
#staff-calendar .km-cal-month{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}
#staff-calendar .km-cal-month .km-cal-day{min-height:100px}
#staff-calendar .km-cal-weekhead{font-size:11px;font-weight:700;text-align:center;padding:5px}
#staff-calendar .km-cal-legend{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;font-size:12px}
#staff-calendar .km-cal-legend span{display:inline-flex;align-items:center;gap:5px}
#staff-calendar .km-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
@media(max-width:700px){#staff-calendar .km-cal-grid{grid-template-columns:repeat(7,125px)}#staff-calendar .km-cal-month .km-cal-day{min-height:65px;padding:4px;font-size:10px}#staff-calendar .km-cal-month .km-cal-shift{font-size:9px;padding:3px}}
</style>

<style id="km-v190-professional-ui">
:root{
 --km-ink:#17212f;--km-muted:#667085;--km-line:#e5e9f0;--km-bg:#f4f7fb;
 --km-brand:#2457d6;--km-brand-dark:#173f9d;--km-green:#16835d;--km-warn:#b96a08;
 --km-radius:16px;
}
body{background:var(--km-bg)!important;color:var(--km-ink)!important}
header,.header,.app-header{box-shadow:0 8px 28px rgba(20,35,70,.10)!important}
main,.main,.app-main{max-width:1440px;margin-left:auto!important;margin-right:auto!important}
.panel,.card,.stat-card,.modal-content{
 border:1px solid var(--km-line)!important;border-radius:var(--km-radius)!important;
 box-shadow:0 4px 16px rgba(25,42,80,.045)!important;background:#fff
}
.panel{padding:20px!important;margin-bottom:18px!important}
.panel-head{gap:12px!important;align-items:center!important}
.panel-head h2,h2{letter-spacing:-.025em}
button,.btn{border-radius:10px!important;font-weight:650!important;transition:transform .12s ease,box-shadow .12s ease}
button:hover,.btn:hover{transform:translateY(-1px);box-shadow:0 5px 14px rgba(36,87,214,.13)}
input,select,textarea{border:1px solid #d5dce8!important;border-radius:9px!important;min-height:40px;background:#fff}
input:focus,select:focus,textarea:focus{outline:3px solid rgba(36,87,214,.14)!important;border-color:var(--km-brand)!important}
table{border-collapse:separate!important;border-spacing:0!important;overflow:hidden;border:1px solid var(--km-line);border-radius:12px;background:#fff}
th{background:#f5f7fb!important;color:#475467!important;font-size:12px!important;text-transform:uppercase;letter-spacing:.035em}
td,th{padding:11px 12px!important;border-bottom:1px solid var(--km-line)!important}
tr:last-child td{border-bottom:0!important}
nav button,.nav button,.sidebar button{border-radius:10px!important}
.quick{border:1px solid var(--km-line);border-radius:12px;background:#fff;padding:12px;margin:8px 0}
.pill{border-radius:999px!important}
#central-alert-panel{border-top:4px solid var(--km-brand)!important}
#company-details-panel{border-top:4px solid var(--km-green)!important}
.km-v190-banner{
 display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;
 margin:0 0 18px;padding:20px 22px;border-radius:18px;color:#fff;
 background:linear-gradient(120deg,#142d66,#2457d6 68%,#4779ed);
 box-shadow:0 12px 28px rgba(36,87,214,.18)
}
.km-v190-banner h1{margin:0;font-size:clamp(21px,3vw,30px);letter-spacing:-.035em;color:#fff}
.km-v190-banner p{margin:6px 0 0;color:#e0e9ff;font-size:13px}
.km-v190-tag{font-size:12px;padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.24);white-space:nowrap}
.km-v190-tip{font-size:12px;color:var(--km-muted);margin-top:12px}
@media(max-width:680px){
 .panel{padding:14px!important}
 .km-v190-banner{padding:16px}
 table{display:block;overflow-x:auto}
 .panel-head{flex-wrap:wrap}
}
@media print{
 body{background:#fff!important}
 .km-v190-banner{display:none!important}
 .panel,.card{box-shadow:none!important}
}
</style>

<style>@media(max-width:700px){#vlt-messaging-layout{grid-template-columns:1fr!important}#vlt-chat-messages{height:260px!important}}</style>

<style id="vlt-v112-design">
:root{
 --vlt-bg:#f5f7fb;--vlt-surface:#fff;--vlt-text:#182230;--vlt-muted:#697586;
 --vlt-border:#e4e9f1;--vlt-primary:#2563eb;--vlt-primary-dark:#1d4ed8;
 --vlt-green:#0f9f75;--vlt-red:#dc4545;--vlt-amber:#c47a12;
 --vlt-radius:16px;--vlt-shadow:0 8px 24px rgba(16,24,40,.055);
}
html{background:var(--vlt-bg);scroll-behavior:smooth}
body{background:var(--vlt-bg)!important;color:var(--vlt-text)!important;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;font-size:14px;line-height:1.5}
body *{box-sizing:border-box}
h1,h2,h3,h4{letter-spacing:-.035em;color:var(--vlt-text)}
h1{font-size:clamp(24px,3vw,32px)!important;font-weight:750!important}
h2{font-size:20px!important;font-weight:720!important}
h3{font-size:15px!important;font-weight:700!important}
p,.muted,small{color:var(--vlt-muted)}
header,.header,.app-header{box-shadow:none!important}
nav{gap:5px!important}
nav button,nav a,[data-page]{
 border:0!important;border-radius:10px!important;padding:10px 12px!important;
 color:#536174!important;background:transparent!important;font-weight:600!important;
 text-align:left;transition:background .15s,color .15s,transform .15s;
}
nav button:hover,nav a:hover,[data-page]:hover{background:#edf2ff!important;color:var(--vlt-primary)!important;transform:translateX(2px)}
nav button.active,nav a.active,[data-page].active{background:#e9efff!important;color:var(--vlt-primary)!important}
.panel,.card,.stat-card,.modal-content{
 background:var(--vlt-surface)!important;border:1px solid var(--vlt-border)!important;
 border-radius:var(--vlt-radius)!important;box-shadow:var(--vlt-shadow)!important;
}
.panel{padding:22px!important;margin-bottom:18px!important}
.panel-head{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px}
.panel-head h2,.panel-head h3{margin:0}
.card{padding:17px!important}
.stat-value{font-size:28px!important;font-weight:760!important;letter-spacing:-.05em}
.stat-label{font-size:12px!important;font-weight:650;color:var(--vlt-muted)!important}
.stat-foot{font-size:11px!important;color:var(--vlt-muted)!important}
button,.btn{border-radius:10px!important;border:1px solid var(--vlt-border)!important;padding:9px 13px!important;font-weight:650!important;box-shadow:none!important;transition:background .15s,border-color .15s,transform .15s}
button:hover,.btn:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(16,24,40,.08)!important}
button.primary,.btn.primary,.primary{background:var(--vlt-primary)!important;color:white!important;border-color:var(--vlt-primary)!important}
button.primary:hover,.btn.primary:hover{background:var(--vlt-primary-dark)!important}
input,select,textarea{
 width:100%;max-width:100%;border:1px solid #d6deea!important;border-radius:10px!important;
 background:#fff!important;color:var(--vlt-text)!important;padding:10px 12px!important;
 min-height:42px;font:inherit!important;box-shadow:none!important;
}
input:focus,select:focus,textarea:focus{outline:3px solid rgba(37,99,235,.12)!important;border-color:var(--vlt-primary)!important}
label{font-size:12px!important;font-weight:650!important;color:#475467!important;margin-bottom:6px;display:block}
.form-grid{gap:14px!important}
.form-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
table{width:100%;border-collapse:separate!important;border-spacing:0!important;background:white;border:1px solid var(--vlt-border);border-radius:12px;overflow:hidden}
thead th,th{background:#f8faff!important;color:#667085!important;text-transform:uppercase;font-size:10px!important;letter-spacing:.07em;font-weight:750!important}
td,th{padding:12px!important;border-bottom:1px solid #edf0f5!important}
tbody tr:hover{background:#f9fbff}
tbody tr:last-child td{border-bottom:0!important}
.pill,.badge{border-radius:999px!important;padding:4px 9px!important;font-size:11px!important;font-weight:700!important}
.quick{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--vlt-border)!important;border-radius:12px!important;padding:13px!important;margin:8px 0}
.quick small{display:block;margin-top:3px}
.empty{padding:22px;text-align:center;color:var(--vlt-muted);background:#f8faff;border:1px dashed #d9e1ed;border-radius:12px}
#central-alert-panel{border-top:3px solid var(--vlt-primary)!important}
#company-details-panel{border-top:3px solid var(--vlt-green)!important}
.km-v190-banner,#km-v190-banner{
 background:linear-gradient(120deg,#12213b 0%,#1c3e75 58%,#2563eb 100%)!important;
 border-radius:20px!important;padding:24px 26px!important;box-shadow:0 14px 32px rgba(29,78,216,.17)!important;
 margin-bottom:22px!important;
}
.km-v190-banner h1,#km-v190-banner h1{font-size:28px!important;letter-spacing:-.04em!important;font-weight:800!important}
.km-v190-tag{border-radius:999px!important;background:rgba(255,255,255,.12)!important;font-weight:650}
#messagerie .panel{box-shadow:none!important}
#vlt-messaging-layout{align-items:stretch}
#vlt-conversation-list .btn{border:1px solid transparent!important;box-shadow:none!important;white-space:normal;overflow-wrap:anywhere}
#vlt-conversation-list .btn:hover{border-color:#cbd8ff!important}
#vlt-chat-messages{background:#f5f7fb!important;border-color:#e3e8f0!important}
#vlt-message-text,#vlt-announcement-text{resize:vertical}
@media(max-width:800px){
 .panel{padding:15px!important}
 .km-v190-banner,#km-v190-banner{padding:18px!important}
 .stats{grid-template-columns:repeat(auto-fit,minmax(125px,1fr))!important}
 .form-grid{grid-template-columns:1fr!important}
 #vlt-messaging-layout{grid-template-columns:1fr!important}
}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
@media print{
 body{background:white!important;color:#111!important}
 .km-v190-banner,#km-v190-banner{display:none!important}
 .panel,.card{box-shadow:none!important}
}
</style>

<style id="vlt-premium-design-v113">
:root{--vlt-ink:#172033;--vlt-muted:#69758b;--vlt-primary:#3157d5;--vlt-primary-dark:#2445b7;--vlt-soft:#eef3ff;--vlt-border:#e4e9f2;--vlt-surface:#fff;--vlt-bg:#f4f7fc;--vlt-radius:18px;--vlt-shadow:0 8px 28px rgba(27,42,78,.07)}
html{background:var(--vlt-bg)}body{background:linear-gradient(145deg,#f7f9ff,#f2f5fb 55%,#f8faff)!important;color:var(--vlt-ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;letter-spacing:-.012em}
h1,h2,h3,h4{letter-spacing:-.035em;color:#17233b}h1{font-weight:850}h2{font-weight:800}h3{font-weight:750}
button,.btn{border-radius:12px!important;font-weight:700!important;transition:transform .16s ease,box-shadow .16s ease,background .16s ease!important}button:hover,.btn:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(49,87,213,.14)}
input,select,textarea{border:1px solid #dce3ef!important;border-radius:11px!important;background:#fff!important;min-height:42px}input:focus,select:focus,textarea:focus{outline:none!important;border-color:#7894f3!important;box-shadow:0 0 0 4px rgba(49,87,213,.10)!important}
table{border-collapse:separate!important;border-spacing:0;width:100%;overflow:hidden;border-radius:14px}th{background:#f4f7fc!important;color:#64718a!important;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em}td,th{border-bottom:1px solid #e9edf5!important;padding:13px 14px!important}
.card,.stat-card,.dashboard-card,.panel,.modal-content,.section-card{border:1px solid rgba(224,231,242,.9)!important;border-radius:var(--vlt-radius)!important;box-shadow:var(--vlt-shadow)!important;background:rgba(255,255,255,.94)!important}
@media(max-width:720px){.card,.stat-card,.dashboard-card,.panel,.section-card{padding:15px;border-radius:15px!important}td,th{padding:10px 9px!important}h1{font-size:1.7rem}}
</style>
<style id="vlt-brand-profile-v114">
.brand-upload{display:flex;align-items:center;gap:18px;padding:16px;margin:0 0 20px;border:1px dashed #cbd5e8;background:#f8faff;border-radius:16px}.brand-preview{width:112px;height:84px;flex:0 0 112px;border-radius:14px;background:linear-gradient(145deg,#14233e,#080f1d);display:flex;align-items:center;justify-content:center;overflow:hidden;color:#fff;font-weight:900;font-size:25px;letter-spacing:.08em;border:1px solid #d8e0ee}.brand-preview img{width:100%;height:100%;object-fit:contain;background:#fff}.brand-upload-copy{min-width:0}.brand-upload-copy p{margin:5px 0 10px}
.employee-photo-row{display:flex;align-items:center;gap:14px;margin-bottom:16px;padding:14px;background:#f8faff;border-radius:14px;border:1px solid #e5ebf5}.employee-avatar{width:68px;height:68px;flex:0 0 68px;border-radius:50%;background:#e7edfa;border:2px solid #d5def2;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#3157d5;font-size:25px}.employee-avatar img{width:100%;height:100%;object-fit:cover}.employee-photo-field{flex:1;margin:0}.employee-photo-field small{display:block;margin-top:5px}.employee-list-avatar{width:42px;height:42px;flex:0 0 42px;border-radius:50%;object-fit:cover;background:#e8edf7;border:1px solid #dbe3f1}.employee-list-placeholder{width:42px;height:42px;flex:0 0 42px;border-radius:50%;background:#e8edf7;display:flex;align-items:center;justify-content:center}
@media(max-width:560px){.brand-upload{align-items:flex-start;flex-direction:column}.brand-preview{width:100%;height:90px;flex-basis:auto}.employee-photo-row{align-items:flex-start;flex-direction:column}}
</style>

<style id="vlt-v122-brand-mobile">
:root{--bg:#f3f5f8;--panel:#fff;--ink:#172033;--muted:#6d7788;--line:#e0e5ed;--accent:#d9ad55;--accent-dark:#a77928;--nav:#101827;--shadow:0 10px 28px rgba(16,24,39,.07)}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:linear-gradient(145deg,#f5f7fa,#edf1f6)!important}
.km-v190-banner{background:linear-gradient(115deg,#0d1524,#1a2b42)!important;color:#fff!important;border-bottom:2px solid #caa45a!important;padding:14px 22px!important;display:flex;align-items:center;justify-content:space-between;gap:14px}
.km-v190-banner h1,.km-v190-banner p{color:#fff!important;margin:0!important}
.km-v190-banner h1{font-size:clamp(18px,2.5vw,25px)!important;letter-spacing:.01em!important}
.km-v190-banner p{color:#d7dfeb!important;font-size:12px!important;margin-top:4px!important}
.km-v190-tag{background:#caa45a!important;color:#111827!important;font-weight:800!important;border-radius:999px!important;padding:6px 10px!important;white-space:nowrap}
.sidebar{background:linear-gradient(180deg,#0d1524 0%,#18283d 100%)!important;border-right:1px solid #26364b}
.brand-logo-wrap{margin:0 0 12px;padding:8px;background:#0b1220;border:1px solid #344257;border-radius:14px;overflow:hidden}
.brand-logo{display:block;width:100%;height:auto;max-height:142px;object-fit:contain;border-radius:8px}
.subbrand{display:block!important;margin:0 5px 20px!important;color:#d0d8e4!important;line-height:1.45}
.nav button{min-height:42px;border-radius:10px!important}
.nav button.active,.nav button:hover{background:#28374a!important;color:#fff!important;box-shadow:inset 3px 0 #d9ad55!important}
.btn.primary{background:linear-gradient(135deg,#e8c77f,#c69a45)!important;border-color:#c69a45!important;color:#172033!important}
main{min-width:0}
.panel,.card{box-shadow:0 8px 24px rgba(16,24,39,.055)!important}
.table-wrap{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.table-wrap table{min-width:580px}
button,select,input,textarea{touch-action:manipulation}
@media(max-width:900px){
 .app{display:flex!important;flex-direction:column!important;min-height:100vh}
 .sidebar{position:sticky;top:0;z-index:50;padding:8px 10px!important;box-shadow:0 5px 20px #0b12201a;}
 .brand-logo-wrap{display:none}
 .subbrand{font-size:11px!important;margin:0!important;padding:2px 4px 5px!important}
 .nav{display:flex!important;gap:6px!important;overflow-x:auto!important;overflow-y:hidden!important;white-space:nowrap;scrollbar-width:thin;padding:2px 0 6px!important;margin:0!important;overscroll-behavior-x:contain}
 .nav button{flex:0 0 auto!important;padding:10px 12px!important;min-height:42px;font-size:13px!important}
 main{padding:14px!important;max-width:none!important}
 .top{gap:12px!important;margin-bottom:16px!important}
 .top>div:last-child{width:100%;align-items:stretch!important}
 .top>div:last-child select{max-width:100%;min-width:0!important}
 .layout{grid-template-columns:minmax(0,1fr)!important}
}
@media(max-width:600px){
 .km-v190-banner{padding:10px 13px!important;align-items:flex-start!important}
 .km-v190-banner h1{font-size:17px!important}
 .km-v190-banner p{font-size:11px!important;max-width:260px}
 .km-v190-tag{font-size:10px!important;padding:5px 7px!important}
 main{padding:10px!important}
 .top{align-items:stretch!important;flex-direction:column!important}
 .top h1{font-size:24px!important;line-height:1.15}
 .eyebrow{font-size:10px!important;letter-spacing:.07em}
 .top>div:last-child{display:grid!important;grid-template-columns:1fr!important;gap:7px!important}
 .top>div:last-child label{margin-top:4px}
 .top>div:last-child select,.top>div:last-child button{width:100%!important;min-height:44px}
 .demo{width:max-content}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
 .card,.panel{padding:12px!important;border-radius:13px!important}
 .stat-value{font-size:21px!important}
 .panel-head{align-items:flex-start;flex-wrap:wrap}
 .panel-head .btn{min-height:40px}
 .form-grid,.recipe-grid{grid-template-columns:minmax(0,1fr)!important}
 .form-actions .btn,.event-actions .btn{min-height:42px}
 input,select,textarea{font-size:16px!important;min-height:44px!important}
 .ingredient-row{grid-template-columns:minmax(0,1fr) minmax(0,.8fr)!important;gap:8px!important}
 .ingredient-row input,.ingredient-row select{min-width:0}
 .brand-upload{gap:10px!important}
 .employee-photo-row{gap:10px!important}
 #notification-panel{left:8px!important;right:8px!important;width:auto!important;max-width:none!important}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
@media print{.km-v190-banner,.sidebar{display:none!important}main{padding:0!important}}
</style>


<style id="vlt-v124-logo-integration">
/* V1.24 — identité visuelle intégrée, fond transparent et responsive */
.brand-logo-wrap{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;margin:0 0 10px!important;padding:0!important;background:transparent!important;border:0!important;border-radius:0!important;overflow:visible!important}
.brand-logo{display:block!important;width:100%!important;max-width:178px!important;height:auto!important;max-height:118px!important;object-fit:contain!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:transparent!important}
.subbrand{display:block!important;text-align:center!important;margin:0 4px 20px!important;padding:0 4px!important;color:#d0d8e4!important;font-size:11px!important;line-height:1.45!important}
.km-v190-banner{border-bottom:1px solid #dce3ec!important}
@media(max-width:760px){
 .app{grid-template-columns:1fr!important}
 .sidebar{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:2px!important;padding:8px 10px 6px!important;min-height:0!important;position:relative!important}
 .brand-logo-wrap{display:flex!important;justify-content:flex-start!important;align-self:center!important;width:auto!important;margin:0!important;padding:0!important}
 .brand-logo{width:104px!important;max-width:104px!important;max-height:60px!important}
 .subbrand{display:none!important}
 .nav{margin-top:7px!important;display:flex!important;overflow-x:auto!important;gap:5px!important}
 .nav button{white-space:nowrap!important;flex:0 0 auto!important;padding:10px 12px!important}
 .km-v190-banner{padding:10px 14px!important;gap:8px!important}
 .km-v190-banner h1{font-size:20px!important;margin:0!important}
 .km-v190-banner p{font-size:12px!important;margin:3px 0 0!important}
 .km-v190-tag{font-size:11px!important;padding:7px 9px!important}
}
@media(min-width:761px){.brand-logo-wrap{margin-top:0!important}.brand-logo{max-width:178px!important;max-height:118px!important}}
@media print{.brand-logo-wrap{display:none!important}}
</style>

<style id="vlt-v126-mobile-redesign">
/* Mobile: navigation compacte et contenu sans débordement */
@media(max-width:760px){
 html,body{width:100%;max-width:100%;overflow-x:hidden}
 .app{display:flex!important;flex-direction:column!important;width:100%;min-width:0!important}
 .sidebar{position:relative!important;top:auto!important;width:100%!important;max-width:100%!important;box-sizing:border-box!important;padding:8px 10px 7px!important;gap:5px!important;border-right:0!important;border-bottom:1px solid #293b53!important}
 .brand-logo-wrap{display:flex!important;align-self:flex-start!important;justify-content:flex-start!important;width:100%!important;height:38px!important;margin:0!important;padding:0!important}
 .brand-logo{width:auto!important;max-width:145px!important;height:38px!important;max-height:38px!important;object-fit:contain!important;object-position:left center!important}
 .subbrand{display:none!important}
 .nav{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;width:100%!important;max-width:100%!important;gap:5px!important;margin:2px 0 0!important;padding:0 0 5px!important;overflow-x:auto!important;overflow-y:hidden!important;scrollbar-width:thin;-webkit-overflow-scrolling:touch}
 .nav button{flex:0 0 auto!important;min-height:39px!important;padding:9px 11px!important;font-size:12px!important;white-space:nowrap!important;border-radius:9px!important}
 main{width:100%!important;max-width:100%!important;min-width:0!important;box-sizing:border-box!important;padding:12px!important;margin:0!important}
 .top{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:10px!important;margin-bottom:14px!important}
 .top h1{font-size:clamp(22px,6vw,28px)!important;line-height:1.12!important;overflow-wrap:anywhere}
 .top>div:last-child{display:grid!important;grid-template-columns:minmax(0,1fr)!important;width:100%!important;gap:7px!important;min-width:0!important}
 .top>div:last-child>*{min-width:0!important;max-width:100%!important}
 .stats{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
 .card,.panel{min-width:0!important;padding:12px!important;border-radius:13px!important}
 .layout,.form-grid,.recipe-grid{grid-template-columns:minmax(0,1fr)!important;min-width:0!important}
 .panel-head{align-items:flex-start!important;flex-wrap:wrap!important}
 .panel-head h2{font-size:16px!important;line-height:1.3!important}
 .table-wrap{width:100%!important;max-width:100%!important;overflow-x:auto!important}
 .table-wrap table{min-width:560px!important}
 input,select,textarea{max-width:100%!important;box-sizing:border-box!important;font-size:16px!important;min-height:44px!important}
 button,.btn{max-width:100%;overflow-wrap:anywhere}
 .notice{overflow-wrap:anywhere}
}
@media(max-width:390px){
 main{padding:9px!important}
 .stats{gap:7px!important}
 .card,.panel{padding:10px!important}
 .stat-label{font-size:11px!important}
 .stat-value{font-size:20px!important}
 .nav button{padding:8px 10px!important;font-size:11px!important}
}
</style>

<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="assets/vlt-icon.svg" type="image/svg+xml">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VLT Food">
</head>
<body>

<div class="app" style="margin-top:0">
<aside class="sidebar">
  <div class="brand-logo-wrap"><img class="brand-logo" src="data:image/png;base64," alt="Logo VLT Food Management"></div>
  <div class="subbrand">La gestion de vos métiers de bouche</div>
  <nav class="nav" aria-label="Navigation">
    <button class="active" data-page="dashboard">◫ &nbsp; Tableau de bord</button>
    <button data-page="stocks">▤ &nbsp; Stocks</button>
    <button data-page="recipes">♨ &nbsp; Recettes & coûts</button>
    <button data-page="prep">☑ &nbsp; Préparations</button>
    <button data-page="events">📅 &nbsp; Événements & commandes</button>
    <button data-page="quotes">🧾 &nbsp; Devis & factures client</button>
    <button data-page="calendar">🗓️ &nbsp; Calendrier</button>
    <button data-page="temperatures">♧ &nbsp; Températures</button>
    <button data-page="food-safety">🥩 &nbsp; Traçabilité & DLC</button>
    <button data-page="cleaning">🧽 &nbsp; Nettoyage & entretien</button>
    <button data-page="consumables">📦 &nbsp; Stock non consommable</button>
    <button data-page="losses" data-patron-only="true">↘ &nbsp; Pertes & historique</button>
    <button data-page="photo">▧ &nbsp; Photo produit</button>
    <button data-page="invoices">🧾 &nbsp; Factures & livraisons</button>
    <button data-page="accounts" data-admin-only="true">♙ &nbsp; Comptes & rôles</button>
    <button data-page="establishments" data-admin-only="true">▦ &nbsp; Établissements</button>
    <button data-page="personnel">👥 &nbsp; Personnel & planning</button>
      <button data-page="messagerie">💬 &nbsp; Messagerie professionnelle</button>
</nav>
  <div class="sidebar-note">Prototype V1.8<br>Données locales de démonstration · espaces séparés par établissement.</div>
</aside>

<div id="notification-panel" role="dialog" aria-label="Notifications" aria-live="polite">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
    <strong>Notifications</strong>
    <button class="btn" type="button" id="notification-close">Fermer</button>
  </div>
  <div id="notification-list"></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
    <button class="btn" type="button" id="notification-refresh">Actualiser</button>
    <button class="btn" type="button" id="notification-clear">Marquer comme lues</button>
  </div>
  <p class="notif-muted">Ces alertes s’affichent dans l’application. Les notifications du téléphone quand le site est fermé ne sont pas encore activées.</p>
</div>

<section id="vlt-mindmap" class="vlt-mindmap" role="dialog" aria-modal="true" aria-labelledby="vlt-mindmap-title" aria-hidden="true">
  <div class="vlt-mindmap-shell">
    <header class="vlt-mindmap-header">
      <div><div class="vlt-mm-kicker">NAVIGATION VISUELLE</div><h2 id="vlt-mindmap-title">Explore ton établissement</h2><p>Choisis une branche pour afficher ses fonctions, puis ouvre la rubrique souhaitée.</p></div>
      <button type="button" class="vlt-mm-close" id="vlt-mindmap-close" aria-label="Fermer la carte mentale">✕</button>
    </header>
    <div class="vlt-mm-tools"><label class="vlt-mm-search"><span>⌕</span><input id="vlt-mindmap-search" type="search" placeholder="Rechercher une fonction…" autocomplete="off"></label><button class="btn" id="vlt-mindmap-collapse" type="button">Tout replier</button></div>
    <div class="vlt-mm-canvas" id="vlt-mindmap-canvas">
      <div class="vlt-mm-root"><span class="vlt-mm-root-icon">✦</span><div><strong>VLT FOOD MANAGEMENT</strong><small>Gestion de ton établissement</small></div></div>
      <div class="vlt-mm-branches" id="vlt-mindmap-branches">
        <section class="vlt-mm-branch" data-branch="pilotage"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">◫</span><span><strong>Pilotage</strong><small>Vue d’ensemble et alertes</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="dashboard">Tableau de bord</button></div></section>
        <section class="vlt-mm-branch" data-branch="stocks"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">▤</span><span><strong>Stocks & achats</strong><small>Produits et approvisionnement</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="stocks">Stocks alimentaires</button><button data-mm-page="consumables">Stock non consommable</button><button data-mm-page="invoices">Factures & livraisons</button></div></section>
        <section class="vlt-mm-branch" data-branch="cuisine"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">♨</span><span><strong>Cuisine</strong><small>Production et fiches</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="recipes">Recettes & coûts</button><button data-mm-page="prep">Préparations</button><button data-mm-page="photo">Photo produit</button></div></section>
        <section class="vlt-mm-branch" data-branch="hygiene"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">✓</span><span><strong>Hygiène & sécurité</strong><small>Contrôles et traçabilité</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="temperatures">Températures</button><button data-mm-page="food-safety">Traçabilité & DLC</button><button data-mm-page="cleaning">Nettoyage & entretien</button></div></section>
        <section class="vlt-mm-branch" data-branch="ventes"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">▧</span><span><strong>Ventes & événements</strong><small>Commandes, devis et dates</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="events">Événements & commandes</button><button data-mm-page="quotes">Devis & factures client</button><button data-mm-page="calendar">Calendrier</button></div></section>
        <section class="vlt-mm-branch" data-branch="equipe"><button class="vlt-mm-branch-head" aria-expanded="false"><span class="vlt-mm-icon">♙</span><span><strong>Équipe & organisation</strong><small>Personnel et espaces</small></span><span class="vlt-mm-chevron">＋</span></button><div class="vlt-mm-children"><button data-mm-page="personnel">Personnel & planning</button><button data-mm-page="messagerie">Messagerie professionnelle</button><button data-mm-page="losses" data-mm-role="patron">Pertes & historique</button><button data-mm-page="accounts" data-mm-role="admin">Comptes & rôles</button><button data-mm-page="establishments" data-mm-role="admin">Établissements</button></div></section>
      </div>
      <div class="vlt-mm-empty" id="vlt-mindmap-empty" hidden>Aucune rubrique trouvée. Essaie un autre mot.</div>
    </div>
    <footer class="vlt-mm-footer"><span>💡 Astuce : les branches peuvent rester ouvertes pendant que tu explores.</span><button type="button" class="btn primary" id="vlt-mindmap-home">Retour au tableau de bord</button></footer>
  </div>
</section>

<main>
  <header class="top">
    <div><div class="eyebrow">Espace cuisine · Démo — données locales séparées par établissement</div><h1 id="page-title">Tableau de bord</h1></div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <label for="establishment-select" class="muted">Établissement :</label><select id="establishment-select" style="width:auto;min-width:165px" aria-label="Établissement actif"></select><label for="role-select" class="muted">Rôle démo :</label>
      <select id="role-select" style="width:auto;min-width:155px"><option value="admin">Administrateur</option><option value="gestionnaire">Gestionnaire</option><option value="employe">Employé</option></select>
      <button class="btn vlt-mindmap-launch" type="button" id="vlt-mindmap-open" aria-haspopup="dialog">🧠 Carte mentale</button>
      <button class="btn" type="button" id="notification-toggle" aria-label="Ouvrir les notifications">🔔 Notifications <span id="notification-count" style="display:inline-block;min-width:20px;padding:2px 6px;border-radius:999px;background:#b93838;color:#fff;font-size:12px">0</span></button><span class="demo">V1.40 · CARTE MENTALE</span>
    </div>
  </header>

  <section class="page active" id="dashboard">
    <div class="notice"><strong>V1.8.5 :</strong> aide à la sélection et à la création des établissements. Le sélecteur de rôle reste une simulation : il ne remplace pas une vraie connexion sécurisée.</div>
    <div class="notice"><strong>Pour choisir ton restaurant :</strong> va dans <button class="btn" type="button" onclick="showPage('establishments')">Mes établissements</button> pour le créer. Le menu en haut permet ensuite de passer d’un établissement à l’autre.</div>

    <div class="panel" id="central-alert-panel">
      <div class="panel-head">
        <h2>🚦 Vue d’ensemble — priorités du jour</h2>
        <button class="btn" type="button" onclick="refreshCentralDashboard()">Actualiser</button>
      </div>
      <div class="stats" style="grid-template-columns:repeat(auto-fit,minmax(145px,1fr));margin-bottom:14px">
        <div class="card"><div class="stat-label">Alertes urgentes</div><div class="stat-value" id="central-urgent">0</div><div class="stat-foot">À traiter en priorité</div></div>
        <div class="card"><div class="stat-label">À faire aujourd’hui</div><div class="stat-value" id="central-today">0</div><div class="stat-foot">Tâches et contrôles</div></div>
        <div class="card"><div class="stat-label">Stocks à réapprovisionner</div><div class="stat-value" id="central-stock">0</div><div class="stat-foot">Consommables et denrées</div></div>
        <div class="card"><div class="stat-label">DLC proches</div><div class="stat-value" id="central-dlc">0</div><div class="stat-foot">Dans les 3 prochains jours</div></div>
      </div>
      <div id="central-alerts" class="quick-list"><div class="empty">Chargement des alertes…</div></div>
      <p class="muted" style="margin-top:12px">Les alertes sont calculées à partir des données enregistrées dans ce navigateur pour l’établissement sélectionné. Vérifie toujours les informations et les règles de ton plan sanitaire.</p>
    </div>
    <div class="role-note" id="role-description">Espace patron : accès aux coûts, recettes, pertes et réglages de gestion. Le sélecteur sert uniquement à tester les rôles dans cette démo.</div>
    <div class="stats">
      <div class="card"><div class="stat-label">Produits en stock</div><div class="stat-value" id="stat-products">—</div><div class="stat-foot">Références enregistrées</div></div>
      <div class="card"><div class="stat-label">Alertes de stock</div><div class="stat-value" id="stat-alerts">—</div><div class="stat-foot">Sous le seuil minimum</div></div>
      <div class="card"><div class="stat-label">Recettes</div><div class="stat-value" id="stat-recipes">—</div><div class="stat-foot">Fiches techniques</div></div>
      <div class="card"><div class="stat-label">Valeur du stock</div><div class="stat-value" id="stat-value">—</div><div class="stat-foot">Estimation au prix d'achat</div></div>
    </div>
    <div class="layout">
      <div class="panel">
        <div class="panel-head"><h2>Stocks à surveiller</h2><button class="btn" onclick="showPage('stocks')">Voir les stocks →</button></div>
        <div id="dashboard-stock"></div>
      </div>
      <div>
        <div class="panel">
          <div class="panel-head"><h2>Accès rapides</h2></div>
          <div class="quick-list">
            <div class="quick"><span class="dot"></span><div><strong>Ajouter un produit</strong><small>Mettre à jour les stocks</small></div><button class="btn" style="margin-left:auto" onclick="showPage('stocks')">Ouvrir</button></div>
            <div class="quick"><span class="dot"></span><div><strong>Calculer une recette</strong><small>Coût et marge estimée</small></div><button class="btn" style="margin-left:auto" onclick="showPage('recipes')">Ouvrir</button></div>
            <div class="quick"><span class="dot"></span><div><strong>Préparations du jour</strong><small>Suivre les tâches</small></div><button class="btn" style="margin-left:auto" onclick="showPage('prep')">Ouvrir</button></div>
          </div>
        </div>
        <div class="notice">Les relevés de températures sont un simple journal de suivi. Ce prototype ne garantit pas la conformité HACCP et ne remplace pas votre plan de maîtrise sanitaire.</div>
      </div>
    </div>
  </section>

  <section class="page" id="stocks">
    <div class="panel">
      <div class="panel-head"><h2>Ajouter un produit</h2><span class="muted">Prix d'achat en €</span></div>
      <form id="stock-form">
        <div class="form-grid">
          <div class="field"><label for="product-name">Nom du produit</label><input id="product-name" required placeholder="Ex. Pommes de terre"></div>
          <div class="field"><label for="product-code">Code fournisseur / référence article</label><input id="product-code" placeholder="Ex. LEG-001 ou code du catalogue"></div>
          <div class="field"><label for="product-category">Catégorie</label><select id="product-category"><option>Légumes</option><option>Viandes</option><option>Poissons</option><option>Produits laitiers</option><option>Épicerie</option><option>Surgelés</option><option>Autre</option></select></div>
          <div class="field"><label for="product-qty">Quantité en stock</label><input id="product-qty" type="number" min="0" step="0.01" required placeholder="10"></div>
          <div class="field"><label for="product-unit">Unité</label><select id="product-unit"><option>kg</option><option>g</option><option>L</option><option>cl</option><option>pièce(s)</option><option>paquet(s)</option></select></div>
          <div class="field"><label for="product-price">Prix d'achat par unité (€)</label><input id="product-price" type="number" min="0" step="0.01" required placeholder="2.50"></div>
          <div class="field"><label for="product-min">Seuil d'alerte</label><input id="product-min" type="number" min="0" step="0.01" required placeholder="3"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">+ Ajouter au stock</button><button class="btn" type="reset">Effacer</button></div>
      </form>
    </div>
    <div class="panel"><div class="panel-head"><h2>Inventaire</h2><button class="btn" onclick="exportCSV()">Exporter en CSV</button></div><div id="stock-table"></div></div>
  </section>

  <section class="page" id="recipes">
    <div class="panel">
      <div class="panel-head"><h2>Calculer le coût d'une recette</h2></div>
      <form id="recipe-form">
        <div class="form-grid">
          <div class="field"><label for="recipe-name">Nom de la recette</label><input id="recipe-name" required placeholder="Ex. Burger maroilles"></div>
          <div class="field"><label for="recipe-servings">Portions représentées par la recette</label><input id="recipe-servings" type="number" min="1" value="1" required></div>
          <div class="field"><label for="recipe-price">Prix de vente par portion (€)</label><input id="recipe-price" type="number" min="0" step="0.01" required placeholder="Ex. 8.00"></div>
        </div>
        <div class="panel-head" style="margin-top:20px"><h2>Ingrédients de la recette</h2><button class="btn" type="button" onclick="addIngredientRow()">+ Ajouter un ingrédient</button></div>
        <p class="muted">Choisis les produits déjà enregistrés dans tes stocks, puis indique la quantité utilisée pour le nombre de portions ci-dessus. Le coût se calcule automatiquement.</p>
        <div id="recipe-ingredient-rows"></div>
        <div class="card" style="margin-top:12px;background:#f8fafc">
          <div class="stat-label">Coût total des ingrédients</div>
          <div class="stat-value" id="recipe-live-total">0,00 €</div>
          <div class="stat-foot" id="recipe-live-perportion">Coût par portion : 0,00 €</div>
          <div class="stat-foot" id="recipe-live-margin" style="margin-top:5px">Différence vente - ingrédients : 0,00 € / portion</div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer la recette</button><button class="btn" type="button" onclick="resetIngredientRows()">Réinitialiser les ingrédients</button></div>
      </form>
    </div>
    <div class="panel"><div class="panel-head"><h2>Mes fiches recettes</h2><span class="muted">Estimations indicatives</span></div><div id="recipe-list"></div></div>
    <div class="notice">Les ingrédients sont choisis dans tes stocks : le coût est calculé à partir du prix d'achat et de la quantité utilisée. « Déduire du stock » retire les quantités nécessaires après confirmation. Utilise la même unité pour le stock et la recette (ex. kg avec kg). La marge affichée exclut personnel, énergie, pertes, charges et TVA.</div>
  </section>

  <section class="page" id="prep">
    <div class="panel">
      <div class="panel-head"><h2>Préparations du jour</h2><span class="muted" id="today"></span></div>
      <form id="prep-form">
        <div class="form-grid">
          <div class="field"><label for="prep-task">Tâche à préparer</label><input id="prep-task" required placeholder="Ex. Éplucher les pommes de terre"></div>
          <div class="field"><label for="prep-person">Responsable</label><input id="prep-person" placeholder="Ex. Camille"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">+ Ajouter une tâche</button></div>
      </form>
      <div id="prep-list" style="margin-top:15px"></div>
    </div>
  </section>

  <section class="page" id="events">
    <div class="notice"><strong>Prévoir les commandes :</strong> note tes événements, le nombre de personnes et les produits à prévoir. Les quantités restent à vérifier avant de commander.</div>
    <div class="panel">
      <div class="panel-head"><h2>Ajouter un événement</h2><span class="muted">Repas, anniversaire, réception, match…</span></div>
      <form id="event-form">
        <div class="form-grid">
          <div class="field"><label for="event-name">Nom de l’événement</label><input id="event-name" required placeholder="Ex. Anniversaire, repas d’entreprise"></div>
          <div class="field"><label for="event-date">Date</label><input id="event-date" type="text" inputmode="numeric" autocomplete="off" placeholder="JJ/MM/AAAA" required><small class="muted">Saisis la date au format JJ/MM/AAAA, par exemple 25/12/2026.</small></div>
          <div class="field"><label for="event-guests">Nombre de personnes</label><input id="event-guests" type="number" min="1" step="1" required placeholder="Ex. 80"></div>
          <div class="field"><label for="event-rab">Marge de sécurité (rab)</label><select id="event-rab"><option value="0">0 % — sans rab</option><option value="5">5 % — petit rab</option><option value="10" selected>10 % — conseillé</option><option value="15">15 % — rab confortable</option><option value="20">20 % — gros rab</option></select></div>
          <div class="field"><label for="event-type">Type d’événement</label><select id="event-type"><option>Repas</option><option>Anniversaire</option><option>Réception</option><option>Service spécial</option><option>Autre</option></select></div>
          <div class="field full"><label for="event-menu">Menu / plats prévus</label><textarea id="event-menu" rows="2" placeholder="Ex. Américain saucisse, grande frite, sauce…"></textarea></div>
          <div class="field full"><label for="event-order">Produits / besoins par personne</label><textarea id="event-order" rows="3" placeholder="Un produit par ligne : Pommes de terre : 0,25 kg/personne ; Saucisses : 1 pièce/personne"></textarea><small class="muted">Saisis la quantité nécessaire par personne. Le logiciel ajoute le rab choisi et déduit le stock disponible.</small></div>
          <div class="field full"><label for="event-notes">Notes / fournisseur / heure de service</label><textarea id="event-notes" rows="2" placeholder="Ex. Livraison jeudi matin, service à 19 h"></textarea></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">+ Enregistrer l’événement</button></div>
      </form>
    </div>
    <div class="panel" style="margin-top:16px">
      <div class="panel-head"><h2>Événements à venir</h2><span class="muted">Triés par date</span></div>
      <div id="events-list"></div>
    </div>
  </section>

  <section class="page" id="quotes">
    <div class="notice"><strong>Devis et factures client :</strong> crée un devis, enregistre-le, puis marque-le comme accepté. Un devis accepté crée automatiquement un événement dans le calendrier et prépare une estimation des stocks à prévoir. Prototype local : documents de gestion, à vérifier avant usage comptable officiel.</div>
    <div class="panel" id="company-details-panel">
      <div class="panel-head"><h2>Coordonnées de mon entreprise</h2><span class="muted">Elles apparaîtront sur les devis imprimés</span></div>
      <form id="company-details-form">
        <div class="brand-upload">
          <div class="brand-preview" id="company-logo-preview"><span>VLT</span></div>
          <div class="brand-upload-copy">
            <strong>Logo de l’entreprise</strong>
            <p class="muted">Il pourra apparaître sur les devis et documents imprimés.</p>
            <input id="company-logo-file" type="file" accept="image/*">
            <button class="btn" type="button" id="company-logo-remove">Retirer le logo</button>
          </div>
        </div>
        <div class="form-grid">
          <div class="field"><label for="company-name">Nom de l’entreprise / établissement</label><input id="company-name" placeholder="Ex. Café La Renaissance"></div>
          <div class="field"><label for="company-manager">Nom du responsable</label><input id="company-manager" placeholder="Nom et prénom"></div>
          <div class="field"><label for="company-address">Adresse</label><input id="company-address" placeholder="Rue et numéro"></div>
          <div class="field"><label for="company-postcode-city">Code postal et ville</label><input id="company-postcode-city" placeholder="Ex. 59100 Roubaix"></div>
          <div class="field"><label for="company-phone">Téléphone</label><input id="company-phone" type="tel" placeholder="Téléphone professionnel"></div>
          <div class="field"><label for="company-email">E-mail</label><input id="company-email" type="email" placeholder="contact@exemple.fr"></div>
          <div class="field"><label for="company-siret">SIRET</label><input id="company-siret" placeholder="Numéro SIRET"></div>
          <div class="field"><label for="company-vat">N° TVA intracommunautaire</label><input id="company-vat" placeholder="Si applicable"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer les coordonnées</button></div>
        <small class="muted">Les informations sont enregistrées dans ce navigateur pour l’établissement sélectionné.</small>
      </form>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Créer un devis</h2><span class="muted">Tu peux le reprendre ou le modifier plus tard</span></div>
      <form id="quote-form">
        <div class="form-grid">
          <div class="field"><label for="quote-client-type">Type de client</label><select id="quote-client-type"><option value="particulier">Particulier</option><option value="entreprise">Entreprise</option></select></div>
          <div class="field"><label for="quote-client">Nom du client / entreprise</label><input id="quote-client" required placeholder="Nom et prénom ou raison sociale"></div>
          <div class="field"><label for="quote-client-contact">Nom du contact (entreprise)</label><input id="quote-client-contact" placeholder="Nom du contact, si besoin"></div>
          <div class="field"><label for="quote-client-address">Adresse de facturation</label><input id="quote-client-address" placeholder="Rue et numéro"></div>
          <div class="field"><label for="quote-client-postcode-city">Code postal et ville</label><input id="quote-client-postcode-city" placeholder="Code postal et ville"></div>
          <div class="field"><label for="quote-client-email">E-mail</label><input id="quote-client-email" type="email" placeholder="client@exemple.fr"></div>
          <div class="field"><label for="quote-client-phone">Téléphone</label><input id="quote-client-phone" type="tel" placeholder="Téléphone du client"></div>
          <div class="field" id="client-siret-field"><label for="quote-client-siret">SIRET du client (entreprise)</label><input id="quote-client-siret" placeholder="SIRET, si nécessaire"></div>
          <div class="field" id="client-vat-field"><label for="quote-client-vat">N° TVA du client (si applicable)</label><input id="quote-client-vat" placeholder="N° TVA intracommunautaire"></div>
          <div class="field"><label for="quote-title">Objet du devis</label><input id="quote-title" required placeholder="Ex. Repas de 40 personnes"></div>
          <div class="field"><label for="quote-date">Date de l’événement</label><input id="quote-date" type="text" inputmode="numeric" autocomplete="off" placeholder="JJ/MM/AAAA" required><small class="muted">Saisis la date au format JJ/MM/AAAA, par exemple 25/12/2026.</small></div>
          <div class="field"><label for="quote-guests">Nombre de personnes</label><input id="quote-guests" type="number" min="1" value="1" required></div>
          <div class="field"><label for="quote-validity">Devis valable jusqu’au</label><input id="quote-validity" type="text" inputmode="numeric" autocomplete="off" placeholder="JJ/MM/AAAA"></div>
          <div class="field"><label for="quote-rab">Rab pour les stocks</label><select id="quote-rab"><option value="0">0 %</option><option value="5">5 %</option><option value="10" selected>10 %</option><option value="15">15 %</option><option value="20">20 %</option></select></div>
          <div class="field full"><label>Produits / prestations du devis</label><div id="quote-line-builder"></div><div class="form-actions"><button class="btn" type="button" id="quote-add-line">+ Ajouter une ligne</button></div><small class="muted">Choisis un produit déjà enregistré ou une prestation libre. Le prix peut être modifié pour ce devis sans changer la fiche produit.</small></div>
          <div class="field full"><label for="quote-notes">Notes / conditions</label><textarea id="quote-notes" rows="2" placeholder="Livraison, horaires, acompte, conditions…"></textarea></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer le devis</button><button class="btn" type="button" onclick="document.getElementById('quote-form').reset()">Vider le formulaire</button></div>
      </form>
    </div>
    <div class="panel" style="margin-top:16px"><div class="panel-head"><h2>Devis enregistrés</h2></div><div id="quotes-list"></div></div>
  </section>
  <section class="page" id="calendar">
    <div class="panel">
      <div class="panel-head"><h2>Calendrier des événements</h2><span class="muted">Événements issus des devis acceptés et événements ajoutés manuellement</span></div>
      <div class="form-grid"><div class="field"><label for="calendar-month">Mois à afficher</label><input id="calendar-month" type="month"></div></div>
      <div id="calendar-list" style="margin-top:14px"></div>
    </div>
  </section>

  <section class="page" id="temperatures">
    <div class="panel">
      <div class="panel-head"><h2>Journal de températures</h2><span class="muted">À compléter avec votre procédure interne</span></div>
      <div class="panel" style="margin-bottom:14px">
        <div class="panel-head"><h2>Mes appareils</h2><span class="muted">Enregistrer une fois, puis suivre les relevés</span></div>
        <form id="temp-device-form">
          <div class="form-grid">
            <div class="field"><label for="device-name">Nom de l’appareil *</label><input id="device-name" required maxlength="80" placeholder="Ex. Frigo boissons"></div>
            <div class="field"><label for="device-type">Type</label><select id="device-type"><option>Réfrigérateur</option><option>Congélateur</option><option>Chambre froide positive</option><option>Chambre froide négative</option><option>Vitrine réfrigérée</option><option>Cellule de refroidissement</option><option>Maintien au chaud</option><option>Autre</option></select></div>
            <div class="field"><label for="device-location">Emplacement (facultatif)</label><input id="device-location" maxlength="80" placeholder="Ex. Cuisine, sous le comptoir"></div>
            <div class="field"><label for="device-min">Limite basse °C (facultatif)</label><input id="device-min" type="number" step="0.1" placeholder="Ex. -25"></div>
            <div class="field"><label for="device-max">Limite haute °C (facultatif)</label><input id="device-max" type="number" step="0.1" placeholder="Ex. 4"></div>
          </div>
          <div class="form-actions"><button class="btn primary" type="submit">Enregistrer l’appareil</button></div>
        </form>
        <div id="temp-device-list" style="margin-top:12px"></div>
      </div>
      <form id="temp-form">
        <div class="form-grid">
          <div class="field"><label for="temp-equipment">Appareil enregistré</label><select id="temp-equipment" required><option value="">Choisir un appareil…</option></select></div>
          <div class="field"><label for="temp-value">Température (°C)</label><input id="temp-value" type="number" step="0.1" required placeholder="3.5"></div>
          <div class="field"><label for="temp-person">Nom / initiales</label><input id="temp-person" required placeholder="Initiales"></div>
          <div class="field"><label for="temp-note">Observation / action corrective</label><input id="temp-note" placeholder="Ex. Contrôle effectué"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer le relevé</button></div>
      </form>
    </div>
    <div class="panel"><div class="panel-head"><h2>Historique des relevés</h2><button class="btn" onclick="clearTemps()">Vider l'historique</button></div><div id="temp-table"></div></div>
    <div class="notice">Les limites enregistrées sont indicatives : configure-les selon ton plan de maîtrise sanitaire et les exigences applicables à tes denrées. Le logiciel ne remplace pas les contrôles HACCP ni les actions correctives documentées.</div>
  </section>
  <section class="page" id="photo">
    <div class="panel">
      <div class="panel-head"><h2>Ajouter un produit avec une photo</h2><span class="muted">Assistant de référencement</span></div>
      <div class="notice"><strong>V0.7 — Outils gratuits :</strong> recherche par code-barres dans Open Food Facts et tentative de lecture du code-barres sur la photo. La base gratuite ne connaît pas tous les produits professionnels. Vérifie toujours les informations avant de les enregistrer.</div>
      <div class="notice" role="note" style="border-color:#efc36a;background:#fff7df;color:#754b00"><strong>⚠️ Attention — reconnaissance à partir d’une photo</strong><br>La photo peut être mal interprétée : le nom, la marque, la référence, le format ou le code-barres peuvent être incomplets ou incorrects. Le risque augmente si la photo est floue, sombre, inclinée ou si l’étiquette est petite. Compare les informations avec l’emballage et corrige-les avant d’enregistrer le produit.</div>
      <div class="panel" style="margin-bottom:16px">
        <div class="panel-head"><h2>Reconnaître un produit</h2><span class="muted">Sans abonnement IA</span></div>
        <div class="form-grid">
          <div class="field"><label for="barcode-input">Code-barres (EAN)</label><input id="barcode-input" inputmode="numeric" autocomplete="off" placeholder="Ex. 3017620422003"></div>
          <div class="field" style="align-content:end"><button class="btn primary" type="button" id="lookup-barcode-btn">🔎 Rechercher gratuitement</button></div>
        </div>
        <div class="form-actions"><button class="btn" type="button" id="scan-photo-barcode-btn">📷 Lire le code-barres de la photo</button><button class="btn" type="button" id="read-photo-text-btn">📝 Lire le texte de la photo</button></div>
        <p id="barcode-status" class="muted" aria-live="polite">Entre un code-barres ou prends une photo nette du code. Une connexion Internet est nécessaire pour consulter la base gratuite.</p>
      </div>
      <div class="field">
        <label for="product-photo">Photo de la boîte, de l'étiquette ou du cadencier</label>
        <p class="muted">Choisis l'action souhaitée. Le bouton galerie permet de sélectionner une image déjà enregistrée sur ton téléphone.</p>
        <input id="product-photo-camera" type="file" accept="image/*" capture="environment" style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;z-index:-1" aria-label="Prendre une photo du produit">
        <input id="product-photo-gallery" type="file" accept="image/*" style="position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;z-index:-1" aria-label="Choisir une image dans la galerie">
        <div class="form-actions" style="margin-top:0">
          <button class="btn primary" type="button" id="take-photo-btn" style="padding:13px 16px;font-size:14px">📷 Prendre une photo</button>
          <button class="btn" type="button" id="choose-gallery-btn" style="padding:13px 16px;font-size:14px">🖼️ Choisir dans la galerie</button>
        </div>
        <div id="photo-file-name" class="muted" style="margin-top:8px">Aucune photo sélectionnée.</div>
        <img id="photo-preview" class="photo-preview" alt="Aperçu de la photo choisie">
      </div>
      <form id="photo-product-form" style="margin-top:16px">
        <div class="form-grid">
          <div class="field"><label for="photo-name">Nom du produit</label><input id="photo-name" required placeholder="À vérifier sur l'étiquette"></div>
          <div class="field"><label for="photo-brand">Marque / fournisseur</label><input id="photo-brand" placeholder="Ex. marque ou fournisseur"></div>
          <div class="field"><label for="photo-ref">Code fournisseur / référence article</label><input id="photo-ref" placeholder="Code demandé pour commander"></div>
          <div class="field"><label for="photo-barcode">Code-barres (EAN, facultatif)</label><input id="photo-barcode" placeholder="Code-barres du produit"></div>
          <div class="field"><label for="photo-format">Format du colis</label><input id="photo-format" placeholder="Ex. carton de 6 x 1 kg"></div>
          <div class="field"><label for="photo-qty">Quantité reçue en stock</label><input id="photo-qty" type="number" min="0" step="0.01" value="1" required></div>
          <div class="field"><label for="photo-unit">Unité de stock</label><select id="photo-unit"><option>pièce(s)</option><option>kg</option><option>g</option><option>L</option><option>cl</option><option>paquet(s)</option></select></div>
          <div class="field"><label for="photo-price">Prix d'achat par unité (€)</label><input id="photo-price" type="number" min="0" step="0.01" value="0" required></div>
          <div class="field"><label for="photo-min">Seuil d'alerte</label><input id="photo-min" type="number" min="0" step="0.01" value="1" required></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Vérifier et enregistrer le produit</button></div>
      </form>
    </div>
  </section>

  <section class="page" id="invoices">
    <div class="notice"><strong>⚠️ Attention — lecture automatique des factures et cadenciers</strong><br>La lecture d’une photo est une estimation et peut comporter des erreurs, surtout si l’image est floue, sombre, inclinée, trop petite ou si le tableau est serré. Les noms, références, quantités, unités et prix peuvent être mal lus ou oubliés. Compare chaque ligne avec le document original et corrige-la avant validation. Rien n’est ajouté au stock avant que tu appuies sur « Valider la livraison ».</div>
    <div class="panel">
      <div class="panel-head"><h2>1. Photographier ou importer une facture</h2><span class="muted">Lecture de texte dans le navigateur</span></div>
      <input id="invoice-file" type="file" accept="image/*,.pdf,application/pdf">
      <p class="muted">Pour cette première version, la lecture automatique fonctionne surtout avec les images. Pour un PDF, prends une capture d’écran ou une photo de la facture.</p>
      <div id="invoice-file-preview" class="muted" style="margin-top:8px">Aucun fichier sélectionné.</div>
      <div class="form-grid" style="margin-top:12px">
        <div class="field"><label for="invoice-supplier">Fournisseur (à vérifier)</label><input id="invoice-supplier" placeholder="Ex. grossiste alimentaire"></div>
        <div class="field"><label for="invoice-number">Numéro de facture / bon de livraison</label><input id="invoice-number" placeholder="Facultatif"></div>
      </div>
      <div class="form-actions"><button class="btn primary" type="button" id="read-invoice-btn">📝 Lire la facture et préparer la livraison</button></div>
      <p id="invoice-status" class="muted" aria-live="polite">Choisis une photo de facture pour commencer.</p>
      <details id="invoice-ocr-debug" style="margin-top:8px"><summary>Voir le texte reconnu (diagnostic)</summary><pre id="invoice-ocr-text" style="white-space:pre-wrap;overflow-wrap:anywhere;background:#f7f8fa;padding:10px;border-radius:8px;max-height:220px;overflow:auto">Le texte reconnu apparaîtra ici après la lecture.</pre></details>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>2. Vérifier les produits avant validation</h2><span class="muted">Modifie les lignes si nécessaire</span></div>
      <div class="form-grid">
        <div class="field"><label for="invoice-default-unit">Unité par défaut</label><select id="invoice-default-unit"><option value="kg">kg</option><option value="pièce(s)">pièce(s)</option><option value="L">L</option><option value="paquet(s)">paquet(s)</option><option value="g">g</option></select></div>
        <div class="field"><label for="invoice-default-price">Prix si non détecté (€ / unité)</label><input id="invoice-default-price" type="number" min="0" step="0.01" value="0"></div>
      </div>
      <div id="invoice-lines" style="margin-top:14px"><div class="empty">Aucune ligne préparée pour l’instant.</div></div>
      <div class="form-actions"><button class="btn" type="button" id="invoice-add-line-btn">+ Ajouter une ligne manuellement</button><button class="btn primary" type="button" id="invoice-validate-btn" disabled>✓ Valider la livraison et mettre à jour le stock</button></div>
      <p class="muted">Saisis le nombre de colis, puis le contenu d’un colis (ex. 10 kg) et le prix du colis. VLT Food Management calcule la quantité totale et le prix par unité de stock.</p>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Historique des livraisons</h2><span class="muted">Pour cet établissement</span></div>
      <div id="invoice-history-list"><div class="empty">Aucune livraison validée.</div></div>
    </div>
  </section>
  <section class="page" id="losses">
    <div class="panel">
      <div class="panel-head"><h2>Enregistrer une perte ou une correction</h2></div>
      <form id="loss-form">
        <div class="form-grid">
          <div class="field"><label for="loss-product">Produit</label><select id="loss-product" required></select></div>
          <div class="field"><label for="loss-qty">Quantité perdue</label><input id="loss-qty" type="number" min="0.001" step="0.001" required placeholder="Ex. 0,5"></div>
          <div class="field"><label for="loss-reason">Motif</label><select id="loss-reason"><option>Produit abîmé</option><option>Date dépassée</option><option>Erreur de préparation</option><option>Écart d'inventaire</option><option>Autre</option></select></div>
          <div class="field"><label for="loss-note">Commentaire</label><input id="loss-note" placeholder="Facultatif"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer la perte</button></div>
      </form>
    </div>
    <div class="panel"><div class="panel-head"><h2>Historique des mouvements</h2><span class="muted">Entrées, productions, pertes</span></div><div id="movement-list"></div></div>
  </section>

  <section class="page" id="establishments">
    <div class="notice"><strong>V0.6 — Base multi-établissements :</strong> les données de stock, recettes, préparations, températures et pertes sont enregistrées séparément pour chaque établissement dans ce navigateur. Ce n'est pas encore une synchronisation en ligne ni une sécurité de compte réelle.</div>
    <div class="panel">
      <div class="panel-head"><h2>Créer un établissement</h2><span class="muted">Un compte pourra en gérer plusieurs</span></div>
      <form id="establishment-form">
        <div class="form-grid">
          <div class="field"><label for="establishment-name">Nom de l'établissement</label><input id="establishment-name" required placeholder="Ex. Café La Renaissance"></div>
          <div class="field"><label for="establishment-type">Type</label><select id="establishment-type"><option>Café / bar</option><option>Restaurant</option><option>Brasserie</option><option>Friterie</option><option>Autre</option></select></div>
          <div class="field"><label for="establishment-city">Ville (facultatif)</label><input id="establishment-city" placeholder="Ex. Cambrai"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">+ Créer l'établissement</button></div>
        <p id="establishment-status" class="muted" aria-live="polite">Remplis le nom puis appuie sur « Créer l’établissement ».</p>
      </form>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Mes établissements</h2><span class="muted">Sélectionne un établissement en haut de l'écran</span></div>
      <div id="establishment-list"></div>
    </div>
  </section>
  <section class="page" id="accounts">
    <div class="notice"><strong>Prototype :</strong> cette page permet de tester l'organisation des rôles dans ce navigateur. Les comptes ne sont pas encore de vrais comptes sécurisés et aucun mot de passe n'est stocké. Avant une commercialisation, l'authentification devra être installée côté serveur.</div>
    <div class="panel">
      <div class="panel-head"><h2>Créer un compte utilisateur</h2><span class="muted">Gestion des accès</span></div>
      <p class="muted">Un compte peut être affecté à plusieurs établissements. Choisis au moins un établissement dans la liste ci-dessous.</p>
      <form id="account-form">
        <div class="form-grid">
          <div class="field"><label for="account-name">Nom et prénom</label><input id="account-name" required placeholder="Ex. Alex Martin"></div>
          <div class="field"><label for="account-email">Adresse e-mail</label><input id="account-email" type="email" required placeholder="nom@restaurant.fr"></div>
          <div class="field"><label for="account-role">Rôle</label><select id="account-role"><option value="employe">Employé</option><option value="gestionnaire">Gestionnaire</option><option value="admin">Administrateur</option></select></div>
          <div class="field"><label for="account-site">Établissement / équipe</label><input id="account-site" placeholder="Ex. Cuisine principale"></div>
          <div class="field"><label for="account-establishments">Établissements autorisés</label><select id="account-establishments" multiple size="3" style="min-height:86px"></select><small class="muted">Sur ordinateur : Ctrl/Cmd + clic pour en choisir plusieurs.</small></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">+ Ajouter le compte de démonstration</button></div>
      </form>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Comptes enregistrés</h2><span class="muted">Données locales de démonstration</span></div>
      <div id="account-list"></div>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Règles d'accès prévues</h2></div>
      <div class="table-wrap"><table><thead><tr><th>Fonction</th><th>Administrateur</th><th>Gestionnaire</th><th>Employé</th></tr></thead><tbody>
      <tr><td>Comptes et rôles</td><td>Tout gérer</td><td>Non</td><td>Non</td></tr>
      <tr><td>Stocks et livraisons</td><td>Tout gérer</td><td>Gérer</td><td>Consulter / signaler</td></tr>
      <tr><td>Recettes et coûts</td><td>Tout gérer</td><td>Gérer selon autorisation</td><td>Préparations uniquement</td></tr>
      <tr><td>Pertes et historique</td><td>Tout consulter</td><td>Gérer</td><td>Déclarer une perte</td></tr>
      <tr><td>Paramètres de l'établissement</td><td>Tout gérer</td><td>Limité</td><td>Non</td></tr>
      </tbody></table></div>
    </div>
  </section>

  <div class="footer">VLT Food Management V1.1 · Démonstration locale · Données conservées dans ce navigateur uniquement. Exportez régulièrement vos données.</div>

<section class="page" id="personnel">
  <div class="notice">Module de test V1.8 : les employés, horaires et heures sont enregistrés dans ce navigateur. Ce n’est pas encore un système de paie ni un stockage partagé entre plusieurs appareils.</div>
  <div class="layout">
    <section class="card">
      <div class="section-head"><div><h2>👤 Fiches employés</h2><p class="muted">Ajoute et modifie l’équipe de l’établissement sélectionné.</p></div></div>
      <form id="employee-form">
        <input type="hidden" id="employee-id">
        <div class="employee-photo-row">
          <div class="employee-avatar" id="employee-photo-preview"><span>👤</span></div>
          <div class="field employee-photo-field"><label for="employee-photo-file">Photo de profil (facultative)</label><input id="employee-photo-file" type="file" accept="image/*"><small class="muted">Tu peux aussi laisser l’avatar par défaut.</small></div>
        </div>
        <div class="form-grid">
          <div class="field"><label for="employee-name">Nom et prénom *</label><input id="employee-name" required maxlength="90" placeholder="Ex. Camille Dupont"></div>
          <div class="field"><label for="employee-role">Poste</label><select id="employee-role"><option>Cuisine</option><option>Salle</option><option>Plonge</option><option>Responsable</option><option>Polyvalent</option><option>Autre</option></select></div>
          <div class="field"><label for="employee-phone">Téléphone (facultatif)</label><input id="employee-phone" type="tel" maxlength="30" placeholder="06…"></div>
          <div class="field"><label for="employee-contract">Contrat (indicatif)</label><select id="employee-contract"><option>CDI</option><option>CDD</option><option>Apprentissage</option><option>Extra</option><option>Stage</option><option>Autre</option></select></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit" id="employee-save">Ajouter l’employé</button><button class="btn" type="button" id="employee-cancel" hidden>Annuler</button></div>
      </form>
      <div id="employee-list" class="quick-list" style="margin-top:18px"></div>
    </section>
    <section class="card">
      <div class="section-head"><div><h2>🗓️ Planning hebdomadaire</h2><p class="muted">Choisis une semaine, puis ajoute les services.</p></div></div>
      <div class="form-grid">
        <div class="field"><label for="schedule-week">Semaine du</label><input id="schedule-week" type="date"></div>
        <div class="field"><label for="schedule-employee">Employé</label><select id="schedule-employee"></select></div>
        <div class="field"><label for="schedule-day">Jour</label><select id="schedule-day"><option value="1">Lundi</option><option value="2">Mardi</option><option value="3">Mercredi</option><option value="4">Jeudi</option><option value="5">Vendredi</option><option value="6">Samedi</option><option value="0">Dimanche</option></select></div>
        <div class="field"><label for="schedule-shift">Service</label><select id="schedule-shift"><option>Matin</option><option>Midi</option><option>Soir</option><option>Journée</option><option>Autre</option></select></div>
        <div class="field"><label for="schedule-start">Début</label><input id="schedule-start" type="time" value="09:00"></div>
        <div class="field"><label for="schedule-end">Fin</label><input id="schedule-end" type="time" value="14:00"></div>
        <div class="field"><label for="schedule-break">Pause (minutes)</label><input id="schedule-break" type="number" min="0" max="600" value="0"></div>
        <div class="field"><label for="schedule-note">Note (facultatif)</label><input id="schedule-note" maxlength="120" placeholder="Ex. préparation événement"></div>
      </div>
      <div class="form-actions"><button class="btn primary" type="button" id="schedule-add">Ajouter au planning</button></div>
      <div class="calendar-toolbar" style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:22px">
        <div style="display:flex;gap:8px;align-items:center"><button class="btn" type="button" id="calendar-prev">‹ Précédent</button><button class="btn" type="button" id="calendar-today">Aujourd’hui</button><button class="btn" type="button" id="calendar-next">Suivant ›</button></div>
        <div style="display:flex;gap:8px;align-items:center"><strong id="calendar-label">Planning</strong><select id="calendar-view" aria-label="Affichage calendrier" style="max-width:130px"><option value="week">Semaine</option><option value="month">Mois</option></select></div>
      </div>
      <div id="staff-calendar" style="margin-top:12px"></div>
      <div class="form-actions" style="margin-top:12px;gap:8px;flex-wrap:wrap">
        <button class="btn" type="button" id="staff-print">🖨️ Imprimer le planning</button>
        <button class="btn" type="button" id="absence-toggle">＋ Ajouter une absence / congé</button>
      </div>
      <section id="absence-form-wrap" class="card" style="display:none;margin-top:12px">
        <h3>Absence ou congé</h3>
        <div class="form-grid">
          <div class="field"><label for="absence-employee">Employé</label><select id="absence-employee"></select></div>
          <div class="field"><label for="absence-type">Type</label><select id="absence-type"><option>Congé</option><option>Maladie</option><option>Absence</option><option>Repos</option><option>Autre</option></select></div>
          <div class="field"><label for="absence-start">Du</label><input id="absence-start" type="date"></div>
          <div class="field"><label for="absence-end">Au</label><input id="absence-end" type="date"></div>
          <div class="field"><label for="absence-note">Note (facultatif)</label><input id="absence-note" maxlength="120" placeholder="Note interne"></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="button" id="absence-save">Enregistrer l’absence</button><button class="btn" type="button" id="absence-cancel">Annuler</button></div>
        <div id="absence-list" style="margin-top:10px"></div>
      </section>
      <div id="schedule-list" style="margin-top:18px"></div>
    </section>
  </div>
  <section class="card" style="margin-top:16px">
    <div class="section-head"><div><h2>⏱️ Suivi des heures</h2><p class="muted">Heures prévues calculées depuis le planning sélectionné.</p></div><div id="hours-total" class="pill ok">0 h</div></div>
    <div id="hours-summary"></div>
    <p class="muted" style="font-size:12px;margin-top:12px">Calcul indicatif : durée entre début et fin, moins la pause. Les heures supplémentaires, congés et règles légales ne sont pas automatiquement validés.</p>
  </section>
</section>


<section class="page" id="food-safety">
  <div class="notice">Suivi interne des denrées et des lots. Vérifie toujours les étiquettes fournisseur, les températures et les règles de conservation applicables. Cet outil aide au suivi mais ne remplace pas ton plan de maîtrise sanitaire.</div>
  <section class="card">
    <div class="section-head"><div><h2>🥩 Enregistrer une denrée / un lot</h2><p class="muted">Chaque réception ou nouveau lot doit être enregistré séparément.</p></div></div>
    <form id="lot-form">
      <div class="form-grid">
        <div class="field"><label for="lot-product">Produit *</label><input id="lot-product" required maxlength="100" placeholder="Ex. steak haché frais"></div>
        <div class="field"><label for="lot-category">Catégorie</label><select id="lot-category"><option>Viande rouge</option><option>Volaille</option><option>Viande hachée</option><option>Charcuterie</option><option>Poisson</option><option>Produit laitier</option><option>Préparation maison</option><option>Autre denrée</option></select></div>
        <div class="field"><label for="lot-number">Numéro de lot fournisseur *</label><input id="lot-number" required maxlength="80" placeholder="Numéro sur l’emballage"></div>
        <div class="field"><label for="lot-supplier">Fournisseur</label><input id="lot-supplier" maxlength="100" placeholder="Nom du fournisseur"></div>
        <div class="field"><label for="lot-received">Date de réception *</label><input id="lot-received" type="date" required></div>
        <div class="field"><label for="lot-dlc">DLC / date limite *</label><input id="lot-dlc" type="date" required></div>
        <div class="field"><label for="lot-qty">Quantité reçue *</label><input id="lot-qty" type="number" min="0.01" step="0.01" required placeholder="Ex. 5"></div>
        <div class="field"><label for="lot-unit">Unité</label><select id="lot-unit"><option>kg</option><option>g</option><option>pièce(s)</option><option>barquette(s)</option><option>carton(s)</option><option>L</option></select></div>
        <div class="field"><label for="lot-storage">Conservation</label><select id="lot-storage"><option>Réfrigéré</option><option>Surgelé</option><option>Congelé</option><option>Sec</option><option>Autre</option></select></div>
        <div class="field"><label for="lot-opened">Date d’ouverture (si applicable)</label><input id="lot-opened" type="date"></div>
        <div class="field"><label for="lot-useby">Date limite après ouverture (si définie)</label><input id="lot-useby" type="date"></div>
        <div class="field"><label for="lot-temp">Température à réception °C (facultatif)</label><input id="lot-temp" type="number" step="0.1" placeholder="Relevé réel"></div>
      </div>
      <div class="field" style="margin-top:12px"><label for="lot-notes">Observations / étiquette / action corrective</label><textarea id="lot-notes" rows="2" maxlength="500" placeholder="État du colis, emballage, décision si non conforme…"></textarea></div>
      <div class="form-actions"><button class="btn primary" type="submit">Enregistrer le lot</button></div>
    </form>
  </section>
  <section class="card" style="margin-top:16px">
    <div class="section-head"><div><h2>📋 Registre des lots et DLC</h2><p class="muted">Utilise d’abord les lots dont la date limite arrive le plus tôt (FEFO).</p></div><button class="btn" id="lot-print" type="button">🖨️ Imprimer le registre</button></div>
    <div class="form-grid" style="margin-bottom:12px">
      <div class="field"><label for="lot-filter">Rechercher produit / lot / fournisseur</label><input id="lot-filter" placeholder="Tape pour filtrer…"></div>
      <div class="field"><label for="lot-status-filter">Afficher</label><select id="lot-status-filter"><option value="all">Tous les lots</option><option value="urgent">DLC dans les 3 jours</option><option value="expired">DLC dépassée</option><option value="ok">DLC à plus de 3 jours</option><option value="empty">Stock épuisé</option></select></div>
    </div>
    <div id="lot-summary" class="form-grid"></div>
    <div id="lot-table" style="margin-top:12px"></div>
  </section>
</section>


<section class="page" id="cleaning">
  <div class="notice">Plan de nettoyage et d’entretien : enregistre les pièces, les surfaces et le matériel, définis une fréquence et consigne chaque passage. Les fréquences proposées doivent être adaptées à ton plan sanitaire et aux consignes des fabricants.</div>
  <div class="layout">
    <section class="card">
      <h2>🏠 Pièces et zones</h2>
      <form id="zone-form">
        <div class="form-grid">
          <div class="field"><label for="zone-name">Nom de la pièce / zone *</label><input id="zone-name" required maxlength="90" placeholder="Ex. Cuisine, réserve, sanitaires"></div>
          <div class="field"><label for="zone-type">Type</label><select id="zone-type"><option>Cuisine</option><option>Salle</option><option>Réserve</option><option>Sanitaires</option><option>Bar</option><option>Plonge</option><option>Extérieur</option><option>Autre</option></select></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Ajouter la zone</button></div>
      </form>
      <div id="zone-list" style="margin-top:12px"></div>
    </section>
    <section class="card">
      <h2>🧽 Matériel et tâches à nettoyer</h2>
      <form id="clean-task-form">
        <div class="form-grid">
          <div class="field"><label for="clean-task-name">Élément à nettoyer *</label><input id="clean-task-name" required maxlength="100" placeholder="Ex. Plan de travail inox"></div>
          <div class="field"><label for="clean-task-zone">Pièce / zone *</label><select id="clean-task-zone" required></select></div>
          <div class="field"><label for="clean-task-frequency">Fréquence de rappel</label><select id="clean-task-frequency"><option value="1">Tous les jours</option><option value="2">Tous les 2 jours</option><option value="7">Chaque semaine</option><option value="14">Toutes les 2 semaines</option><option value="30">Chaque mois</option><option value="90">Tous les 3 mois</option></select></div>
          <div class="field"><label for="clean-task-method">Produit / méthode (facultatif)</label><input id="clean-task-method" maxlength="150" placeholder="Produit autorisé, consignes…"></div>
          <div class="field"><label for="clean-task-owner">Responsable (facultatif)</label><input id="clean-task-owner" maxlength="80" placeholder="Nom de l’employé"></div>
          <div class="field"><label for="clean-task-due">Prochain nettoyage *</label><input id="clean-task-due" type="date" required></div>
        </div>
        <div class="form-actions"><button class="btn primary" type="submit">Enregistrer la tâche</button></div>
      </form>
    </section>
  </div>
  <section class="card" style="margin-top:16px">
    <div class="section-head"><div><h2>📋 Plan de nettoyage et rappels</h2><p class="muted">Les tâches en retard et celles à faire aujourd’hui apparaissent en premier.</p></div><button class="btn" type="button" id="clean-print">🖨️ Imprimer le plan</button></div>
    <div id="clean-summary" class="form-grid"></div>
    <div id="clean-task-list" style="margin-top:12px"></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2>🧾 Historique des nettoyages</h2>
    <div id="clean-history"></div>
  </section>
</section>
<section class="page" id="consumables">
  <div class="notice">Stock des articles non alimentaires : couverts, serviettes, emballages, sacs, produits d’entretien et petits consommables. Les seuils sont des rappels internes et doivent être ajustés à ton activité.</div>
  <section class="card">
    <h2>📦 Ajouter un article au stock</h2>
    <form id="consumable-form">
      <div class="form-grid">
        <div class="field"><label for="cons-name">Nom de l’article *</label><input id="cons-name" required maxlength="100" placeholder="Ex. Serviettes blanches"></div>
        <div class="field"><label for="cons-category">Catégorie</label><select id="cons-category"><option>Serviettes</option><option>Couverts</option><option>Emballages à emporter</option><option>Gobelets / contenants</option><option>Sacs</option><option>Produits d’entretien</option><option>Hygiène</option><option>Autre</option></select></div>
        <div class="field"><label for="cons-unit">Unité de comptage</label><select id="cons-unit"><option>pièces</option><option>paquets</option><option>cartons</option><option>rouleaux</option><option>litres</option><option>kg</option></select></div>
        <div class="field"><label for="cons-stock">Stock actuel *</label><input id="cons-stock" type="number" min="0" step="0.01" required value="0"></div>
        <div class="field"><label for="cons-min">Seuil minimum *</label><input id="cons-min" type="number" min="0" step="0.01" required value="5"></div>
        <div class="field"><label for="cons-location">Emplacement</label><input id="cons-location" maxlength="80" placeholder="Ex. Réserve, étagère 2"></div>
        <div class="field"><label for="cons-supplier">Fournisseur (facultatif)</label><input id="cons-supplier" maxlength="100"></div>
        <div class="field"><label for="cons-price">Prix unitaire (facultatif)</label><input id="cons-price" type="number" min="0" step="0.01" placeholder="€"></div>
      </div>
      <div class="form-actions"><button class="btn primary" type="submit">Ajouter au stock</button></div>
    </form>
  </section>
  <section class="card" style="margin-top:16px">
    <div class="section-head"><div><h2>📊 Inventaire des non-consommables</h2><p class="muted">Ajoute une livraison ou enregistre une utilisation pour actualiser les quantités.</p></div><button class="btn" type="button" id="cons-print">🖨️ Imprimer l’inventaire</button></div>
    <div class="field" style="margin-bottom:12px"><label for="cons-search">Rechercher un article</label><input id="cons-search" placeholder="Nom, catégorie, emplacement…"></div>
    <div id="cons-summary" class="form-grid"></div>
    <div id="cons-list" style="margin-top:12px"></div>
  </section>
</section>

</main>
</div>
<script>
const money=n=>new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR'}).format(Number(n)||0);
const safe=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const initialStocks=[
 {id:1,name:'Pommes de terre',category:'Légumes',qty:12,unit:'kg',price:1.2,min:5},
 {id:2,name:'Steaks hachés',category:'Viandes',qty:2,unit:'kg',price:10.5,min:3},
 {id:3,name:'Maroilles',category:'Produits laitiers',qty:4,unit:'kg',price:8.9,min:1},
 {id:4,name:'Huile de friture',category:'Épicerie',qty:6,unit:'L',price:3.4,min:2}
];
function load(key,fallback){try{const v=localStorage.getItem('km_'+key);return v?JSON.parse(v):fallback}catch(e){return fallback}}
const defaultRecipes=[
{id:1,name:'Burger maroilles',servings:1,total:2.65,price:8},
{id:2,name:'Américain saucisse',servings:1,total:1.75,price:7}
];
let establishments=load('establishments',[{id:'site-main',name:'Cuisine principale',type:'Restaurant',city:'',createdAt:new Date().toISOString()}]);
let activeEstablishmentId=load('active_establishment_id',establishments[0]?.id||'site-main');
if(!establishments.length){establishments=[{id:'site-main',name:'Cuisine principale',type:'Restaurant',city:''}];activeEstablishmentId='site-main'}
if(!establishments.some(e=>e.id===activeEstablishmentId))activeEstablishmentId=establishments[0].id;
let establishmentData=load('establishment_data',{});
if(!establishmentData[activeEstablishmentId]){
  establishmentData[activeEstablishmentId]={
    stocks:load('stocks',initialStocks),recipes:load('recipes',defaultRecipes),
    preps:load('preps',[]),temps:load('temps',[]),movements:load('movements',[]),events:load('events',[]),quotes:load('quotes',[])
  };
}
let accounts=load('accounts',[{id:1,name:'Compte de démonstration',email:'demo@kitchen.local',role:'admin',site:'Cuisine principale',establishmentIds:establishments.map(e=>e.id)}]);
let currentRole='admin';
function loadActiveData(){
  const d=establishmentData[activeEstablishmentId]||{};
  stocks=d.stocks||initialStocks.map(x=>({...x}));
  recipes=d.recipes||defaultRecipes.map(x=>({...x}));
  preps=Array.isArray(d.preps)?d.preps:[];
  temps=Array.isArray(d.temps)?d.temps:[];
  movements=Array.isArray(d.movements)?d.movements:[];
  events=Array.isArray(d.events)?d.events:(load('events',[])||[]);
  quotes=Array.isArray(d.quotes)?d.quotes:(load('quotes',[])||[]);
  // Repair older or incomplete saved records so every module receives arrays.
  establishmentData[activeEstablishmentId]={...d,stocks,recipes,preps,temps,movements,events,quotes};
}
let stocks,recipes,preps,temps,movements,events,quotes;
function persistActiveData(){
  establishmentData[activeEstablishmentId]={stocks,recipes,preps,temps,movements,events,quotes};
  localStorage.setItem('km_establishment_data',JSON.stringify(establishmentData));
}
function save(){
  persistActiveData();
  localStorage.setItem('km_establishments',JSON.stringify(establishments));
  localStorage.setItem('km_active_establishment_id',JSON.stringify(activeEstablishmentId));
  localStorage.setItem('km_accounts',JSON.stringify(accounts));
  render();
}
function activeEstablishment(){return establishments.find(e=>e.id===activeEstablishmentId)||establishments[0]}
function renderEstablishments(){
  const sel=document.getElementById('establishment-select');
  if(sel){
    sel.innerHTML=establishments.map(e=>`<option value="${safe(e.id)}" ${e.id===activeEstablishmentId?'selected':''}>${safe(e.name)}</option>`).join('');
    sel.title=establishments.length<2?'Un seul établissement existe. Crée-en un autre dans « Mes établissements » pour pouvoir changer.':'Choisis l’établissement actif';
    sel.setAttribute('aria-label',establishments.length<2?'Établissement actif — crée un autre établissement pour pouvoir changer':'Choisir l’établissement actif');
  }
  const accountSites=document.getElementById('account-establishments');
  if(accountSites){
    const previous=[...accountSites.selectedOptions].map(o=>o.value);
    accountSites.innerHTML=establishments.map(e=>`<option value="${safe(e.id)}">${safe(e.name)}</option>`).join('');
    [...accountSites.options].forEach(o=>o.selected=previous.includes(o.value));
    if(!previous.length && activeEstablishmentId) accountSites.value=activeEstablishmentId;
  }
  const host=document.getElementById('establishment-list');
  if(host)host.innerHTML=establishments.map(e=>`<div class="panel" style="margin:10px 0"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><div><strong>${safe(e.name)}</strong><div class="muted">${safe(e.type||'Établissement')}${e.city?' · '+safe(e.city):''}</div><div class="muted">ID local : ${safe(e.id)}</div></div><div><span class="pill ${e.id===activeEstablishmentId?'ok':''}">${e.id===activeEstablishmentId?'Actif':'Disponible'}</span> ${e.id!==activeEstablishmentId?`<button class="btn" onclick="switchEstablishment('${safe(e.id)}')">Ouvrir</button>`:''} ${establishments.length>1?`<button class="btn" onclick="deleteEstablishment('${safe(e.id)}')">Supprimer</button>`:''}</div></div></div>`).join('');
}
function switchEstablishment(id){
  if(!establishments.some(e=>e.id===id))return;
  persistActiveData();activeEstablishmentId=id;localStorage.setItem('km_active_establishment_id',JSON.stringify(id));loadActiveData();render();renderEstablishments();
  document.getElementById('establishment-select').value=id;
  showPage('dashboard');
}
document.getElementById('establishment-select')?.addEventListener('change',e=>switchEstablishment(e.target.value));
document.getElementById('establishment-form')?.addEventListener('submit',e=>{
  e.preventDefault();
  const status=document.getElementById('establishment-status');
  const name=document.getElementById('establishment-name').value.trim();
  if(!name){if(status)status.textContent='Écris le nom de ton établissement.';return;}
  try{
    persistActiveData();
    const site={id:'site-'+Date.now(),name,type:document.getElementById('establishment-type').value,city:document.getElementById('establishment-city').value.trim(),createdAt:new Date().toISOString()};
    establishments.push(site);
    establishmentData[site.id]={stocks:[],recipes:[],preps:[],temps:[],movements:[],events:[],quotes:[]};
    activeEstablishmentId=site.id;
    loadActiveData();
    localStorage.setItem('km_establishments',JSON.stringify(establishments));
    localStorage.setItem('km_active_establishment_id',JSON.stringify(activeEstablishmentId));
    localStorage.setItem('km_establishment_data',JSON.stringify(establishmentData));
    localStorage.setItem('km_accounts',JSON.stringify(accounts));
    e.target.reset();
    render();
    renderEstablishments();
    const selector=document.getElementById('establishment-select');if(selector)selector.value=activeEstablishmentId;
    if(status)status.textContent='Établissement « '+name+' » créé et sélectionné.';
    showPage('dashboard');
  }catch(err){
    console.error(err);
    if(status)status.textContent='Impossible d’enregistrer. Vérifie que le navigateur autorise le stockage local, puis réessaie.';
    alert('VLT Food Management n’a pas pu enregistrer cet établissement. Essaie d’ouvrir le fichier dans Chrome ou Samsung Internet, puis réessaie.');
  }
});
function deleteEstablishment(id){
  const site=establishments.find(e=>e.id===id);if(!site||establishments.length<2)return;
  if(!confirm('Supprimer « '+site.name+' » et ses données locales de démonstration ? Cette action est irréversible.'))return;
  delete establishmentData[id];establishments=establishments.filter(e=>e.id!==id);
  accounts=accounts.map(a=>({...a,establishmentIds:(a.establishmentIds||establishments.map(x=>x.id)).filter(x=>x!==id)}));
  if(activeEstablishmentId===id)activeEstablishmentId=establishments[0].id;
  loadActiveData();save();renderEstablishments();
}
function setDefaultDateFields(){
  const today=new Date();
  const localToday=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
  const eventDate=document.getElementById('event-date');
  const quoteDate=document.getElementById('quote-date');
  if(eventDate&&!eventDate.value&&!document.getElementById('event-form')?.dataset.editId)eventDate.value=displayDateInput(localToday);
  if(quoteDate&&!quoteDate.value)quoteDate.value=displayDateInput(localToday);
}
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));document.getElementById('page-title').textContent=({dashboard:'Tableau de bord central',stocks:'Gestion des stocks',recipes:'Recettes & coûts',prep:'Préparations',temperatures:'Températures',losses:'Pertes & historique',photo:'Référencer un produit',invoices:'Factures & livraisons',accounts:'Comptes & rôles',establishments:'Mes établissements',events:'Événements & commandes',quotes:'Devis & factures client',calendar:'Calendrier',personnel:'Personnel & planning',messagerie:'Messagerie professionnelle'})[id]||'VLT Food Management';setDefaultDateFields();}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function stockHTML(list){if(!list.length)return '<div class="empty">Aucun produit enregistré.</div>';return `<div class="table-wrap"><table><thead><tr><th>Produit</th><th>Quantité</th><th>Prix/unité</th><th>Valeur</th><th>État</th><th></th></tr></thead><tbody>${list.map(p=>`<tr><td><strong>${safe(p.name)}</strong><br><span class="muted">${safe(p.category)}${p.code ? " · Code fournisseur : "+safe(p.code) : ""}</span></td><td>${p.qty} ${safe(p.unit)}</td><td>${money(p.price)}</td><td>${money(p.qty*p.price)}</td><td>${p.qty<=p.min?'<span class="pill low">À commander</span>':'<span class="pill ok">OK</span>'}</td><td><button class="btn" onclick="adjustStock(${p.id})">Modifier</button> <button class="btn" onclick="deleteStock(${p.id})">×</button></td></tr>`).join('')}</tbody></table></div>`}
function parseEventNeeds(text, guests, rabPercent){
  const lines=String(text||'').split(/\n|;/).map(x=>x.trim()).filter(Boolean);
  return lines.map(line=>{
    const m=line.match(/^(.+?)\s*[:=—-]\s*(\d+(?:[.,]\d+)?)\s*(kg|g|l|ml|pièces?|pcs?|unités?|boîtes?|cartons?|sacs?)?\s*(?:\/\s*(?:personne|pers|client|convive))?$/i);
    if(!m)return {raw:line,valid:false};
    const name=m[1].trim(), per=Number(m[2].replace(',','.')), unit=(m[3]||'unités').toLowerCase();
    const required=per*Number(guests||0)*(1+Number(rabPercent||0)/100);
    const stock=stocks.find(p=>p.name.toLowerCase()===name.toLowerCase());
    const available=stock?Number(stock.qty)||0:null;
    return {name,per,unit,required,available,toOrder:available===null?null:Math.max(0,required-available),valid:true};
  });
}
function normalizeDateInput(value){
  const v=String(value||'').trim();
  let m=v.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if(m)return `${m[3]}-${m[2]}-${m[1]}`;
  m=v.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(m)return v;
  return '';
}
function displayDateInput(value){
  const v=String(value||'');
  const m=v.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  return m?`${m[3]}/${m[2]}/${m[1]}`:v;
}
let quoteLineCounter=0;
function addQuoteLine(productId='', description='', qty=1, price=0, stockName=''){
  const box=document.getElementById('quote-line-builder');if(!box)return;
  const id=++quoteLineCounter;
  const options=(stocks||[]).map(p=>`<option value="${safe(p.id)}" ${String(p.id)===String(productId)?'selected':''}>${safe(p.name)}${p.code?' — '+safe(p.code):''}</option>`).join('');
  const row=document.createElement('div');row.className='quote-line-row';row.dataset.lineId=String(id);
  row.innerHTML=`<div class="field"><label>Produit / prestation</label><select class="quote-line-product"><option value="">Prestation libre…</option>${options}</select><input class="quote-line-description" placeholder="Description" value="${safe(description)}" style="margin-top:6px"></div><div class="field"><label>Quantité</label><input class="quote-line-qty" type="number" min="0" step="0.01" value="${safe(qty)}"></div><div class="field"><label>Prix unitaire HT (€)</label><input class="quote-line-price" type="number" min="0" step="0.01" value="${safe(price)}"></div><div class="field"><label>Stock lié (facultatif)</label><select class="quote-line-stock"><option value="">Aucun</option>${options}</select></div><button type="button" class="btn" aria-label="Supprimer la ligne">×</button>`;
  const prod=row.querySelector('.quote-line-product'), desc=row.querySelector('.quote-line-description'), stockSel=row.querySelector('.quote-line-stock');
  prod.addEventListener('change',()=>{const p=stocks.find(x=>String(x.id)===prod.value);if(p){desc.value=p.name;stockSel.value=String(p.id);const priceField=row.querySelector('.quote-line-price');if(!Number(priceField.value))priceField.value=Number(p.price||0).toFixed(2)}});
  row.querySelector('button').addEventListener('click',()=>row.remove());
  if(stockName){const p=stocks.find(x=>x.name.toLowerCase()===stockName.toLowerCase());if(p)stockSel.value=String(p.id)}
  box.appendChild(row);
}
function collectQuoteLines(){
  return [...document.querySelectorAll('#quote-line-builder .quote-line-row')].map(row=>{
    const prod=row.querySelector('.quote-line-product').value;
    const stockId=row.querySelector('.quote-line-stock').value;
    const p=stocks.find(x=>String(x.id)===String(stockId));
    const description=row.querySelector('.quote-line-description').value.trim()||(p?p.name:'Prestation');
    const qty=Number(row.querySelector('.quote-line-qty').value)||0;
    const unitPrice=Number(row.querySelector('.quote-line-price').value)||0;
    return {description,qty,unitPrice,stockName:p?p.name:'',stockId:p?p.id:null,total:qty*unitPrice};
  }).filter(x=>x.description);
}
function parseQuoteLines(raw){
  return String(raw||'').split(/\n/).map(line=>line.trim()).filter(Boolean).map(line=>{
    const parts=line.split(';').map(x=>x.trim());
    const qty=Number((parts[1]||'').replace(',','.'));
    const price=Number((parts[2]||'').replace(',','.'));
    return {description:parts[0]||'Prestation',qty:Number.isFinite(qty)?qty:0,unitPrice:Number.isFinite(price)?price:0,stockName:parts[3]||'',total:(Number.isFinite(qty)?qty:0)*(Number.isFinite(price)?price:0)};
  });
}
function quoteTotal(q){return (q.lines||[]).reduce((sum,l)=>sum+Number(l.total||0),0)}
function renderQuotes(){
  const el=document.getElementById('quotes-list');if(!el)return;
  if(!quotes.length){el.innerHTML='<div class="empty-state">Aucun devis enregistré pour le moment.</div>';return;}
  el.innerHTML=[...quotes].sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).map(q=>`<div class="quote-card"><div class="event-top"><div><h3>${safe(q.title)}</h3><div class="event-meta">Client : ${safe(q.client)} · Événement : ${safe(q.date)} · ${safe(q.guests)} personne(s)</div></div><span class="quote-status ${q.status==='Accepté'?'accepted':q.status==='Refusé'?'rejected':''}">${safe(q.status)}</span></div><div class="event-detail"><strong>Total HT indicatif</strong>${money(quoteTotal(q))}</div>${q.notes?`<div class="event-detail">${safe(q.notes)}</div>`:''}<div class="quote-actions"><button class="btn" onclick="printQuote('${safe(q.id)}')">Imprimer / PDF</button>${q.status==='Brouillon'||q.status==='Envoyé'?`<button class="btn primary" onclick="acceptQuote('${safe(q.id)}')">✓ Marquer accepté</button><button class="btn" onclick="rejectQuote('${safe(q.id)}')">Refuser</button>`:''}<button class="btn" onclick="deleteQuote('${safe(q.id)}')">Supprimer</button></div></div>`).join('');
}
function acceptQuote(id){
  const q=quotes.find(x=>x.id===id);if(!q||q.status==='Accepté')return;
  if(!confirm('Confirmer que le client a accepté le devis ? Cela créera un événement et une estimation de stock.'))return;
  q.status='Accepté';q.acceptedAt=new Date().toISOString();
  if(!q.eventId){
    const needs=[];
    (q.lines||[]).forEach(l=>{if(l.stockName){const stock=stocks.find(p=>p.name.toLowerCase()===l.stockName.toLowerCase());if(stock)needs.push(`${stock.name} : ${Number(l.qty)*(1+Number(q.rab||0)/100)} ${stock.unit}`);}});
    const ev={id:'event-'+Date.now(),name:q.title+' — '+q.client,date:q.date,guests:q.guests,type:'Événement client',rab:Number(q.rab||0),menu:(q.lines||[]).map(l=>l.description).join(', '),order:needs.join('\n'),notes:'Créé depuis le devis accepté '+q.number+'. '+(q.notes||''),quoteId:q.id};
    events.push(ev);q.eventId=ev.id;
  }
  save();renderQuotes();renderEvents();renderCalendar();
}
function rejectQuote(id){const q=quotes.find(x=>x.id===id);if(!q)return;q.status='Refusé';save();renderQuotes();}
function deleteQuote(id){const q=quotes.find(x=>x.id===id);if(!q||!confirm('Supprimer ce devis ?'))return;quotes=quotes.filter(x=>x.id!==id);save();renderQuotes();}
function printQuote(id){
  const q=quotes.find(x=>x.id===id);if(!q)return;
  const rows=(q.lines||[]).map(l=>`<tr><td>${safe(l.description)}</td><td>${safe(l.qty)}</td><td>${money(l.unitPrice)}</td><td>${money(l.total)}</td></tr>`).join('');
  const w=window.open('','_blank');if(!w){alert('Autorise les fenêtres pop-up pour imprimer le devis.');return;}
  w.document.write(`<!doctype html><html lang="fr"><meta charset="utf-8"><title>${safe(q.number)}</title><style>body{font:14px Arial;margin:36px;color:#222}table{width:100%;border-collapse:collapse;margin-top:20px}td,th{border-bottom:1px solid #ddd;padding:10px;text-align:left}.total{text-align:right;margin-top:20px;font-size:20px}</style><h1>DEVIS</h1><p><b>N° :</b> ${safe(q.number)}<br><b>Client :</b> ${safe(q.client)}<br><b>Objet :</b> ${safe(q.title)}<br><b>Date de l'événement :</b> ${safe(q.date)}<br><b>Valable jusqu'au :</b> ${safe(q.validity||'Non précisé')}</p><table><thead><tr><th>Description</th><th>Quantité</th><th>Prix unitaire HT</th><th>Total HT</th></tr></thead><tbody>${rows}</tbody></table><div class="total">Total HT : ${money(quoteTotal(q))}</div><p>${safe(q.notes||'')}</p><p>Document généré par VLT Food Management — vérifier les mentions légales, la TVA et les conditions avant envoi.</p><script>window.onload=()=>window.print()<\/script></html>`);
  w.document.close();
}
function renderCalendar(){
  const el=document.getElementById('calendar-list');if(!el)return;
  const month=document.getElementById('calendar-month')?.value||new Date().toISOString().slice(0,7);
  const list=(events||[]).filter(e=>String(e.date||'').startsWith(month)).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  if(!list.length){el.innerHTML='<div class="empty-state">Aucun événement pour ce mois.</div>';return;}
  el.innerHTML=list.map(e=>`<div class="calendar-item"><div class="calendar-date">${safe(e.date)}</div><div><h3>${safe(e.name)}</h3><div class="event-meta">${safe(e.guests||'—')} personne(s) · ${safe(e.type||'Événement')}</div>${e.quoteId?'<span class="quote-status accepted">Issu d’un devis accepté</span>':''}${e.order?`<div class="event-detail"><strong>Stock à prévoir</strong>${safe(e.order)}</div>`:''}</div></div>`).join('');
}
document.getElementById('quote-form')?.addEventListener('submit',e=>{
  e.preventDefault();
  try {
  const quoteDate=normalizeDateInput(document.getElementById('quote-date').value);if(!quoteDate){alert('Entre une date valide au format JJ/MM/AAAA.');return;}const validityRaw=document.getElementById('quote-validity').value.trim();const validity=validityRaw?normalizeDateInput(validityRaw):'';if(validityRaw&&!validity){alert('La date de validité doit être au format JJ/MM/AAAA.');return;}const lines=collectQuoteLines();if(!lines.length){alert('Ajoute au moins une ligne au devis.');return;}
  const q={id:'quote-'+Date.now(),number:'DEV-'+new Date().getFullYear()+'-'+String(quotes.length+1).padStart(4,'0'),client:document.getElementById('quote-client').value.trim(),clientType:document.getElementById('quote-client-type').value,clientContact:document.getElementById('quote-client-contact').value.trim(),clientAddress:document.getElementById('quote-client-address').value.trim(),clientPostcodeCity:document.getElementById('quote-client-postcode-city').value.trim(),clientEmail:document.getElementById('quote-client-email').value.trim(),clientPhone:document.getElementById('quote-client-phone').value.trim(),clientSiret:document.getElementById('quote-client-siret').value.trim(),clientVat:document.getElementById('quote-client-vat').value.trim(),title:document.getElementById('quote-title').value.trim(),date:quoteDate,guests:Number(document.getElementById('quote-guests').value),validity,rab:Number(document.getElementById('quote-rab').value||10),lines,notes:document.getElementById('quote-notes').value.trim(),status:'Brouillon',createdAt:new Date().toISOString()};
  quotes.push(q);
  try {
    // Persist only the quote-related data here. The global save() also redraws
    // every module and could throw in an unrelated screen after the quote was added.
    establishmentData[activeEstablishmentId]={stocks,recipes,preps,temps,movements,events,quotes};
    localStorage.setItem('km_establishment_data',JSON.stringify(establishmentData));
    localStorage.setItem('km_establishments',JSON.stringify(establishments));
    localStorage.setItem('km_active_establishment_id',JSON.stringify(activeEstablishmentId));
    localStorage.setItem('km_accounts',JSON.stringify(accounts));
  } catch (err) {
    quotes.pop();
    alert('Le devis n’a pas pu être enregistré dans le navigateur. Essaie de retirer le logo ou d’utiliser une image plus petite, puis réessaie.');
    return;
  }
  alert('Devis enregistré. Actualisation de l’écran…');
  } catch (err) {
    console.error('Erreur enregistrement devis:', err);
    alert('Erreur pendant l’enregistrement du devis : ' + (err && err.message ? err.message : 'erreur inconnue') + '. Vérifie les champs obligatoires puis réessaie.');
    return;
  }
  // The data is saved at this point. Refresh the form/list separately so an unrelated
  // display error cannot make a successful save look like a failure.
  try {
    e.target.reset();
    document.getElementById('quote-rab').value='10';
    document.getElementById('quote-line-builder').innerHTML='';
    addQuoteLine();
    setDefaultDateFields();
    renderQuotes();
  } catch (displayErr) {
    console.error('Devis sauvegardé, erreur d’affichage :', displayErr);
    alert('Le devis est enregistré, mais la liste n’a pas pu se rafraîchir. Recharge la page pour le voir.');
    return;
  }
  alert('Devis enregistré. Tu peux l’imprimer ou le sauvegarder en PDF.');
});
document.getElementById('calendar-month')?.addEventListener('change',renderCalendar);
document.getElementById('quote-add-line')?.addEventListener('click',()=>addQuoteLine());
addQuoteLine();
function renderEvents(){
  const el=document.getElementById('events-list');if(!el)return;
  const today=new Date().toISOString().slice(0,10);
  const sorted=[...(events||[])].sort((a,b)=>String(a.date).localeCompare(String(b.date)));
  if(!sorted.length){el.innerHTML='<div class="empty-state">Aucun événement enregistré. Ajoute ton premier événement ci-dessus.</div>';return;}
  el.innerHTML=`<div class="event-list">${sorted.map(ev=>{
    const past=ev.date<today;
    const date=ev.date?new Date(ev.date+'T12:00:00').toLocaleDateString('fr-FR',{weekday:'short',day:'numeric',month:'long',year:'numeric'}):'Date non définie';
    return `<article class="event-card ${past?'event-past':''}"><div class="event-top"><div><h3 style="margin:0">${safe(ev.name)}</h3><div class="event-meta">📅 ${safe(date)} · 👥 ${safe(ev.guests)} personne(s) · ${safe(ev.type||'Événement')}</div></div><span class="demo">${past?'Passé':'À venir'}</span></div>
    ${ev.menu?`<div class="event-detail"><strong>Menu prévu</strong>${safe(ev.menu)}</div>`:''}
    ${ev.order?`<div class="event-detail"><strong>Produits / commandes à prévoir</strong>${safe(ev.order)}</div>`:''}
    ${ev.notes?`<div class="event-detail"><strong>Notes</strong>${safe(ev.notes)}</div>`:''}
    ${ev.order?`<div class="event-detail"><strong>Stock à prévoir avec ${safe(ev.rab??10)} % de rab</strong>${parseEventNeeds(ev.order,ev.guests,ev.rab??10).map(n=>{if(!n.valid)return `• ${safe(n.raw)} — format à vérifier`;const fmt=v=>Number(v).toLocaleString('fr-FR',{maximumFractionDigits:2});return `• ${safe(n.name)} : ${fmt(n.required)} ${safe(n.unit)} à prévoir${n.available===null?' · stock non trouvé (à vérifier)':` · stock : ${fmt(n.available)} ${safe(n.unit)} · à commander : ${fmt(n.toOrder)} ${safe(n.unit)}`}`}).join('<br>')}</div>`:''}
    <div class="event-actions"><button class="btn" onclick="editEvent('${safe(ev.id)}')">Modifier</button><button class="btn" onclick="deleteEvent('${safe(ev.id)}')">Supprimer</button></div></article>`;
  }).join('')}</div>`;
}
function editEvent(id){
  const ev=events.find(x=>x.id===id);if(!ev)return;
  document.getElementById('event-name').value=ev.name||'';
  document.getElementById('event-date').value=displayDateInput(ev.date||'');
  document.getElementById('event-guests').value=ev.guests||'';
  document.getElementById('event-type').value=ev.type||'Repas';
  document.getElementById('event-rab').value=String(ev.rab??10);
  document.getElementById('event-menu').value=ev.menu||'';
  document.getElementById('event-order').value=ev.order||'';
  document.getElementById('event-notes').value=ev.notes||'';
  document.getElementById('event-form').dataset.editId=ev.id;
  document.querySelector('#event-form button[type="submit"]').textContent='Enregistrer les modifications';
  showPage('events');
  document.getElementById('event-name').focus();
}
function deleteEvent(id){
  const ev=events.find(x=>x.id===id);if(!ev)return;
  if(!confirm('Supprimer cet événement ?'))return;
  events=events.filter(x=>x.id!==id);save();
}
document.getElementById('event-form')?.addEventListener('submit',e=>{
  e.preventDefault();
  const form=e.currentTarget,editId=form.dataset.editId;
  const normalizedEventDate=normalizeDateInput(document.getElementById('event-date').value);if(!normalizedEventDate){alert('Entre une date valide au format JJ/MM/AAAA, par exemple 25/12/2026.');return;}
  const ev={id:editId||'event-'+Date.now(),name:document.getElementById('event-name').value.trim(),date:normalizedEventDate,guests:Number(document.getElementById('event-guests').value),type:document.getElementById('event-type').value,rab:Number(document.getElementById('event-rab').value||10),menu:document.getElementById('event-menu').value.trim(),order:document.getElementById('event-order').value.trim(),notes:document.getElementById('event-notes').value.trim()};
  if(editId)events=events.map(x=>x.id===editId?ev:x);else events.push(ev);
  delete form.dataset.editId;form.reset();document.getElementById('event-rab').value='10';document.querySelector('#event-form button[type="submit"]').textContent='+ Enregistrer l’événement';save();showPage('events');
});
function render(){
  renderEvents();renderQuotes();renderCalendar();renderEstablishments();renderLossProductOptions();renderMovements();renderAccounts();document.getElementById('stat-products').textContent=stocks.length;document.getElementById('stat-alerts').textContent=stocks.filter(p=>p.qty<=p.min).length;document.getElementById('stat-recipes').textContent=recipes.length;document.getElementById('stat-value').textContent=money(stocks.reduce((s,p)=>s+p.qty*p.price,0));document.getElementById('stock-table').innerHTML=stockHTML(stocks);const lowStock=stocks.filter(p=>Number(p.qty)<=Number(p.min)).sort((a,b)=>Number(a.qty)-Number(b.qty));
document.getElementById('dashboard-stock').innerHTML=lowStock.length?`<div class="low-stock-list">${lowStock.map(p=>{const out=Number(p.qty)<=0;return `<div class="low-stock-item ${out?'is-out':''}"><div><strong>${safe(p.name)}</strong><small>${out?'RUPTURE DE STOCK':`Stock bas : ${p.qty} ${safe(p.unit)} · Seuil : ${p.min} ${safe(p.unit)}`}</small></div><span class="low-stock-badge">${out?'À commander':'À surveiller'}</span></div>`}).join('')}</div>`:`<div class="empty-state">✅ Aucun stock sous son seuil pour le moment.</div>`;document.getElementById('recipe-list').innerHTML=recipes.length?`<div class="recipe-grid">${recipes.map(r=>{let cost=Number(r.total||0)/Math.max(1,Number(r.servings||1)),margin=Number(r.price||0)-cost;let details=(r.ingredients||[]).map(i=>{let p=stocks.find(s=>s.id===i.stockId);return p?`${safe(p.name)} : ${i.qty} ${safe(p.unit)}`:`Produit supprimé : ${i.qty}`}).join(' · ');return `<div class="recipe"><h3>${safe(r.name)}</h3><p>${r.servings} portion(s) · Prix de vente ${money(r.price)}/portion</p><div class="cost">${money(cost)} <small>coût ingrédients / portion</small></div><p style="margin-top:8px">Différence vente - ingrédients : <strong>${money(margin)}</strong></p>${details?`<p>${details}</p>`:''}<div class="form-actions"><button class="btn primary" onclick="produceRecipe(${r.id})">Déduire du stock</button><button class="btn" onclick="deleteRecipe(${r.id})">Supprimer</button></div></div>`}).join('')}</div>`:'<div class="empty">Ajoutez votre première recette.</div>';document.getElementById('prep-list').innerHTML=preps.length?preps.map(p=>`<label class="checkrow"><input type="checkbox" ${p.done?'checked':''} onchange="togglePrep(${p.id},this.checked)"><span style="${p.done?'text-decoration:line-through;color:#697586':''}"><strong>${safe(p.task)}</strong><br><span class="muted">${safe(p.person||'Sans responsable')}</span></span><button type="button" class="btn" style="margin-left:auto" onclick="deletePrep(${p.id})">×</button></label>`).join(''):'<div class="empty">Aucune tâche pour le moment.</div>';document.getElementById('temp-table').innerHTML=temps.length?`<div class="table-wrap"><table><thead><tr><th>Date / heure</th><th>Équipement</th><th>Temp.</th><th>Initiales</th><th>Observation</th></tr></thead><tbody>${temps.slice().reverse().map(t=>`<tr><td>${safe(t.date)}</td><td>${safe(t.equipment)}</td><td>${safe(t.value)} °C</td><td>${safe(t.person)}</td><td>${safe(t.note||'—')}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Aucun relevé enregistré.</div>'}
document.getElementById('stock-form').addEventListener('submit',e=>{e.preventDefault();const code=document.getElementById('product-code').value.trim();if(code&&stocks.some(p=>String(p.code||'').toLowerCase()===code.toLowerCase())){alert('Ce code fournisseur existe déjà dans le stock. Modifie le produit existant plutôt que de créer un doublon.');return}const product={id:Date.now(),code,name:document.getElementById('product-name').value.trim(),category:document.getElementById('product-category').value,qty:Number(document.getElementById('product-qty').value),unit:document.getElementById('product-unit').value,price:Number(document.getElementById('product-price').value),min:Number(document.getElementById('product-min').value)};stocks.push(product);addMovement('Création produit',product.name,product.qty,product.unit,code?'Code fournisseur : '+code:'');e.target.reset();save()});
function adjustStock(id){let p=stocks.find(x=>x.id===id);if(!p)return;let q=prompt('Nouvelle quantité pour '+p.name,p.qty);if(q===null)return;if(q.trim()===''||!Number.isFinite(Number(q))||Number(q)<0){alert('Entrez une quantité valide.');return}p.qty=Number(q);save()}
function deleteStock(id){if(confirm('Supprimer ce produit du stock ?')){stocks=stocks.filter(x=>x.id!==id);save()}}
let ingredientRowCounter=0;
function addIngredientRow(stockId='',qty=''){
  const host=document.getElementById('recipe-ingredient-rows');
  const id=++ingredientRowCounter;
  const row=document.createElement('div');row.className='ingredient-row';row.dataset.rowId=id;
  const options=stocks.map(p=>`<option value="${p.id}" ${String(p.id)===String(stockId)?'selected':''}>${safe(p.name)} — ${p.qty} ${safe(p.unit)} en stock</option>`).join('');
  row.innerHTML=`<div class="field"><label>Produit en stock</label><select class="ingredient-stock" required><option value="">Choisir un produit…</option>${options}</select><div class="stock-hint"></div></div><div class="field"><label>Quantité utilisée</label><input class="ingredient-qty" type="number" min="0.001" step="0.001" required value="${qty}" placeholder="Ex. 0,15"></div><div class="ingredient-cost">0,00 €</div><button class="btn" type="button" title="Supprimer cet ingrédient" aria-label="Supprimer cet ingrédient">×</button>`;
  row.querySelector('.ingredient-stock').addEventListener('change',updateRecipeEstimate);
  row.querySelector('.ingredient-qty').addEventListener('input',updateRecipeEstimate);
  row.querySelector('button').addEventListener('click',()=>{row.remove();updateRecipeEstimate()});
  host.appendChild(row);updateRecipeEstimate();
}
function resetIngredientRows(){document.getElementById('recipe-ingredient-rows').innerHTML='';addIngredientRow();updateRecipeEstimate()}
function getIngredientLines(){
  return [...document.querySelectorAll('#recipe-ingredient-rows .ingredient-row')].map(row=>({stockId:Number(row.querySelector('.ingredient-stock').value),qty:Number(row.querySelector('.ingredient-qty').value)})).filter(i=>i.stockId&&Number.isFinite(i.qty)&&i.qty>0);
}
function updateRecipeEstimate(){
  let total=0;
  document.querySelectorAll('#recipe-ingredient-rows .ingredient-row').forEach(row=>{
    const sid=Number(row.querySelector('.ingredient-stock').value),qty=Number(row.querySelector('.ingredient-qty').value)||0;
    const p=stocks.find(s=>s.id===sid);
    const cost=p?qty*Number(p.price):0;total+=cost;
    row.querySelector('.ingredient-cost').textContent=money(cost);
    row.querySelector('.stock-hint').textContent=p?`Unité : ${p.unit} · Disponible : ${p.qty} ${p.unit} · Prix : ${money(p.price)}/${p.unit}`:'Choisis un produit enregistré dans les stocks.';
  });
  const servings=Math.max(1,Number(document.getElementById('recipe-servings').value)||1);
  const price=Number(document.getElementById('recipe-price').value)||0;
  document.getElementById('recipe-live-total').textContent=money(total);
  document.getElementById('recipe-live-perportion').textContent=`Coût par portion : ${money(total/servings)}`;
  document.getElementById('recipe-live-margin').textContent=`Différence vente - ingrédients : ${money(price-total/servings)} / portion`;
}
document.getElementById('recipe-servings').addEventListener('input',updateRecipeEstimate);
document.getElementById('recipe-price').addEventListener('input',updateRecipeEstimate);
document.getElementById('recipe-form').addEventListener('submit',e=>{
  e.preventDefault();
  const lines=getIngredientLines();
  if(!lines.length){alert('Ajoute au moins un ingrédient en le choisissant dans tes stocks.');return}
  const missing=lines.find(i=>!stocks.some(s=>s.id===i.stockId));
  if(missing){alert('Un ingrédient ne correspond plus à un produit en stock.');return}
  const servings=Number(document.getElementById('recipe-servings').value);
  const total=lines.reduce((sum,i)=>{const p=stocks.find(s=>s.id===i.stockId);return sum+(p?i.qty*Number(p.price):0)},0);
  recipes.push({id:Date.now(),name:document.getElementById('recipe-name').value.trim(),servings,total,price:Number(document.getElementById('recipe-price').value),ingredients:lines});
  e.target.reset();document.getElementById('recipe-servings').value=1;document.getElementById('recipe-ingredient-rows').innerHTML='';addIngredientRow();save();
});
function produceRecipe(id){
  const r=recipes.find(x=>x.id===id);if(!r||!r.ingredients||!r.ingredients.length){alert('Cette ancienne recette ne contient pas encore de détails ingrédients. Supprime-la et recrée-la pour utiliser cette fonction.');return}
  const portions=Number(prompt(`Combien de portions de « ${r.name} » veux-tu produire ?`,String(r.servings||1)));
  if(!Number.isInteger(portions)||portions<=0){alert('Entre un nombre entier de portions supérieur à zéro.');return}
  const factor=portions/Math.max(1,Number(r.servings||1));
  const needs=r.ingredients.map(i=>({ingredient:i,product:stocks.find(s=>s.id===i.stockId),qty:Number(i.qty)*factor}));
  const missing=needs.find(n=>!n.product||n.product.qty<n.qty);
  if(missing){alert(`Stock insuffisant pour ${missing.product?missing.product.name:'un ingrédient'}. Disponible : ${missing.product?missing.product.qty+' '+missing.product.unit:'produit absent'}. Aucune quantité n'a été déduite.`);return}
  if(!confirm(`Déduire les ingrédients de ${portions} portion(s) de « ${r.name} » du stock ?`))return;
  needs.forEach(n=>{n.product.qty=Math.round((n.product.qty-n.qty)*1000)/1000;addMovement('Production',n.product.name,-n.qty,n.product.unit,`${portions} portion(s) de ${r.name}`)});
  save();alert('Stock mis à jour. Pense à vérifier les quantités après la production.');
}
function deleteRecipe(id){if(confirm('Supprimer cette recette ?')){recipes=recipes.filter(x=>x.id!==id);save()}}
document.getElementById('prep-form').addEventListener('submit',e=>{e.preventDefault();preps.push({id:Date.now(),task:document.getElementById('prep-task').value.trim(),person:document.getElementById('prep-person').value.trim(),done:false});e.target.reset();save()});
function togglePrep(id,done){let p=preps.find(x=>x.id===id);if(p){p.done=done;save()}}
function deletePrep(id){preps=preps.filter(x=>x.id!==id);save()}
document.getElementById('temp-form').addEventListener('submit',e=>{e.preventDefault();temps.push({id:Date.now(),date:new Date().toLocaleString('fr-FR'),equipment:document.getElementById('temp-equipment').value.trim(),value:document.getElementById('temp-value').value,person:document.getElementById('temp-person').value.trim(),note:document.getElementById('temp-note').value.trim()});e.target.reset();save()});
function clearTemps(){if(confirm('Effacer tout l’historique des températures ?')){temps=[];save()}}
function exportCSV(){let rows=[['Produit','Code fournisseur','Catégorie','Quantité','Unité','Prix unité EUR','Seuil'],...stocks.map(p=>[p.name,p.code||'',p.category,p.qty,p.unit,p.price,p.min])];let csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\r\n');let blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});let a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='kitchen-manager-stocks.csv';a.click();URL.revokeObjectURL(a.href)}
document.getElementById('today').textContent=new Date().toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'});

function addMovement(type,product,qty,unit,detail=''){
  movements.push({id:Date.now()+Math.random(),date:new Date().toLocaleString('fr-FR'),type,product,qty,unit,detail});
}
function renderLossProductOptions(){
  const sel=document.getElementById('loss-product');if(!sel)return;
  const old=sel.value;
  sel.innerHTML=stocks.map(p=>`<option value="${p.id}">${safe(p.name)} — ${p.qty} ${safe(p.unit)}</option>`).join('');
  if(old&&stocks.some(p=>String(p.id)===old))sel.value=old;
}
function renderMovements(){
  const host=document.getElementById('movement-list');if(!host)return;
  host.innerHTML=movements.length?movements.slice().reverse().map(m=>`<div class="history-row"><div><strong>${safe(m.type)} · ${safe(m.product)}</strong><br><span class="muted">${safe(m.date)}${m.detail?' · '+safe(m.detail):''}</span></div><strong>${m.qty>0?'+':''}${m.qty} ${safe(m.unit)}</strong></div>`).join(''):'<div class="empty">Aucun mouvement enregistré pour le moment.</div>';
}
function setRole(role){
  currentRole=role;
  const employee=role==='employe', manager=role==='gestionnaire', admin=role==='admin';
  const descriptions={
    admin:'Espace administrateur : gestion globale, comptes, rôles, stocks, recettes, coûts et paramètres.',
    gestionnaire:'Espace gestionnaire : stocks, livraisons, recettes, pertes et suivi de l’activité. La gestion des comptes est réservée à l’administrateur.',
    employe:'Espace employé : consultation des stocks, préparations, relevés et référencement des produits. Les coûts et les réglages sensibles sont limités.'
  };
  document.getElementById('role-description').textContent=descriptions[role]||descriptions.employe;
  document.querySelectorAll('[data-admin-only="true"]').forEach(b=>b.style.display=admin?'':'none');
  document.querySelectorAll('[data-patron-only="true"]').forEach(b=>b.style.display=employee?'none':'');
  document.querySelector('[data-page="recipes"]').style.display=employee?'none':'';
  document.querySelector('[data-page="losses"]').style.display=employee?'none':'';
  if((!admin && document.querySelector('.page.active')?.id==='accounts')||(employee && ['recipes','losses'].includes(document.querySelector('.page.active')?.id)))showPage('dashboard');
}
document.getElementById('role-select').addEventListener('change',e=>setRole(e.target.value));
document.getElementById('take-photo-btn').addEventListener('click',()=>document.getElementById('product-photo-camera').click());
document.getElementById('choose-gallery-btn').addEventListener('click',()=>document.getElementById('product-photo-gallery').click());
function handleChosenPhoto(e){
  const file=e.target.files&&e.target.files[0];const img=document.getElementById('photo-preview');
  if(!file)return;
  if(!file.type.startsWith('image/')){alert('Choisis un fichier image.');e.target.value='';return}
  document.getElementById('photo-file-name').textContent='Photo sélectionnée : '+file.name+' — tu peux essayer de lire le code-barres ci-dessus.';
  const reader=new FileReader();reader.onload=()=>{img.src=reader.result;img.style.display='block'};reader.readAsDataURL(file);
}
document.getElementById('product-photo-camera').addEventListener('change',handleChosenPhoto);
document.getElementById('product-photo-gallery').addEventListener('change',handleChosenPhoto);
document.getElementById('photo-product-form').addEventListener('submit',e=>{
  e.preventDefault();
  const name=document.getElementById('photo-name').value.trim();
  const ref=document.getElementById('photo-ref').value.trim();
  const existing=stocks.find(p=>p.name.toLowerCase()===name.toLowerCase()||(ref&&p.ref&&p.ref===ref));
  if(existing){
    if(!confirm(`Le produit « ${existing.name} » existe déjà. Ajouter la quantité reçue à son stock ?`))return;
    existing.qty=Number(existing.qty)+Number(document.getElementById('photo-qty').value);
    addMovement('Entrée (photo vérifiée)',existing.name,Number(document.getElementById('photo-qty').value),existing.unit,ref||'');
    save();alert('Quantité ajoutée au produit existant.');return;
  }
  const product={id:Date.now(),name,category:'Autre',qty:Number(document.getElementById('photo-qty').value),unit:document.getElementById('photo-unit').value,price:Number(document.getElementById('photo-price').value),min:Number(document.getElementById('photo-min').value),ref,brand:document.getElementById('photo-brand').value.trim(),format:document.getElementById('photo-format').value.trim()};
  stocks.push(product);addMovement('Création produit',name,product.qty,product.unit,ref||'Référencé manuellement après photo');
  e.target.reset();document.getElementById('product-photo-camera').value='';document.getElementById('product-photo-gallery').value='';document.getElementById('photo-preview').style.display='none';document.getElementById('photo-file-name').textContent='Aucune photo sélectionnée.';save();alert('Produit enregistré. Vérifie le nom et les informations extraites de l’étiquette.');
});
document.getElementById('loss-form').addEventListener('submit',e=>{
  e.preventDefault();
  const p=stocks.find(s=>s.id===Number(document.getElementById('loss-product').value));
  const qty=Number(document.getElementById('loss-qty').value);
  if(!p){alert('Choisis un produit.');return}
  if(qty<=0||qty>p.qty){alert(`Quantité invalide. Stock disponible : ${p.qty} ${p.unit}.`);return}
  if(!confirm(`Enregistrer une perte de ${qty} ${p.unit} pour ${p.name} ? Coût estimé : ${money(qty*p.price)}.`))return;
  p.qty=Math.round((p.qty-qty)*1000)/1000;
  addMovement('Perte',p.name,-qty,p.unit,document.getElementById('loss-reason').value+(document.getElementById('loss-note').value?' — '+document.getElementById('loss-note').value:''));
  e.target.reset();save();
});


function renderAccounts(){
  const host=document.getElementById('account-list');if(!host)return;
  const roleNames={admin:'Administrateur',gestionnaire:'Gestionnaire',employe:'Employé'};
  host.innerHTML=accounts.length?`<div class="table-wrap"><table><thead><tr><th>Nom / e-mail</th><th>Rôle de démonstration</th><th>Établissements autorisés</th><th>Actions</th></tr></thead><tbody>${accounts.map(a=>`
    <tr>
      <td><span class="account-avatar">${a.photo?`<img src="${a.photo}" alt="Photo de ${safe(a.name)}">`:safe(a.avatar||'👤')}</span><strong>${safe(a.name)}</strong><br><span class="muted">${safe(a.email)}</span></td>
      <td><select id="account-role-${a.id}" style="min-width:135px"><option value="admin" ${a.role==='admin'?'selected':''}>Administrateur</option><option value="gestionnaire" ${a.role==='gestionnaire'?'selected':''}>Gestionnaire</option><option value="employe" ${a.role==='employe'?'selected':''}>Employé</option></select></td>
      <td><select id="account-sites-${a.id}" multiple size="3" style="min-width:170px;min-height:76px">${establishments.map(e=>`<option value="${safe(e.id)}" ${(a.establishmentIds||establishments.filter(x=>x.name===a.site).map(x=>x.id)).includes(e.id)?'selected':''}>${safe(e.name)}</option>`).join('')}</select></td>
      <td><button class="btn primary" onclick="saveAccountSettings(${a.id})">Enregistrer</button> ${a.id===1?'<span class="muted">Compte démo</span>':`<button class="btn" onclick="deleteAccount(${a.id})">Supprimer</button>`}</td>
    </tr>`).join('')}</tbody></table></div>`:'<div class="empty">Aucun compte.</div>';
}
function saveAccountSettings(id){
  const account=accounts.find(a=>a.id===id);if(!account)return;
  const role=document.getElementById('account-role-'+id).value;
  const siteSelect=document.getElementById('account-sites-'+id);
  const ids=[...siteSelect.selectedOptions].map(o=>o.value);
  if(!ids.length){alert('Choisis au moins un établissement pour ce compte.');return}
  account.role=role;account.establishmentIds=ids;
  account.site=ids.map(x=>establishments.find(e=>e.id===x)?.name).filter(Boolean).join(', ');
  save();alert('Paramètres de démonstration enregistrés.');
}
document.getElementById('account-form').addEventListener('submit',e=>{
  e.preventDefault();
  const email=document.getElementById('account-email').value.trim().toLowerCase();
  if(accounts.some(a=>a.email.toLowerCase()===email)){alert('Cette adresse e-mail existe déjà.');return}
  const chosenSites=[...document.getElementById('account-establishments').selectedOptions].map(o=>o.value);
  const establishmentIds=chosenSites.length?chosenSites:[activeEstablishmentId];
  accounts.push({id:Date.now(),name:document.getElementById('account-name').value.trim(),email,role:document.getElementById('account-role').value,site:document.getElementById('account-site').value.trim()||establishmentIds.map(id=>establishments.find(x=>x.id===id)?.name).filter(Boolean).join(', '),establishmentIds});
  e.target.reset();renderEstablishments();save();alert('Compte de démonstration ajouté. Aucun e-mail d’invitation ni mot de passe n’est créé dans cette version.');
});
function deleteAccount(id){if(confirm('Supprimer ce compte de démonstration ?')){accounts=accounts.filter(a=>a.id!==id);save()}}

loadActiveData();

// V0.7 : recherche de produits dans Open Food Facts (service communautaire gratuit).
const barcodeInput=document.getElementById('barcode-input');
const barcodeStatus=document.getElementById('barcode-status');
function setBarcodeStatus(message){if(barcodeStatus)barcodeStatus.textContent=message}
function applyOpenFoodFactsProduct(p,barcode){
  const product=p.product||{};
  const name=product.product_name||product.product_name_en||product.generic_name||'';
  const brand=product.brands||'';
  const quantity=product.quantity||'';
  const categories=(product.categories_tags||[]).map(x=>x.split(':').pop().replace(/-/g,' ')).filter(Boolean).slice(0,3).join(', ');
  document.getElementById('photo-barcode').value=barcode;
  if(name)document.getElementById('photo-name').value=name;
  if(brand)document.getElementById('photo-brand').value=brand;
  if(quantity)document.getElementById('photo-format').value=quantity;
  setBarcodeStatus(name?'Produit trouvé. Vérifie les informations et complète le prix et la quantité reçue.':'Code trouvé, mais le nom du produit est absent de la fiche. Complète les champs manuellement.');
}
async function lookupBarcode(){
  const code=(barcodeInput.value||'').replace(/\D/g,'');
  if(!code){setBarcodeStatus('Entre d’abord le code-barres.');barcodeInput.focus();return}
  document.getElementById('photo-barcode').value=code;
  setBarcodeStatus('Recherche dans Open Food Facts…');
  try{
    const response=await fetch('https://world.openfoodfacts.org/api/v2/product/'+encodeURIComponent(code)+'.json');
    if(!response.ok)throw new Error('service indisponible');
    const data=await response.json();
    if(data.status===1&&data.product){applyOpenFoodFactsProduct(data,code)}
    else setBarcodeStatus('Produit non trouvé dans la base gratuite. Tu peux compléter la fiche manuellement.');
  }catch(err){setBarcodeStatus('Recherche impossible : vérifie ta connexion Internet puis réessaie, ou complète la fiche manuellement.')}
}
document.getElementById('lookup-barcode-btn')?.addEventListener('click',lookupBarcode);
barcodeInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();lookupBarcode()}});
document.getElementById('scan-photo-barcode-btn')?.addEventListener('click',async()=>{
  const file=document.getElementById('product-photo-camera').files[0]||document.getElementById('product-photo-gallery').files[0];
  if(!file){setBarcodeStatus('Prends une photo ou choisis une image contenant le code-barres, puis réessaie.');return}
  if(!('BarcodeDetector' in window)||!('createImageBitmap' in window)){
    setBarcodeStatus('La lecture automatique sur photo n’est pas prise en charge par ce navigateur. Entre le code-barres manuellement.');
    return;
  }
  try{
    setBarcodeStatus('Lecture du code-barres sur la photo…');
    const detector=new BarcodeDetector({formats:['ean_13','ean_8','upc_a','upc_e']});
    const bitmap=await createImageBitmap(file);
    const codes=await detector.detect(bitmap);
    bitmap.close?.();
    if(codes.length){
      barcodeInput.value=codes[0].rawValue;
      document.getElementById('photo-barcode').value=codes[0].rawValue;
      setBarcodeStatus('Code-barres lu : '+codes[0].rawValue+'. Recherche des informations…');
      await lookupBarcode();
    }else setBarcodeStatus('Aucun code-barres détecté. Essaie une photo plus nette, bien éclairée, ou entre le code manuellement.');
  }catch(err){setBarcodeStatus('Lecture non disponible pour cette image. Entre le code-barres manuellement.')}
});


// V0.7.1 : OCR gratuit dans le navigateur via Tesseract.js (chargé à la demande).
document.getElementById('read-photo-text-btn')?.addEventListener('click',async()=>{
  const file=document.getElementById('product-photo-camera').files[0]||document.getElementById('product-photo-gallery').files[0];
  if(!file){setBarcodeStatus('Prends une photo ou choisis une image de l’étiquette avant de lire le texte.');return}
  const btn=document.getElementById('read-photo-text-btn');
  btn.disabled=true;btn.textContent='Lecture en cours…';
  setBarcodeStatus('Chargement de l’outil gratuit de lecture du texte. La première utilisation peut prendre un moment…');
  try{
    if(!window.Tesseract){
      await new Promise((resolve,reject)=>{
        const script=document.createElement('script');
        script.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
        script.onload=resolve;script.onerror=()=>reject(new Error('Chargement impossible'));
        document.head.appendChild(script);
      });
    }
    setBarcodeStatus('Lecture du texte de l’étiquette…');
    const result=await window.Tesseract.recognize(file,'fra+eng');
    const text=result.data.text||'';
    if(!text.trim()){setBarcodeStatus('Aucun texte lisible détecté. Essaie une photo plus nette ou saisis le nom manuellement.');return}
    const lines=text.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);
    // Ne remplit le nom que si le champ est vide ou encore sur son texte indicatif.
    const nameField=document.getElementById('photo-name');
    const candidate=lines.find(x=>/fricand|fricadel|sauciss|steak|poulet|fromage|frites|pommes de terre|viande/i.test(x))||lines.find(x=>x.length>=4&&!/ingr[eé]dients|conserver|lot|code|allerg|temp[eé]rature/i.test(x));
    if(candidate && (!nameField.value.trim()||nameField.value.trim()==="À vérifier sur l'étiquette"))nameField.value=candidate.replace(/[^A-Za-zÀ-ÿ0-9 /'’().,-]/g,'').trim().slice(0,100);
    const barcode=(text.match(/\b\d{8,14}\b/)||[])[0];
    if(barcode){document.getElementById('barcode-input').value=barcode;document.getElementById('photo-ref').value=barcode}
    const brandField=document.getElementById('photo-brand');
    if(!brandField.value.trim()){
      const brandCandidate=lines.find(x=>/marque|fabric|distrib|charcuterie/i.test(x));
      if(brandCandidate)brandField.value=brandCandidate.slice(0,100);
    }
    setBarcodeStatus('Lecture terminée. Le texte peut contenir des erreurs : vérifie le nom, le code-barres et toutes les informations avant l’enregistrement.'+(barcode?' Code-barres repéré : '+barcode+'.':''));
  }catch(err){
    setBarcodeStatus('La lecture automatique n’a pas pu démarrer. Vérifie ta connexion Internet et réessaie, ou saisis le nom manuellement.');
  }finally{
    btn.disabled=false;btn.textContent='📝 Lire le texte de la photo';
  }
});


// V0.8 : facture -> lignes préparées -> validation manuelle -> entrée en stock.
let invoiceDraft=[];
let invoiceHistory=load('invoice_history_'+activeEstablishmentId,[]);
function saveInvoiceHistory(){localStorage.setItem('km_invoice_history_'+activeEstablishmentId,JSON.stringify(invoiceHistory))}
function renderInvoiceHistory(){
 const host=document.getElementById('invoice-history-list');if(!host)return;
 host.innerHTML=invoiceHistory.length?`<div class="table-wrap"><table><thead><tr><th>Date</th><th>Fournisseur</th><th>Facture</th><th>Lignes</th><th>Valeur estimée</th></tr></thead><tbody>${invoiceHistory.slice().reverse().map(h=>`<tr><td>${safe(h.date)}</td><td>${safe(h.supplier||'—')}</td><td>${safe(h.number||'—')}</td><td>${h.lines}</td><td>${money(h.total)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Aucune livraison validée.</div>';
}
function normalizeProductName(v){return String(v||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim()}
function findExistingProduct(name){
 const n=normalizeProductName(name);
 let found=stocks.find(p=>normalizeProductName(p.name)===n);
 if(found)return found;
 const tokens=n.split(' ').filter(t=>t.length>3);
 if(!tokens.length)return null;
 found=stocks.find(p=>{const pn=normalizeProductName(p.name);return tokens.filter(t=>pn.includes(t)).length>=Math.max(1,Math.ceil(tokens.length*0.7))});
 return found||null;
}
function normalizeSupplierCode(v){return String(v||'').toUpperCase().replace(/[^A-Z0-9]/g,'')}
function detectSupplierCode(line){
 const text=String(line||'');
 // Priorité aux références explicitement précédées d'un libellé.
 const labelled=text.match(/(?:r[eé]f(?:[eé]rence)?|code(?:\s+(?:article|produit))?|article\s*n[°o]?)\s*[:#.-]?\s*([A-Z0-9][A-Z0-9._/-]{2,19})/i);
 if(labelled && /[A-Z]/i.test(labelled[1]) && /\d/.test(labelled[1])) return labelled[1].replace(/[._/ ]+/g,'-').toUpperCase();
 // Références mixtes courantes : ABC-123, REF123, 123-ABC. Évite les prix et quantités isolés.
 const mixed=[...text.matchAll(/\b[A-Z]{1,6}[-_/ ]?\d{2,10}[A-Z0-9]*\b|\b\d{3,8}[-_/][A-Z]{1,5}\b/gi)];
 if(mixed.length) return mixed[0][0].replace(/[._/ ]+/g,'-').toUpperCase();
 // Références numériques longues seulement si un libellé de référence est visible.
 const numeric=text.match(/(?:r[eé]f(?:érence)?|code|article)\s*[:#.-]?\s*(\d{5,14})/i);
 return numeric?numeric[1]:'';
}
function invoiceCodeStatus(x){
 if(!x.code)return 'Code non détecté';
 const match=stocks.find(p=>p.code && normalizeSupplierCode(p.code)===normalizeSupplierCode(x.code));
 if(!match)return 'Code absent du stock';
 const sameName=normalizeProductName(match.name)===normalizeProductName(x.name) || findExistingProduct(x.name)?.id===match.id;
 return sameName?'Code reconnu : '+match.name:'⚠ Code reconnu, nom différent : '+match.name;
}
let invoiceRowCounter=0;
const invoiceFile=document.getElementById('invoice-file');
const invoiceStatus=document.getElementById('invoice-status');
function invoiceMsg(t){invoiceStatus.textContent=t}
function renderInvoiceLines(){
 renderInvoiceHistory();
 const host=document.getElementById('invoice-lines');
 if(!invoiceDraft.length){host.innerHTML='<div class="empty">Aucune ligne préparée pour l’instant.</div>';document.getElementById('invoice-validate-btn').disabled=true;return}
 host.innerHTML=`<div class="table-wrap"><table><thead><tr><th>Produit / ligne détectée</th><th>Code fournisseur</th><th>Vérification du code</th><th>Nb colis</th><th>Contenu par colis</th><th>Unité stock</th><th>Prix €/colis</th><th>Seuil stock</th><th>Action</th></tr></thead><tbody>${invoiceDraft.map((x,i)=>`<tr>
 <td><input aria-label="Nom du produit ${i+1}" value="${safe(x.name)}" data-invoice-field="name" data-index="${i}" required></td>
 <td><input aria-label="Code fournisseur ${i+1}" value="${safe(x.code||'')}" placeholder="Code article" data-invoice-field="code" data-index="${i}"></td>
 <td><small>${safe(invoiceCodeStatus(x))}</small></td>
 <td><input aria-label="Nombre de colis ${i+1}" type="number" min="0.001" step="0.001" value="${x.qty}" data-invoice-field="qty" data-index="${i}"></td>
 <td><input aria-label="Contenu d'un colis ${i+1}" type="number" min="0.001" step="0.001" placeholder="Ex. 10" value="${x.packSize??''}" data-invoice-field="packSize" data-index="${i}"></td>
 <td><select aria-label="Unité stock ${i+1}" data-invoice-field="unit" data-index="${i}">${['kg','g','L','cl','pièce(s)','paquet(s)'].map(u=>`<option ${u===x.unit?'selected':''}>${u}</option>`).join('')}</select></td>
 <td><input aria-label="Prix par colis ${i+1}" type="number" min="0" step="0.01" value="${x.price}" data-invoice-field="price" data-index="${i}"></td>
 <td><input aria-label="Seuil ${i+1}" type="number" min="0" step="0.01" value="${x.min}" data-invoice-field="min" data-index="${i}"></td>
 <td><button type="button" class="btn" data-invoice-remove="${i}">Retirer</button></td>
 </tr>`).join('')}</tbody></table></div>`;
 host.querySelectorAll('[data-invoice-field]').forEach(el=>el.addEventListener('change',()=>{
  const x=invoiceDraft[Number(el.dataset.index)],f=el.dataset.invoiceField;
  x[f]=f==='name'||f==='unit'||f==='code'?el.value:(el.value===''?'':Number(el.value));
 }));
 host.querySelectorAll('[data-invoice-remove]').forEach(el=>el.addEventListener('click',()=>{invoiceDraft.splice(Number(el.dataset.invoiceRemove),1);renderInvoiceLines()}));
 document.getElementById('invoice-validate-btn').disabled=false;
}
invoiceFile?.addEventListener('change',()=>{
 const f=invoiceFile.files[0];document.getElementById('invoice-file-preview').textContent=f?'Fichier sélectionné : '+f.name:'Aucun fichier sélectionné.';
});
document.getElementById('invoice-add-line-btn')?.addEventListener('click',()=>{
 invoiceDraft.push({name:'',code:'',qty:1,packSize:'',unit:document.getElementById('invoice-default-unit').value,price:Number(document.getElementById('invoice-default-price').value)||0,min:1});
 renderInvoiceLines();
});
document.getElementById('read-invoice-btn')?.addEventListener('click',async()=>{
 const file=invoiceFile.files[0];
 if(!file){invoiceMsg('Choisis une photo ou un PDF.');return}
 const btn=document.getElementById('read-invoice-btn'),debugText=document.getElementById('invoice-ocr-text');
 btn.disabled=true;btn.textContent='Lecture en cours…';
 try{
  let images=[];
  if(file.type==='application/pdf'||file.name.toLowerCase().endsWith('.pdf')){
   invoiceMsg('Ouverture du PDF…');
   if(!window.pdfjsLib)await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';s.onload=resolve;s.onerror=()=>reject(new Error('Lecteur PDF indisponible : vérifie Internet.'));document.head.appendChild(s)});
   window.pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
   const pdf=await window.pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
   for(let n=1;n<=Math.min(pdf.numPages,5);n++){
    const page=await pdf.getPage(n),viewport=page.getViewport({scale:2.5}),canvas=document.createElement('canvas');
    canvas.width=Math.ceil(viewport.width);canvas.height=Math.ceil(viewport.height);
    await page.render({canvasContext:canvas.getContext('2d'),viewport}).promise;images.push(canvas);
   }
  }else if(file.type.startsWith('image/')){
   const img=await new Promise((resolve,reject)=>{const u=URL.createObjectURL(file),i=new Image();i.onload=()=>{URL.revokeObjectURL(u);resolve(i)};i.onerror=()=>{URL.revokeObjectURL(u);reject(new Error('Impossible d’ouvrir la photo.'))};i.src=u});
   const scale=Math.min(2.5,Math.max(1,2400/Math.max(img.naturalWidth,img.naturalHeight))),c=document.createElement('canvas');
   c.width=Math.round(img.naturalWidth*scale);c.height=Math.round(img.naturalHeight*scale);c.getContext('2d').drawImage(img,0,0,c.width,c.height);images.push(c);
  }else throw new Error('Choisis un PDF, JPG, PNG ou WEBP.');
  if(!window.Tesseract)await new Promise((resolve,reject)=>{invoiceMsg('Chargement du moteur de lecture…');const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';s.onload=resolve;s.onerror=()=>reject(new Error('Moteur OCR indisponible : vérifie Internet.'));document.head.appendChild(s)});
  let raw='';
  for(let i=0;i<images.length;i++){
   invoiceMsg('Lecture page '+(i+1)+'/'+images.length+'…');
   const result=await window.Tesseract.recognize(images[i],'fra+eng',{logger:m=>{if(m.status==='recognizing text'&&m.progress)invoiceMsg('Lecture page '+(i+1)+' : '+Math.round(m.progress*100)+' %')}});
   raw+=(result.data.text||'')+'\n';
  }
  if(debugText)debugText.textContent=raw.trim()||'Aucun texte reconnu.';
  // Reprendre la logique de reconnaissance qui existait dans la partie factures.
  const lines=raw.split(/\r?\n/).map(x=>x.trim()).filter(x=>x.length>2),parsed=[];
  for(const line of lines){
   const cleaned=line.replace(/[|_]+/g,' ').replace(/\s+/g,' ').trim();
   if(/grossiste|fournisseur|factur[eé] à|adresse|rue des|rue du|avenue|boulevard|\b59\d{3}\b|lille|cambrai|siret|iban|client|facture n|bon de livraison|date|[ée]ch[ée]ance|sous.total|\btotal\b|\btva\b|montant|conditions|r[èe]glement|t[ée]l[ée]phone|cadencier test|document fictif|lecteur de fichiers pdf/i.test(cleaned))continue;
   const looksLikeProduct=/\b(LEG|FRI|SAU|LAI|HUI|VIA|FROM|PAI|BOI|EMB)[- ]?\d{0,4}\b|\b[A-Z]{1,8}[-_/ ]?\d{2,10}[A-Z0-9]*\b|\b\d{5,14}\b|pommes? de terre|fricadell|sauciss|maroilles|huile de friture|poulet|bœuf|boeuf|fromage|frites|cr[eè]me|beurre|farine|œuf|oeuf|lait|carton|bidon|surgel|salade|tomate|oignon|champignon|steak|merguez|mexicano|dynamite|nugget|tender|bacon|cheddar|mozzarella|sauce|pain|burger|baguette|mayonnaise|ketchup|andalouse|samoura[iï]|coca|eau|barquette|emballage/i.test(cleaned);
   const nums=[...cleaned.matchAll(/(\d+(?:[.,]\d{1,3})?)/g)].map(m=>Number(m[1].replace(',','.')));
   if(cleaned.length<5||!/[a-zA-ZÀ-ÿ]{3}/.test(cleaned)||(!looksLikeProduct&&nums.length<3))continue;
   let name=cleaned.replace(/\b(?:LEG|FRI|SAU|LAI|HUI|VIA|FROM|PAI|BOI|EMB)[- ]?\d{0,4}\b/i,' ').replace(/\b[A-Z]{1,8}[-_/ ]?\d{2,10}[A-Z0-9]*\b/gi,' ').replace(/\b\d{5,14}\b/g,' ').replace(/\b\d+(?:[.,]\d{1,3})?\s*(?:€|EUR|kg|g|l|cl|colis|carton|pi[eè]ce[s]?|sac|bidon)?\b/gi,' ').replace(/\s+/g,' ').trim();
   if(name.length<3)name=cleaned;
   const qtyMatch=cleaned.match(/\b(\d+(?:[.,]\d{1,3})?)\s*(?:sac|carton|bidon|pi[eè]ce|colis)/i);
   const priceMatches=[...cleaned.matchAll(/(\d+[,.]\d{2})\s*€/g)].map(m=>Number(m[1].replace(',','.')));
   const sizeMatch=cleaned.match(/\b(\d+(?:[.,]\d{1,3})?)\s*(kg|g|l|cl)\b/i);
   let detectedSize=sizeMatch?Number(sizeMatch[1].replace(',','.')):'',detectedUnit=sizeMatch?sizeMatch[2].toLowerCase():document.getElementById('invoice-default-unit').value;
   if(detectedUnit==='g'&&detectedSize!==''){detectedSize/=1000;detectedUnit='kg'}if(detectedUnit==='cl'&&detectedSize!==''){detectedSize/=100;detectedUnit='L'}
   const refMatch=detectSupplierCode(cleaned);
   if(parsed.some(p=>p.name.toLowerCase()===name.toLowerCase()&&p.code===(refMatch||'')))continue;
   parsed.push({name:name.slice(0,100),code:refMatch||'',qty:qtyMatch?Number(qtyMatch[1].replace(',','.')):'',packSize:detectedSize,unit:detectedUnit,price:priceMatches.length?priceMatches[0]:'',min:1,sourceLine:cleaned});
  }
  invoiceDraft=parsed.slice(0,40);renderInvoiceLines();
  invoiceMsg(invoiceDraft.length?'Lecture terminée : '+invoiceDraft.length+' lignes candidates. Vérifie les informations avant validation.':'Aucune ligne produit assez fiable détectée. Vérifie le texte reconnu ci-dessus ou ajoute les lignes manuellement.');
 }catch(err){if(debugText)debugText.textContent=err?.message||String(err);invoiceMsg('Lecture impossible : '+(err?.message||'erreur inconnue'))}
 finally{btn.disabled=false;btn.textContent='📝 Lire la facture et préparer la livraison'}
});
document.getElementById('invoice-validate-btn')?.addEventListener('click',()=>{
 if(!invoiceDraft.length){invoiceMsg('Aucune ligne à valider.');return}
 const invalid=invoiceDraft.some(x=>!String(x.name||'').trim()||x.qty===''||!Number.isFinite(Number(x.qty))||Number(x.qty)<=0||x.packSize===''||!Number.isFinite(Number(x.packSize))||Number(x.packSize)<=0||x.price===''||!Number.isFinite(Number(x.price))||Number(x.price)<0);
 if(invalid){alert('Vérifie le nom, le nombre de colis, le contenu par colis et le prix de chaque colis.');return}
 const supplier=document.getElementById('invoice-supplier').value.trim();
 const invoiceNo=document.getElementById('invoice-number').value.trim();
 if(!confirm('Confirmer '+invoiceDraft.length+' ligne(s) de livraison et mettre à jour le stock ? Vérifie que les quantités et unités correspondent à la facture.'))return;
 let added=0,created=0;
 for(const x of invoiceDraft){
  const name=String(x.name).trim();
  const existing=(x.code?stocks.find(p=>String(p.code||'').toLowerCase()===String(x.code).toLowerCase()):null)||findExistingProduct(name);
  if(existing && existing.unit===x.unit){
   const stockQty=Number(x.qty)*Number(x.packSize);const unitPrice=Number(x.price)/Number(x.packSize);const oldQty=Number(existing.qty)||0;existing.qty=oldQty+stockQty;
   if(Number(x.price)>0)existing.price=unitPrice;if(x.code&&!existing.code)existing.code=x.code;
   addMovement('Livraison validée',existing.name,stockQty,x.unit,[supplier,invoiceNo].filter(Boolean).join(' · ')||'Facture importée');
   added++;
  }else{
   const stockQty=Number(x.qty)*Number(x.packSize);const unitPrice=Number(x.price)/Number(x.packSize);
   stocks.push({id:Date.now()+Math.random(),name,code:x.code||'',category:'Autre',qty:stockQty,unit:x.unit,price:unitPrice,min:Number(x.min)||0,ref:'',brand:supplier,format:Number(x.packSize)+' '+x.unit+' par colis'});
   addMovement('Création via livraison',name,stockQty,x.unit,[supplier,invoiceNo].filter(Boolean).join(' · ')||'Facture importée');
   created++;
  }
 }
 const totalValue=invoiceDraft.reduce((sum,x)=>sum+(Number(x.qty)||0)*(Number(x.price)||0),0);
 invoiceHistory.push({id:Date.now(),date:new Date().toLocaleString('fr-FR'),supplier,number:invoiceNo,lines:invoiceDraft.length,total:totalValue});
 saveInvoiceHistory();
 invoiceDraft=[];renderInvoiceLines();save();
 invoiceMsg('Livraison enregistrée : '+added+' produit(s) mis à jour, '+created+' nouvelle(s) référence(s).');
 alert('Livraison validée. Pense à vérifier les produits et les prix dans le stock.');
});


// Notifications locales V1.7 : stock bas/épuisé et événements proches.
let notificationReadIds = load('notification_read_ids', []);

function getKitchenNotifications() {
  const list = [];
  (stocks || []).forEach(p => {
    const qty = Number(p.qty) || 0;
    const min = Number(p.min) || 0;
    if (qty <= 0) {
      list.push({id:'stock-zero-'+p.id, title:'Produit épuisé : '+p.name,
        detail:'Stock à zéro. Pense à réapprovisionner.', level:'urgent'});
    } else if (min > 0 && qty <= min) {
      list.push({id:'stock-low-'+p.id, title:'Stock bas : '+p.name,
        detail:'Reste '+qty+' '+(p.unit || 'unité')+' (seuil : '+min+').', level:'warning'});
    }
  });

  (events || []).forEach(e => {
    const raw = e.date || e.eventDate || e.startDate || '';
    if (!raw) return;
    let d;
    // Accepte ISO (AAAA-MM-JJ) et date française (JJ/MM/AAAA).
    const fr = String(raw).match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    d = fr ? new Date(Number(fr[3]), Number(fr[2])-1, Number(fr[1])) : new Date(raw);
    if (isNaN(d.getTime())) return;
    const now = new Date(); now.setHours(0,0,0,0); d.setHours(0,0,0,0);
    const days = Math.round((d-now)/86400000);
    if (days >= 0 && days <= 3) {
      list.push({id:'event-'+(e.id || e.name || raw),
        title:(days === 0 ? 'Aujourd’hui : ' : 'Événement à venir : ')+(e.name || e.title || 'Événement'),
        detail:'Vérifie les commandes et préparations pour cet événement.', level:'info'});
    }
  });
  return list;
}

function renderKitchenNotifications() {
  const list = getKitchenNotifications();
  const unread = list.filter(n => !notificationReadIds.includes(n.id));
  const count = document.getElementById('notification-count');
  if (count) count.textContent = String(unread.length);
  const target = document.getElementById('notification-list');
  if (!target) return;
  target.innerHTML = list.length
    ? list.map(n => '<div class="notif-item"><div class="notif-title">'+safe(n.title)+'</div><div class="notif-muted">'+safe(n.detail)+'</div><span class="notif-muted">'+(n.level === 'urgent' ? 'Priorité haute' : n.level === 'warning' ? 'À surveiller' : 'Rappel')+'</span></div>').join('')
    : '<div class="notif-empty">Aucune alerte pour le moment.</div>';
}

document.getElementById('notification-toggle')?.addEventListener('click', () => {
  renderKitchenNotifications();
  document.getElementById('notification-panel')?.classList.toggle('open');
});
document.getElementById('notification-close')?.addEventListener('click', () => document.getElementById('notification-panel')?.classList.remove('open'));
document.getElementById('notification-refresh')?.addEventListener('click', renderKitchenNotifications);
document.getElementById('notification-clear')?.addEventListener('click', () => {
  notificationReadIds = [...new Set([...notificationReadIds, ...getKitchenNotifications().map(n => n.id)])];
  try { localStorage.setItem('km_notification_read_ids', JSON.stringify(notificationReadIds)); } catch(e) {}
  renderKitchenNotifications();
});

setRole('admin');
render();
renderEstablishments();
addIngredientRow();
updateRecipeEstimate();
</script>
<script>

/* VLT Food Management V1.8 — personnel, planning et heures */
(function(){
  const $ = id => document.getElementById(id);
  const storeKey = () => 'km_v18_personnel_' + ( $('establishment-select')?.value || 'default');
  let db = {employees:[], shifts:[], absences:[]};
  const days = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
  const read = () => {
    try { const x=JSON.parse(localStorage.getItem(storeKey())||'null'); db=x&&Array.isArray(x.employees)&&Array.isArray(x.shifts)?{employees:x.employees,shifts:x.shifts,absences:Array.isArray(x.absences)?x.absences:[]}:{employees:[],shifts:[],absences:[]}; }
    catch(e){ db={employees:[],shifts:[],absences:[]}; }
  };
  const save = () => { try { localStorage.setItem(storeKey(),JSON.stringify(db)); } catch(e){ alert('Impossible d’enregistrer les données dans ce navigateur.'); } };
  const esc = v => String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const weekStart = () => {
    const el=$('schedule-week'); let d=el?.value?new Date(el.value+'T12:00:00'):new Date();
    const dow=d.getDay(); d.setDate(d.getDate()-(dow===0?6:dow-1));
    return d.toISOString().slice(0,10);
  };
  const weekDates = () => {
    const start=new Date(weekStart()+'T12:00:00');
    return Array.from({length:7},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);return d.toISOString().slice(0,10);});
  };
  const hours = sh => {
    const [h1,m1]=sh.start.split(':').map(Number),[h2,m2]=sh.end.split(':').map(Number);
    let mins=(h2*60+m2)-(h1*60+m1); if(mins<0) mins+=1440;
    mins-=Math.max(0,Math.min(600,Number(sh.pause)||0));
    return Math.max(0,mins)/60;
  };
  const fmt = n => (Math.round(n*100)/100).toLocaleString('fr-FR',{maximumFractionDigits:2})+' h';
  function renderEmployees(){
    $('employee-list').innerHTML=db.employees.length?db.employees.map(e=>`<div class="quick"><div>${e.photo?`<img class="employee-list-avatar" alt="" src="${e.photo}">`:'<div class="employee-list-placeholder">👤</div>'}</div><div style="flex:1;min-width:0"><strong>${esc(e.name)}</strong><small>${esc(e.role)} · ${esc(e.contract)}${e.phone?' · '+esc(e.phone):''}</small></div><button class="btn" type="button" data-edit-employee="${e.id}">Modifier</button><button class="btn" type="button" data-delete-employee="${e.id}">Supprimer</button></div>`).join(''):'<div class="empty">Aucun employé ajouté pour le moment.</div>';
    const sel=$('schedule-employee'), prev=sel.value;
    sel.innerHTML=db.employees.map(e=>`<option value="${e.id}">${esc(e.name)}</option>`).join('');
    if(db.employees.some(e=>e.id===prev))sel.value=prev;
    $('schedule-add').disabled=!db.employees.length;
  }
  function renderShifts(){
    const dates=weekDates(), list=db.shifts.filter(sh=>dates.includes(sh.date)).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start));
    $('schedule-list').innerHTML=list.length?`<div class="table-wrap"><table><thead><tr><th>Jour</th><th>Employé</th><th>Service</th><th>Horaires</th><th>Pause</th><th>Durée</th><th></th></tr></thead><tbody>${list.map(sh=>{const e=db.employees.find(x=>x.id===sh.employeeId);const d=new Date(sh.date+'T12:00:00');return `<tr><td>${days[d.getDay()]} ${d.toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit'})}</td><td>${esc(e?.name||'Employé supprimé')}</td><td>${esc(sh.shift)}${sh.note?'<br><small>'+esc(sh.note)+'</small>':''}</td><td>${esc(sh.start)}–${esc(sh.end)}</td><td>${Number(sh.pause)||0} min</td><td><strong>${fmt(hours(sh))}</strong></td><td><button class="btn" type="button" data-delete-shift="${sh.id}">Retirer</button></td></tr>`}).join('')}</tbody></table></div>`:'<div class="empty">Aucun service prévu cette semaine.</div>';
    const totals=db.employees.map(e=>({name:e.name,total:list.filter(s=>s.employeeId===e.id).reduce((n,s)=>n+hours(s),0)})).filter(x=>x.total>0);
    const total=list.reduce((n,s)=>n+hours(s),0);
    $('hours-total').textContent=fmt(total);
    $('hours-summary').innerHTML=totals.length?`<div class="table-wrap"><table><thead><tr><th>Employé</th><th>Heures prévues</th></tr></thead><tbody>${totals.map(t=>`<tr><td>${esc(t.name)}</td><td><strong>${fmt(t.total)}</strong></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Les totaux apparaîtront quand tu ajoutes des services au planning.</div>';
  }

  const palette=['#dbeafe','#dcfce7','#fce7f3','#fef3c7','#ede9fe','#ffedd5','#cffafe','#f3e8ff'];
  function kmDateKey(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
  function kmWeekStartFromDate(d){const x=new Date(d);const dow=x.getDay();x.setDate(x.getDate()-(dow===0?6:dow-1));return kmDateKey(x);}
  function kmRenderCalendar(){
    const root=$('staff-calendar'); if(!root)return;
    const base=new Date(weekStart()+'T12:00:00'), view=$('calendar-view').value;
    let start=new Date(base), end=new Date(base);
    if(view==='month'){start.setDate(1);start.setDate(start.getDate()-((start.getDay()+6)%7));end=new Date(start);end.setDate(start.getDate()+41);}
    else end.setDate(start.getDate()+6);
    $('calendar-label').textContent=view==='month'?base.toLocaleDateString('fr-FR',{month:'long',year:'numeric'}):'Semaine du '+base.toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit'});
    const today=kmDateKey(new Date()), dates=[];
    for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1))dates.push(new Date(d));
    const head=['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'].map(x=>`<div class="km-cal-weekhead">${x}</div>`).join('');
    const cells=dates.map(d=>{
      const key=kmDateKey(d), shifts=db.shifts.filter(s=>s.date===key).sort((a,b)=>a.start.localeCompare(b.start));
      const sameMonth=d.getMonth()===base.getMonth();
      const items=shifts.map(sh=>{const i=db.employees.findIndex(e=>e.id===sh.employeeId),emp=db.employees[i];return `<div class="km-cal-shift" style="background:${palette[Math.max(0,i)%palette.length]};color:#222"><strong>${esc(emp?.name||'Employé supprimé')}</strong>${esc(sh.start)}–${esc(sh.end)}<br>${esc(sh.shift)}</div>`}).join('');
      return `<div class="km-cal-day ${key===today?'km-today':''} ${view==='month'&&!sameMonth?'km-other':''}" data-calendar-date="${key}"><div class="km-cal-dayhead">${d.toLocaleDateString('fr-FR',{weekday:'short',day:'2-digit',month:'2-digit'})}</div>${items||'<span style="font-size:11px;opacity:.6">Aucun service</span>'}</div>`;
    }).join('');
    root.innerHTML=`<div class="${view==='month'?'km-cal-month':'km-cal-grid'}">${view==='month'?head:''}${cells}</div><div class="km-cal-legend">${db.employees.map((e,i)=>`<span><i class="km-dot" style="background:${palette[i%palette.length]}"></i>${esc(e.name)}</span>`).join('')}</div>`;
  }
  $('staff-calendar').addEventListener('click',e=>{const cell=e.target.closest('[data-calendar-date]');if(!cell)return;const d=new Date(cell.dataset.calendarDate+'T12:00:00');$('schedule-week').value=kmWeekStartFromDate(d);$('schedule-day').value=String(d.getDay());renderShifts();kmRenderCalendar();});

  function render(){renderEmployees();renderShifts();kmRenderCalendar();}
  let employeePhotoData = '';
  function showEmployeePhoto(dataUrl){employeePhotoData=dataUrl||'';const p=$('employee-photo-preview');if(p)p.innerHTML=employeePhotoData?`<img alt="Photo de profil" src="${employeePhotoData}">`:'<span>👤</span>';}
  function employeeImageAsDataUrl(file,maxSize=500){return new Promise((resolve,reject)=>{if(!file||!file.type.startsWith('image/'))return reject(new Error('Choisis un fichier image.'));const reader=new FileReader();reader.onload=()=>{const img=new Image();img.onload=()=>{const scale=Math.min(1,maxSize/Math.max(img.width,img.height));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*scale));c.height=Math.max(1,Math.round(img.height*scale));c.getContext('2d').drawImage(img,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.82));};img.onerror=()=>reject(new Error('Impossible de lire cette image.'));img.src=reader.result;};reader.onerror=()=>reject(new Error('Lecture du fichier impossible.'));reader.readAsDataURL(file);});}
  $('employee-photo-file')?.addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;try{showEmployeePhoto(await employeeImageAsDataUrl(file,500));}catch(err){alert(err.message||'Impossible de charger la photo.');}});
  function resetEmployee(){ $('employee-form').reset(); $('employee-id').value=''; showEmployeePhoto(''); $('employee-save').textContent='Ajouter l’employé'; $('employee-cancel').hidden=true; }
  $('employee-form').addEventListener('submit',e=>{
    e.preventDefault();const name=$('employee-name').value.trim();if(!name)return;
    const id=$('employee-id').value||('emp_'+Date.now()+'_'+Math.random().toString(36).slice(2,7));
    const previous=db.employees.find(x=>x.id===id);
    const record={id,name,role:$('employee-role').value,phone:$('employee-phone').value.trim(),contract:$('employee-contract').value,photo:employeePhotoData||previous?.photo||''};
    const i=db.employees.findIndex(x=>x.id===id);if(i>=0)db.employees[i]=record;else db.employees.push(record);
    try{save();resetEmployee();render();}catch(err){alert('Impossible d’enregistrer les données. Essaie une photo plus petite.');}
  });
  $('employee-cancel').addEventListener('click',resetEmployee);
  $('employee-list').addEventListener('click',e=>{
    const edit=e.target.closest('[data-edit-employee]');const del=e.target.closest('[data-delete-employee]');
    if(edit){const x=db.employees.find(a=>a.id===edit.dataset.editEmployee);if(!x)return;$('employee-id').value=x.id;$('employee-name').value=x.name;$('employee-role').value=x.role;$('employee-phone').value=x.phone;$('employee-contract').value=x.contract;showEmployeePhoto(x.photo||'');$('employee-save').textContent='Enregistrer les modifications';$('employee-cancel').hidden=false;}
    if(del){const id=del.dataset.deleteEmployee;const x=db.employees.find(a=>a.id===id);if(!x)return;if(confirm('Supprimer '+x.name+' ? Les services déjà planifiés resteront visibles.')){db.employees=db.employees.filter(a=>a.id!==id);save();render();}}
  });
  $('schedule-add').addEventListener('click',()=>{
    if(!db.employees.length){alert('Ajoute d’abord un employé.');return;}
    const start=$('schedule-start').value,end=$('schedule-end').value;
    if(!start||!end||start===end){alert('Choisis une heure de début et de fin différentes.');return;}
    const dates=weekDates(),day=Number($('schedule-day').value),date=dates[day===0?6:day-1];
    db.shifts.push({id:'shift_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),employeeId:$('schedule-employee').value,date,shift:$('schedule-shift').value,start,end,pause:Math.max(0,Math.min(600,Number($('schedule-break').value)||0)),note:$('schedule-note').value.trim()});
    save();$('schedule-note').value='';renderShifts();kmRenderCalendar();
  });
  $('schedule-list').addEventListener('click',e=>{const b=e.target.closest('[data-delete-shift]');if(!b)return;db.shifts=db.shifts.filter(s=>s.id!==b.dataset.deleteShift);save();renderShifts();kmRenderCalendar();});
  $('schedule-week').addEventListener('change',()=>{renderShifts();kmRenderCalendar();});
  $('calendar-view').addEventListener('change',kmRenderCalendar);
  $('calendar-prev').addEventListener('click',()=>{const d=new Date(weekStart()+'T12:00:00');if($('calendar-view').value==='month')d.setMonth(d.getMonth()-1);else d.setDate(d.getDate()-7);$('schedule-week').value=kmWeekStartFromDate(d);renderShifts();kmRenderCalendar();});
  $('calendar-next').addEventListener('click',()=>{const d=new Date(weekStart()+'T12:00:00');if($('calendar-view').value==='month')d.setMonth(d.getMonth()+1);else d.setDate(d.getDate()+7);$('schedule-week').value=kmWeekStartFromDate(d);renderShifts();kmRenderCalendar();});
  $('calendar-today').addEventListener('click',()=>{const d=new Date();$('schedule-week').value=kmWeekStartFromDate(d);renderShifts();kmRenderCalendar();});
  $('establishment-select')?.addEventListener('change',()=>{read();render();});
  const today=new Date(), dow=today.getDay();today.setDate(today.getDate()-(dow===0?6:dow-1));$('schedule-week').value=today.toISOString().slice(0,10);
  read();render();
})();

</script>
<script>

(function(){
  const $ = id => document.getElementById(id);
  const key = () => 'km_v18_personnel_' + ($('establishment-select')?.value || 'default');
  const esc2 = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function readAbs(){
    try {
      const x=JSON.parse(localStorage.getItem(key())||'null');
      return x && Array.isArray(x.absences) ? x.absences : [];
    } catch(e) { return []; }
  }
  function saveAbs(a){
    try {
      const x=JSON.parse(localStorage.getItem(key())||'{}');
      x.absences=a; localStorage.setItem(key(),JSON.stringify(x));
    } catch(e) { alert('Impossible d’enregistrer les absences dans ce navigateur.'); }
  }
  function employeeOptions(){
    const sel=$('absence-employee'); if(!sel)return;
    const old=sel.value;
    let data=[];
    try { const x=JSON.parse(localStorage.getItem(key())||'{}'); data=x.employees||[]; } catch(e){}
    sel.innerHTML=data.map(e=>`<option value="${e.id}">${esc2(e.name)}</option>`).join('');
    if(data.some(e=>e.id===old))sel.value=old;
  }
  function renderAbs(){
    const list=$('absence-list'); if(!list)return;
    const abs=readAbs(); let emps=[];
    try {emps=JSON.parse(localStorage.getItem(key())||'{}').employees||[]}catch(e){}
    list.innerHTML=abs.length?abs.map(a=>`<div class="quick"><div style="flex:1"><strong>${esc2(emps.find(e=>e.id===a.employeeId)?.name||'Employé')} — ${esc2(a.type)}</strong><small>${esc2(a.start)} au ${esc2(a.end)}${a.note?' · '+esc2(a.note):''}</small></div><button class="btn" type="button" data-abs-delete="${a.id}">Supprimer</button></div>`).join(''):'<p class="muted">Aucune absence enregistrée.</p>';
  }
  $('absence-toggle')?.addEventListener('click',()=>{const w=$('absence-form-wrap');w.style.display=w.style.display==='none'?'block':'none';employeeOptions();renderAbs();});
  $('absence-cancel')?.addEventListener('click',()=>$('absence-form-wrap').style.display='none');
  $('absence-save')?.addEventListener('click',()=>{
    const employeeId=$('absence-employee').value, start=$('absence-start').value, end=$('absence-end').value;
    if(!employeeId){alert('Ajoute d’abord un employé.');return}
    if(!start||!end||end<start){alert('Choisis des dates valides.');return}
    const abs=readAbs();abs.push({id:'abs_'+Date.now(),employeeId,start,end,type:$('absence-type').value,note:$('absence-note').value.trim()});
    saveAbs(abs);$('absence-note').value='';renderAbs();alert('Absence enregistrée.');
  });
  $('absence-list')?.addEventListener('click',e=>{
    const b=e.target.closest('[data-abs-delete]');if(!b)return;
    saveAbs(readAbs().filter(a=>a.id!==b.dataset.absDelete));renderAbs();
  });
  $('staff-calendar')?.addEventListener('dblclick',e=>{
    const card=e.target.closest('.km-cal-shift');if(!card)return;
    const lines=card.innerText.split('\n');
    const name=(lines[0]||'').trim(),times=(lines.find(x=>x.includes('–'))||'').trim(),shiftName=(lines[lines.length-1]||'').trim();
    let db;try{db=JSON.parse(localStorage.getItem(key())||'{}')}catch(err){alert('Impossible de lire le planning.');return;}
    const employee=(db.employees||[]).find(x=>x.name===name);
    const match=(db.shifts||[]).find(sh=>sh.employeeId===employee?.id&&(sh.start+'–'+sh.end)===times&&sh.shift===shiftName);
    if(!match){alert('Double-clique sur la case colorée du service à modifier.');return;}
    const who=prompt('Employé :',employee?.name||'');if(who===null)return;
    const target=(db.employees||[]).find(x=>x.name.toLowerCase()===who.trim().toLowerCase());
    if(!target){alert('Ce nom ne correspond pas à un employé existant.');return;}
    const start=prompt('Heure de début (HH:MM) :',match.start);if(start===null)return;
    const end=prompt('Heure de fin (HH:MM) :',match.end);if(end===null)return;
    if(!/^\d{2}:\d{2}$/.test(start)||!/^\d{2}:\d{2}$/.test(end)||start===end){alert('Horaires invalides.');return;}
    const type=prompt('Service (Matin, Midi, Soir…) :',match.shift);if(type===null)return;
    match.employeeId=target.id;match.start=start;match.end=end;match.shift=type.trim()||match.shift;
    localStorage.setItem(key(),JSON.stringify(db));alert('Service modifié.');location.reload();
  });
  $('staff-print')?.addEventListener('click',()=>{
    const w=window.open('','_blank');
    if(!w){alert('Autorise les fenêtres pop-up pour imprimer.');return;}
    const cal=$('staff-calendar')?.innerHTML||'';
    const list=$('schedule-list')?.innerHTML||'';
    w.document.open();
    w.document.write(`<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>Planning du personnel</title><style>body{font:13px Arial;padding:18px;color:#222}table{width:100%;border-collapse:collapse}td,th{border:1px solid #aaa;padding:5px;text-align:left}.km-cal-grid,.km-cal-month{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.km-cal-day{border:1px solid #aaa;min-height:70px;padding:4px}.km-cal-shift{background:#eee!important;color:#111;padding:4px;margin:3px;font-size:10px}.km-cal-weekhead{font-weight:bold;text-align:center}.btn,button{display:none!important}</style></head><body><h1>Planning du personnel</h1>${cal}${list}</body></html>`);
    w.document.close();w.focus();setTimeout(()=>w.print(),300);
  });
})();
</script>

<script>
(function(){
 const $=id=>document.getElementById(id);
 const storageKey=()=> 'km_temp_devices_'+($('establishment-select')?.value||'default');
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=()=>{try{const x=JSON.parse(localStorage.getItem(storageKey())||'[]');return Array.isArray(x)?x:[]}catch(e){return[]}};
 const save=arr=>localStorage.setItem(storageKey(),JSON.stringify(arr));
 function render(){
   const devices=load(),sel=$('temp-equipment'),old=sel.value;
   sel.innerHTML='<option value="">Choisir un appareil…</option>'+devices.map(d=>`<option value="${esc(d.name)}">${esc(d.name)} — ${esc(d.type)}</option>`).join('');
   if(devices.some(d=>d.name===old))sel.value=old;
   $('temp-device-list').innerHTML=devices.length?`<div class="table-wrap"><table><thead><tr><th>Appareil</th><th>Type / emplacement</th><th>Limites indicatives</th><th></th></tr></thead><tbody>${devices.map(d=>`<tr><td><strong>${esc(d.name)}</strong></td><td>${esc(d.type)}${d.location?'<br><small>'+esc(d.location)+'</small>':''}</td><td>${d.min!==''&&d.min!=null?esc(d.min)+' °C':'—'} / ${d.max!==''&&d.max!=null?esc(d.max)+' °C':'—'}</td><td><button type="button" class="btn" data-device-delete="${esc(d.id)}">Supprimer</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Aucun appareil enregistré. Ajoute ton premier frigo ou congélateur ci-dessus.</div>';
 }
 $('temp-device-form').addEventListener('submit',e=>{
   e.preventDefault();
   const name=$('device-name').value.trim();if(!name)return;
   const devices=load();
   if(devices.some(d=>d.name.toLowerCase()===name.toLowerCase())){alert('Un appareil porte déjà ce nom. Choisis un nom différent.');return}
   devices.push({id:'device_'+Date.now(),name,type:$('device-type').value,location:$('device-location').value.trim(),min:$('device-min').value,max:$('device-max').value});
   save(devices);e.target.reset();render();
 });
 $('temp-device-list').addEventListener('click',e=>{
   const b=e.target.closest('[data-device-delete]');if(!b)return;
   const d=load().find(x=>x.id===b.dataset.deviceDelete);if(!d)return;
   if(confirm('Supprimer l’appareil « '+d.name+' » de la liste ? Les anciens relevés restent dans l’historique.')){
     save(load().filter(x=>x.id!==d.id));render();
   }
 });
 // The existing temp form stores the selected device's name rather than its internal ID.
 const form=$('temp-form');
 form.addEventListener('submit',e=>{
   const selected=$('temp-equipment');
   const device=load().find(d=>d.id===selected.value);
   if(!device){e.preventDefault();alert('Choisis un appareil enregistré avant d’ajouter un relevé.');return}
   selected.dataset.selectedName=device.name;
 },true);
 const originalAdd=window.addEventListener;
 // Ensure historical row displays the human-readable device name.
 $('establishment-select')?.addEventListener('change',render);
 render();
})();
</script>


<script>
(function(){
 const $=id=>document.getElementById(id);
 const key=()=> 'km_food_lots_'+($('establishment-select')?.value||'default');
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=()=>{try{let a=JSON.parse(localStorage.getItem(key())||'[]');return Array.isArray(a)?a:[]}catch(e){return[]}};
 const save=a=>localStorage.setItem(key(),JSON.stringify(a));
 const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
 function status(l){const days=Math.ceil((new Date(l.dlc+'T12:00:00')-new Date(today()+'T12:00:00'))/86400000);if(Number(l.qty)<=0)return {k:'empty',label:'Épuisé'};if(days<0)return {k:'expired',label:'DLC dépassée'};if(days<=3)return {k:'urgent',label:days===0?'DLC aujourd’hui':`DLC dans ${days} j`};return {k:'ok',label:'À surveiller'};}
 function render(){
  let lots=load();const q=$('lot-filter').value.trim().toLowerCase(),f=$('lot-status-filter').value;
  lots=lots.filter(l=>(!q||[l.product,l.number,l.supplier,l.category].join(' ').toLowerCase().includes(q))&&(f==='all'||status(l).k===f));
  lots.sort((a,b)=>a.dlc.localeCompare(b.dlc));
  const all=load(), expired=all.filter(l=>status(l).k==='expired').length, urgent=all.filter(l=>status(l).k==='urgent').length;
  $('lot-summary').innerHTML=`<div class="card"><strong>${all.length}</strong><div class="muted">Lots enregistrés</div></div><div class="card"><strong>${urgent}</strong><div class="muted">DLC sous 3 jours</div></div><div class="card"><strong>${expired}</strong><div class="muted">DLC dépassées</div></div>`;
  $('lot-table').innerHTML=lots.length?`<div class="table-wrap"><table><thead><tr><th>Statut</th><th>Produit / catégorie</th><th>Lot / fournisseur</th><th>Réception</th><th>DLC</th><th>Quantité restante</th><th>Conservation / température</th><th>Actions</th></tr></thead><tbody>${lots.map(l=>{const s=status(l);return `<tr><td><strong>${esc(s.label)}</strong></td><td>${esc(l.product)}<br><small>${esc(l.category)}</small></td><td>${esc(l.number)}<br><small>${esc(l.supplier||'—')}</small></td><td>${esc(l.received)}</td><td>${esc(l.dlc)}</td><td>${esc(l.qty)} ${esc(l.unit)}</td><td>${esc(l.storage)}${l.temp!==''?'<br>'+esc(l.temp)+' °C':''}</td><td><button class="btn" type="button" data-lot-use="${l.id}">Utiliser quantité</button> <button class="btn" type="button" data-lot-delete="${l.id}">Supprimer</button></td></tr>`}).join('')}</tbody></table></div>`:'<div class="empty">Aucun lot ne correspond à la recherche.</div>';
 }
 $('lot-form').addEventListener('submit',e=>{
  e.preventDefault();
  const received=$('lot-received').value,dlc=$('lot-dlc').value,opened=$('lot-opened').value,useby=$('lot-useby').value,qty=Number($('lot-qty').value);
  if(dlc<received){alert('La DLC ne peut pas être antérieure à la date de réception. Vérifie la saisie.');return}
  if(opened&&opened<received){alert('La date d’ouverture ne peut pas précéder la réception.');return}
  if(useby&&opened&&useby<opened){alert('La date limite après ouverture ne peut pas précéder l’ouverture.');return}
  if(!(qty>0)){alert('La quantité doit être supérieure à zéro.');return}
  const a=load();a.push({id:'lot_'+Date.now(),product:$('lot-product').value.trim(),category:$('lot-category').value,number:$('lot-number').value.trim(),supplier:$('lot-supplier').value.trim(),received,dlc,qty,initialQty:qty,unit:$('lot-unit').value,storage:$('lot-storage').value,opened,useby,temp:$('lot-temp').value,notes:$('lot-notes').value.trim()});
  save(a);e.target.reset();$('lot-received').value=today();render();alert('Lot enregistré.');
 });
 $('lot-table').addEventListener('click',e=>{
  const use=e.target.closest('[data-lot-use]'),del=e.target.closest('[data-lot-delete]');let a=load();
  if(use){const l=a.find(x=>x.id===use.dataset.lotUse);if(!l)return;const v=prompt(`Quantité utilisée (${l.unit}) — ${l.product}`, '1');if(v===null)return;const n=Number(v);if(!(n>0)||n>Number(l.qty)){alert('Quantité invalide ou supérieure au stock restant.');return}l.qty=Math.round((Number(l.qty)-n)*1000)/1000;save(a);render();}
  if(del){if(!confirm('Supprimer ce lot du registre ? Cette action ne peut pas être annulée.'))return;save(a.filter(x=>x.id!==del.dataset.lotDelete));render();}
 });
 $('lot-filter').addEventListener('input',render);$('lot-status-filter').addEventListener('change',render);
 $('establishment-select')?.addEventListener('change',render);
 $('lot-print').addEventListener('click',()=>{
  const w=window.open('','_blank');
  if(!w){alert('Autorise les fenêtres pop-up pour imprimer.');return;}
  const table=$('lot-table')?.innerHTML||'<p>Aucun lot à imprimer.</p>';
  w.document.open();
  w.document.write(`<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>Registre DLC et lots</title><style>body{font:12px Arial;padding:18px;color:#222}table{width:100%;border-collapse:collapse}th,td{border:1px solid #999;padding:5px;text-align:left}button,.btn{display:none!important}h1{font-size:20px}</style></head><body><h1>Registre des lots et DLC</h1>${table}</body></html>`);
  w.document.close();w.focus();setTimeout(()=>w.print(),300);
 });
 $('lot-received').value=today();render();
})();
</script>

</body></html>');
    w.document.close();w.focus();w.print();
  });
})();

</script>

<script>
(function(){
  const $c = id => document.getElementById(id);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const site = () => document.getElementById('establishment-select')?.value || 'default';
  const read = (key, fallback=[]) => {
    try { const value=JSON.parse(localStorage.getItem(key)||'null'); return value ?? fallback; } catch(e) { return fallback; }
  };
  const day = () => { const d=new Date(); d.setHours(0,0,0,0); return d; };
  const dateOf = value => {
    if(!value) return null;
    const d = new Date(String(value).slice(0,10)+'T00:00:00');
    return Number.isNaN(d.getTime()) ? null : d;
  };
  const daysBetween = d => Math.round((d-day())/86400000);
  window.refreshCentralDashboard = function(){
    const alerts=[];
    const today=day();
    const add=(level,category,title,detail,page)=>alerts.push({level,category,title,detail,page});
    // Food stock from the existing application state.
    try {
      (Array.isArray(stocks)?stocks:[]).filter(p=>Number(p.qty)<=Number(p.min)).forEach(p=>{
        add(Number(p.qty)<=0?'urgent':'warning','Stock',Number(p.qty)<=0?'Rupture : '+p.name:'Stock bas : '+p.name,
          `${p.qty} ${p.unit} en stock · seuil ${p.min} ${p.unit}`,'stocks');
      });
    } catch(e){}
    // Consumable/non-food inventory.
    const consumables=read('km_consumables_'+site(),[]);
    const nonfood=Array.isArray(consumables)?consumables:(Array.isArray(consumables.items)?consumables.items:[]);
    nonfood.forEach(p=>{
      const qty=Number(p.qty ?? p.quantity ?? p.stock ?? 0), min=Number(p.min ?? p.minimum ?? p.threshold ?? 0);
      if(qty<=min) add(qty<=0?'urgent':'warning','Consommables',qty<=0?'Rupture : '+(p.name||p.label||'article'):'À recommander : '+(p.name||p.label||'article'),
        `${qty} ${p.unit||'unité(s)'} · seuil ${min}`,'nonconsumables');
    });
    // DLC / lots.
    const lots=read('km_food_lots_'+site(),[]);
    (Array.isArray(lots)?lots:[]).forEach(l=>{
      const raw=l.dlc||l.expiry||l.dateDlc||l.useBy;
      const d=dateOf(raw); if(!d)return;
      const delta=daysBetween(d);
      if(delta<0) add('urgent','DLC','DLC dépassée : '+(l.product||l.name||'produit'),`Date : ${raw} · vérifier le lot et le retirer si nécessaire`,'traceability');
      else if(delta<=3) add('warning','DLC',delta===0?'DLC aujourd’hui : '+(l.product||l.name||'produit'):`DLC proche : ${l.product||l.name||'produit'}`,`${delta===0?'Aujourd’hui':'Dans '+delta+' jour(s)'} · ${raw}`,'traceability');
    });
    // Cleaning schedule.
    const tasks=read('km_clean_tasks_'+site(),[]);
    (Array.isArray(tasks)?tasks:[]).forEach(t=>{
      const raw=t.nextDate||t.nextDue||t.dueDate||t.date;
      const d=dateOf(raw); if(!d)return;
      const delta=daysBetween(d);
      if(delta<0) add('urgent','Nettoyage','En retard : '+(t.name||t.task||'tâche de nettoyage'),`Échéance : ${raw}`,'cleaning');
      else if(delta===0) add('today','Nettoyage','À faire aujourd’hui : '+(t.name||t.task||'tâche de nettoyage'),t.assignee||t.person||'Responsable à vérifier','cleaning');
    });
    // Temperature entries from the app's in-memory journal. A reading outside a registered
    // device range is flagged only when the device can be matched by name.
    try {
      const readings=Array.isArray(temps)?temps:[];
      const devices=read('km_temp_devices_'+site(),[]);
      readings.slice(-100).forEach(r=>{
        const device=(Array.isArray(devices)?devices:[]).find(d=>(d.name||d.label)===r.equipment);
        if(device && Number.isFinite(Number(r.value))){
          const min=Number(device.min ?? device.minTemp), max=Number(device.max ?? device.maxTemp);
          if(Number.isFinite(min)&&Number.isFinite(max)&&(Number(r.value)<min||Number(r.value)>max))
            add('urgent','Température','Température hors limites : '+r.equipment,`${r.value} °C · plage configurée ${min} à ${max} °C · relevé ${r.date||''}`,'temperatures');
        }
      });
    } catch(e){}
    // Today's staff shifts / absences. Keep this as an informational card only.
    const staffData=read('km_v18_personnel_'+site(),{});
    const shifts=Array.isArray(staffData.shifts)?staffData.shifts:[];
    const absences=Array.isArray(staffData.absences)?staffData.absences:[];
    const todayISO=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
    const todayShifts=shifts.filter(s=>(s.date||s.day||s.shiftDate)===todayISO);
    if(todayShifts.length) add('today','Personnel',`${todayShifts.length} service(s) prévu(s) aujourd’hui`,'Consulte le planning pour les horaires et les affectations','personnel');
    const todaysAbsences=absences.filter(a=>{
      const start=dateOf(a.start||a.date||a.from), end=dateOf(a.end||a.to||a.start||a.date||a.from);
      return start&&end&&today>=start&&today<=end;
    });
    if(todaysAbsences.length) add('warning','Personnel',`${todaysAbsences.length} absence(s) à vérifier aujourd’hui`,'Pense à adapter le planning','personnel');

    const rank={urgent:0,warning:1,today:2,info:3};
    alerts.sort((a,b)=>rank[a.level]-rank[b.level]);
    const countUrgent=alerts.filter(a=>a.level==='urgent').length;
    const countToday=alerts.filter(a=>a.level==='today').length;
    const countStock=alerts.filter(a=>a.category==='Stock'||a.category==='Consommables').length;
    const countDlc=alerts.filter(a=>a.category==='DLC').length;
    if($c('central-urgent'))$c('central-urgent').textContent=countUrgent;
    if($c('central-today'))$c('central-today').textContent=countToday;
    if($c('central-stock'))$c('central-stock').textContent=countStock;
    if($c('central-dlc'))$c('central-dlc').textContent=countDlc;
    if(!$c('central-alerts'))return;
    if(!alerts.length){
      $c('central-alerts').innerHTML='<div class="empty">✅ Aucune alerte détectée dans les données disponibles. Pense à enregistrer tes relevés et échéances pour que le tableau soit utile.</div>';
    } else {
      $c('central-alerts').innerHTML=alerts.slice(0,30).map(a=>{
        const badge=a.level==='urgent'?'🔴 Prioritaire':a.level==='warning'?'🟠 À vérifier':a.level==='today'?'🔵 Aujourd’hui':'ℹ️ Info';
        return `<div class="quick"><span class="dot" style="background:${a.level==='urgent'?'#c53b3b':a.level==='warning'?'#d58a00':'#3d79c5'}"></span><div style="min-width:0;flex:1"><strong>${esc(a.title)}</strong><small>${esc(a.category)} · ${esc(a.detail)}</small></div><span class="pill ${a.level==='urgent'?'low':a.level==='warning'?'warn':'ok'}">${badge}</span><button class="btn" type="button" onclick="showPage('${esc(a.page)}')">Ouvrir</button></div>`;
      }).join('');
    }
  };
  document.addEventListener('DOMContentLoaded',()=>setTimeout(window.refreshCentralDashboard,100));
  const originalShowPage=window.showPage;
  if(typeof originalShowPage==='function')window.showPage=function(id){originalShowPage(id);if(id==='dashboard')window.refreshCentralDashboard();};
  document.getElementById('establishment-select')?.addEventListener('change',()=>setTimeout(window.refreshCentralDashboard,100));
  // Refresh after the app's main render/save functions update local data.
  const wrap = name => { const old=window[name]; if(typeof old==='function')window[name]=function(...args){const result=old.apply(this,args);try{window.refreshCentralDashboard()}catch(e){}return result;}; };
  wrap('render'); wrap('save');
})();
</script>


<script>
(function(){
  const $ = id => document.getElementById(id);
  const siteKey = () => ($('establishment-select')?.value || 'default');
  const companyKey = () => 'km_company_details_' + siteKey();
  const companyFields = ['company-name','company-manager','company-address','company-postcode-city','company-phone','company-email','company-siret','company-vat'];
  const fieldNames = ['name','manager','address','postcodeCity','phone','email','siret','vat'];
  const escapeHtml = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let companyLogoData = '';
  function showCompanyLogo(dataUrl){
    companyLogoData = dataUrl || '';
    const preview=$('company-logo-preview');
    if(preview) preview.innerHTML=companyLogoData?`<img alt="Logo de l’entreprise" src="${companyLogoData}">`:'<span>VLT</span>';
  }
  function loadCompany(){
    let data={}; try { data=JSON.parse(localStorage.getItem(companyKey())||'{}')||{}; } catch(e){}
    companyFields.forEach((id,i)=>{ if($(id)) $(id).value=data[fieldNames[i]]||''; });
    showCompanyLogo(data.logo||'');
  }
  function imageAsDataUrl(file, maxSize=900){
    return new Promise((resolve,reject)=>{
      if(!file || !file.type.startsWith('image/')) return reject(new Error('Choisis un fichier image.'));
      const reader=new FileReader();
      reader.onload=()=>{
        const img=new Image();
        img.onload=()=>{
          const scale=Math.min(1,maxSize/Math.max(img.width,img.height));
          const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));
          const ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);
          resolve(canvas.toDataURL('image/jpeg',.84));
        };
        img.onerror=()=>reject(new Error('Impossible de lire cette image.'));
        img.src=reader.result;
      };
      reader.onerror=()=>reject(new Error('Lecture du fichier impossible.'));
      reader.readAsDataURL(file);
    });
  }
  $('company-logo-file')?.addEventListener('change',async e=>{
    const file=e.target.files?.[0];if(!file)return;
    try{showCompanyLogo(await imageAsDataUrl(file));}
    catch(err){alert(err.message||'Erreur lors du chargement du logo.');}
  });
  $('company-logo-remove')?.addEventListener('click',()=>{showCompanyLogo('');if($('company-logo-file'))$('company-logo-file').value='';});
  $('company-details-form')?.addEventListener('submit', e=>{
    e.preventDefault();
    const data={}; companyFields.forEach((id,i)=>data[fieldNames[i]]=$(id)?.value.trim()||'');
    data.logo=companyLogoData;
    try{localStorage.setItem(companyKey(),JSON.stringify(data));alert('Coordonnées et logo enregistrés.');}
    catch(err){alert('Le stockage du navigateur est plein. Essaie avec une image plus petite.');}
  });
  function toggleClientFields(){
    const isBusiness=$('quote-client-type')?.value==='entreprise';
    ['client-siret-field','client-vat-field'].forEach(id=>{if($(id))$(id).style.display=isBusiness?'':'none';});
    const contact=$('quote-client-contact')?.closest('.field');
    if(contact)contact.style.display=isBusiness?'':'none';
  }
  $('quote-client-type')?.addEventListener('change',toggleClientFields);
  $('establishment-select')?.addEventListener('change',loadCompany);
  loadCompany(); toggleClientFields();

  // Rebuild print output so saved quotes include both issuer and recipient details.
  window.printQuote = function(id){
    const q=quotes.find(x=>x.id===id);
    if(!q){ alert('Devis introuvable.'); return; }
    let company={}; try{company=JSON.parse(localStorage.getItem(companyKey())||'{}')||{};}catch(e){}
    const lineRows=(q.lines||[]).map(l=>`<tr><td>${escapeHtml(l.description)}</td><td>${escapeHtml(l.qty)}</td><td>${escapeHtml(typeof window.money==='function'?window.money(l.unitPrice):l.unitPrice)}</td><td>${escapeHtml(typeof window.money==='function'?window.money(l.total):l.total)}</td></tr>`).join('');
    const moneyFmt=n=>typeof window.money==='function'?window.money(n):(Number(n)||0).toFixed(2)+' €';
    const companyBits=[company.name,company.manager?'Responsable : '+company.manager:'',company.address,company.postcodeCity,company.phone?'Tél. : '+company.phone:'',company.email,company.siret?'SIRET : '+company.siret:'',company.vat?'TVA : '+company.vat:''].filter(Boolean).map(escapeHtml).join('<br>');
    const companyLogo=company.logo?`<img src="${company.logo}" alt="Logo" style="max-width:150px;max-height:90px;object-fit:contain;margin-bottom:12px;display:block">`:`<img src="data:image/jpeg;base64," alt="VLT Food Management" style="max-width:150px;max-height:90px;object-fit:contain;margin-bottom:12px;display:block">`;
    const clientBits=[q.clientType==='entreprise'?'Entreprise':'Particulier',q.client,q.clientContact?'Contact : '+q.clientContact:'',q.clientAddress,q.clientPostcodeCity,q.clientPhone?'Tél. : '+q.clientPhone:'',q.clientEmail,q.clientType==='entreprise'&&q.clientSiret?'SIRET : '+q.clientSiret:'',q.clientType==='entreprise'&&q.clientVat?'TVA : '+q.clientVat:''].filter(Boolean).map(escapeHtml).join('<br>');
    const w=window.open('','_blank'); if(!w){alert('Autorise les fenêtres pop-up pour imprimer le devis.');return;}
    w.document.write(`<!doctype html><html lang="fr"><head><meta charset="utf-8"><title>${escapeHtml(q.number)}</title><style>body{font:14px Arial;margin:36px;color:#222}h1{margin-bottom:8px} .document-brand{display:flex;align-items:center;gap:20px;margin-bottom:18px}.document-brand img{max-width:150px;max-height:90px;object-fit:contain} .top{display:flex;justify-content:space-between;gap:30px;margin:24px 0}.block{width:50%;line-height:1.6}table{width:100%;border-collapse:collapse;margin-top:20px}td,th{border-bottom:1px solid #ddd;padding:10px;text-align:left}.total{text-align:right;margin-top:20px;font-size:20px;font-weight:bold}.small{color:#666;font-size:11px;margin-top:28px}</style>
</head><body><header class="document-brand">${companyLogo}<h1>DEVIS</h1></header><p><b>N° :</b> ${escapeHtml(q.number)}<br><b>Date :</b> ${escapeHtml(q.createdAt?new Date(q.createdAt).toLocaleDateString('fr-FR'):'')}<br><b>Objet :</b> ${escapeHtml(q.title)}<br><b>Date de l'événement :</b> ${escapeHtml(q.date)}<br><b>Valable jusqu'au :</b> ${escapeHtml(q.validity||'Non précisé')}</p><div class="top"><div class="block"><h3>Émetteur</h3>${companyBits||'Coordonnées de l’entreprise à compléter dans VLT Food Management'}</div><div class="block"><h3>Client</h3>${clientBits}</div></div><p><b>Nombre de personnes :</b> ${escapeHtml(q.guests||'—')}</p><table><thead><tr><th>Description</th><th>Quantité</th><th>Prix unitaire HT</th><th>Total HT</th></tr></thead><tbody>${lineRows}</tbody></table><div class="total">Total HT : ${moneyFmt(typeof window.quoteTotal==='function'?window.quoteTotal(q):(q.lines||[]).reduce((s,l)=>s+(Number(l.total)||0),0))}</div><p>${escapeHtml(q.notes||'')}</p><p class="small">Document généré par VLT Food Management. Vérifier les mentions légales, la TVA et les conditions applicables avant envoi. Ce modèle ne garantit pas à lui seul la conformité comptable.</p><script>window.addEventListener('load',()=>setTimeout(()=>window.print(),250))<\/script></body></html>`);
    w.document.close(); w.focus();
  };
})();
</script>


<section id="messagerie" class="page">
 <div class="panel">
  <div class="panel-head"><div><h2>💬 Messagerie professionnelle</h2><p class="muted">Échanges de travail entre les membres de l’établissement.</p></div><button class="btn" type="button" onclick="vltRefreshMessages()">Actualiser</button></div>
  <div class="stats" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin-bottom:14px">
   <div class="card"><div class="stat-label">Conversations</div><div class="stat-value" id="vlt-conversation-count">0</div></div>
   <div class="card"><div class="stat-label">Messages non lus</div><div class="stat-value" id="vlt-unread-count">0</div></div>
  </div>
  <div class="form-grid">
   <div class="field"><label for="vlt-current-user">Profil de démonstration</label><select id="vlt-current-user"><option>Direction</option><option>Cuisine</option><option>Salle</option><option>Équipe</option></select></div>
   <div class="field"><label for="vlt-new-conversation">Conversation</label><select id="vlt-new-conversation"><option>Cuisine</option><option>Salle</option><option>Direction</option><option>Équipe</option></select></div>
  </div>
  <div class="form-actions" style="margin:12px 0 18px"><button class="btn primary" type="button" onclick="vltOpenConversation()">Ouvrir la conversation</button></div>
  <div id="vlt-messaging-layout" style="display:grid;grid-template-columns:minmax(180px,260px) minmax(0,1fr);gap:16px">
   <div class="panel" style="margin:0!important;padding:12px!important"><h3>Conversations</h3><div id="vlt-conversation-list"><div class="empty">Aucune conversation pour le moment.</div></div></div>
   <div class="panel" style="margin:0!important;padding:12px!important;min-width:0">
    <div class="panel-head"><h3 id="vlt-chat-title">Choisis une conversation</h3><span class="pill">Interne</span></div>
    <div id="vlt-chat-messages" style="height:300px;overflow:auto;background:#f7f9fc;border:1px solid #e5e9f0;border-radius:12px;padding:12px"><div class="empty">Les messages apparaîtront ici.</div></div>
    <form id="vlt-message-form" style="margin-top:12px"><div class="field"><label for="vlt-message-text">Ton message</label><textarea id="vlt-message-text" rows="3" maxlength="2000" placeholder="Écris un message professionnel…" required></textarea></div><div class="form-actions"><small class="muted">Reste factuel, respectueux et précis.</small><button class="btn primary" type="submit">Envoyer</button></div></form>
   </div>
  </div>
  <div class="panel" style="margin-top:16px!important"><div class="panel-head"><h3>📢 Annonce importante</h3><span class="muted">Pour une information à toute l’équipe</span></div><form id="vlt-announcement-form"><div class="field"><label for="vlt-announcement-text">Annonce</label><textarea id="vlt-announcement-text" rows="2" maxlength="1500" placeholder="Ex. Inventaire prévu demain avant le service." required></textarea></div><button class="btn" type="submit">Publier l’annonce</button></form><div id="vlt-announcements" style="margin-top:12px"></div></div>
  <p class="muted" style="margin-top:12px">Prototype local : les messages sont enregistrés dans le navigateur de cet appareil. Ils ne sont pas encore synchronisés entre plusieurs employés ou appareils. Pour un usage réel, il faudra ajouter des comptes sécurisés, des droits d’accès et une base de données en ligne.</p>
 </div>
</section>


<script id="vlt-messaging-script">
(function(){
 const $=id=>document.getElementById(id), key=()=>'vlt_messages_'+($('establishment-select')?.value||'default');
 let active='';
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const stamp=t=>new Date(t).toLocaleString('fr-FR',{dateStyle:'short',timeStyle:'short'});
 const user=()=>$('vlt-current-user')?.value||'Direction';
 function read(){try{return JSON.parse(localStorage.getItem(key())||'{"conversations":[],"announcements":[]}')}catch(e){return {conversations:[],announcements:[]}}}
 function write(d){localStorage.setItem(key(),JSON.stringify(d))}
 function ensure(d,name){let c=d.conversations.find(x=>x.name===name);if(!c){c={id:'c'+Date.now()+Math.random().toString(16).slice(2,6),name,messages:[],updated:Date.now()};d.conversations.push(c)}return c}
 function unread(d,u){return d.conversations.reduce((n,c)=>n+c.messages.filter(m=>m.to===u&&!m.read).length,0)}
 window.vltOpenConversation=function(){let d=read(),c=ensure(d,$('vlt-new-conversation').value);active=c.id;write(d);render()};
 window.vltSelectConversation=function(id){active=id;render()};
 window.vltRefreshMessages=render;
 window.vltMarkAnnouncement=function(id){let d=read(),a=d.announcements.find(x=>x.id===id);if(a){a.readBy=a.readBy||[];if(!a.readBy.includes(user()))a.readBy.push(user());write(d);render()}};
 function render(){
  let d=read(),u=user(),activeConv=d.conversations.find(c=>c.id===active);
  if($('vlt-conversation-count'))$('vlt-conversation-count').textContent=d.conversations.length;
  if($('vlt-unread-count'))$('vlt-unread-count').textContent=unread(d,u);
  let list=$('vlt-conversation-list');
  if(list)list.innerHTML=d.conversations.length?d.conversations.slice().sort((a,b)=>b.updated-a.updated).map(c=>{let last=c.messages[c.messages.length-1];return `<button type="button" class="btn" style="display:block;width:100%;text-align:left;margin:6px 0;background:${c.id===active?'#eaf0ff':'#fff'}" onclick="vltSelectConversation('${esc(c.id)}')"><strong>${esc(c.name)}</strong><br><small>${esc(last?last.text.slice(0,54):'Aucun message')}</small></button>`}).join(''):'<div class="empty">Aucune conversation. Ouvre-en une pour commencer.</div>';
  if(activeConv){
   activeConv.messages.forEach(m=>{if(m.to===u)m.read=true});write(d);
   $('vlt-chat-title').textContent=activeConv.name;
   $('vlt-chat-messages').innerHTML=activeConv.messages.length?activeConv.messages.map(m=>`<div style="display:flex;justify-content:${m.from===u?'flex-end':'flex-start'};margin:8px 0"><div style="max-width:85%;padding:10px 12px;border-radius:12px;background:${m.from===u?'#dce8ff':'#fff'};border:1px solid #e1e7f0"><strong>${esc(m.from)}</strong><div style="white-space:pre-wrap;overflow-wrap:anywhere;margin:4px 0">${esc(m.text)}</div><small class="muted">${esc(stamp(m.ts))}</small></div></div>`).join(''):'<div class="empty">Pas encore de message. Lance la conversation.</div>';
   $('vlt-chat-messages').scrollTop=$('vlt-chat-messages').scrollHeight;
  }else{$('vlt-chat-title').textContent='Choisis une conversation';$('vlt-chat-messages').innerHTML='<div class="empty">Les messages apparaîtront ici.</div>'}
  let ann=$('vlt-announcements');
  if(ann)ann.innerHTML=d.announcements.length?d.announcements.slice().reverse().map(a=>`<div class="quick"><strong>Annonce importante</strong><small>${esc(a.from)} · ${esc(stamp(a.ts))}</small><div style="white-space:pre-wrap;margin-top:6px">${esc(a.text)}</div><small>${a.readBy?.includes(u)?'Lu par vous':'À lire'}</small><button type="button" class="btn" onclick="vltMarkAnnouncement('${esc(a.id)}')">${a.readBy?.includes(u)?'Lu':'Marquer comme lu'}</button></div>`).join(''):'<div class="empty">Aucune annonce pour le moment.</div>';
 }
 $('vlt-message-form')?.addEventListener('submit',e=>{e.preventDefault();let text=$('vlt-message-text').value.trim();if(!text)return;let d=read(),c=d.conversations.find(x=>x.id===active);if(!c){c=ensure(d,$('vlt-new-conversation').value);active=c.id}let from=user();c.messages.push({id:'m'+Date.now(),from,to:c.name==='Équipe'?'Équipe':c.name,text,ts:Date.now(),read:false});c.updated=Date.now();write(d);$('vlt-message-text').value='';render()});
 $('vlt-announcement-form')?.addEventListener('submit',e=>{e.preventDefault();let text=$('vlt-announcement-text').value.trim();if(!text)return;let d=read();d.announcements.push({id:'a'+Date.now(),text,from:user(),ts:Date.now(),readBy:[user()]});write(d);$('vlt-announcement-text').value='';render()});
 $('vlt-current-user')?.addEventListener('change',render);
 $('establishment-select')?.addEventListener('change',()=>{active='';render()});
  const oldShow=window.showPage;
  window.showPage=function(id){
    if(typeof oldShow==='function')oldShow(id);
    if(id==='messagerie')render();
  };
})();
</script>


<script>
if ('serviceWorker' in navigator && /^https?:$/.test(location.protocol)) {
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(err => console.warn('Service worker non activé:', err)));
}
</script>

<style>
#vlt-cloud-launch{position:fixed;right:14px;bottom:16px;z-index:1500;background:#f3a712;color:#241a06;border:0;border-radius:999px;padding:12px 16px;font-weight:800;box-shadow:0 5px 20px #0002;cursor:pointer}
#vlt-cloud-modal{display:none;position:fixed;inset:0;z-index:1600;background:#101827aa;padding:14px;overflow:auto}
#vlt-cloud-modal.open{display:block}
#vlt-cloud-card{max-width:620px;margin:5vh auto;background:#fff;border-radius:16px;padding:20px;color:#18212f;box-shadow:0 12px 50px #0003}
#vlt-cloud-card h2{margin:0 0 8px}
#vlt-cloud-card p{font-size:13px;line-height:1.5;color:#596579}
#vlt-cloud-card label{display:block;font-size:12px;font-weight:700;margin:12px 0 5px}
#vlt-cloud-card input{width:100%;padding:11px;border:1px solid #d9dfe7;border-radius:8px}
#vlt-cloud-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
#vlt-cloud-actions button{border:1px solid #d9dfe7;background:#fff;border-radius:9px;padding:10px 12px;font-weight:700;cursor:pointer}
#vlt-cloud-actions .primary{background:#f3a712;border-color:#f3a712}
#vlt-cloud-status{padding:10px;border-radius:8px;background:#f4f7fb;margin-top:12px;font-size:13px;white-space:pre-wrap}
</style>
<button id="vlt-cloud-launch" type="button">☁ Synchronisation</button>
<div id="vlt-cloud-modal" role="dialog" aria-modal="true" aria-label="Synchronisation VLT">
 <div id="vlt-cloud-card">
  <h2>☁ Synchronisation VLT</h2>
  <p>Synchronisation manuelle de test. D’abord, connecte-toi puis envoie les données de l’appareil qui contient les bonnes données. Sur l’autre appareil, connecte-toi au même compte puis récupère la sauvegarde. Garde une copie locale avant la première utilisation.</p>
  <label for="vlt-sb-url">URL du projet Supabase</label>
  <input id="vlt-sb-url" autocomplete="url" value="https://rpqkyddidnnhtwczethm.supabase.co" placeholder="https://xxxx.supabase.co">
  <label for="vlt-sb-key">Publishable key (clé publique commençant par sb_publishable_)</label>
  <input id="vlt-sb-key" autocomplete="off" placeholder="Colle ici la clé publique">
  <label for="vlt-sb-email">Adresse e-mail</label>
  <input id="vlt-sb-email" type="email" autocomplete="username" placeholder="toi@exemple.fr">
  <label for="vlt-sb-password">Mot de passe Supabase</label>
  <input id="vlt-sb-password" type="password" autocomplete="current-password" placeholder="Mot de passe">
  <div id="vlt-cloud-actions">
   <button id="vlt-cloud-register" type="button">Créer mon compte</button>
   <button id="vlt-cloud-login" type="button" class="primary">Se connecter</button>
   <button id="vlt-cloud-upload" type="button">Envoyer les données locales</button>
   <button id="vlt-cloud-download" type="button">Récupérer les données cloud</button>
   <button id="vlt-team-invite" type="button">Inviter un employé</button>
   <button id="vlt-cloud-logout" type="button">Déconnexion</button>
   <button id="vlt-cloud-close" type="button">Fermer</button>
  </div>
  <div style="border-top:1px solid #e1e7ef;margin-top:14px;padding-top:12px">
   <h3 style="margin:0 0 8px;font-size:15px">👥 Partager cet établissement</h3>
   <p style="margin:0 0 8px;font-size:12px;color:#596579">L’employé recevra une invitation par e-mail et créera son propre mot de passe.</p>
   <label for="vlt-team-email">E-mail de l’employé</label>
   <input id="vlt-team-email" type="email" autocomplete="email" placeholder="employe@exemple.fr">
   <label for="vlt-team-role">Rôle</label>
   <select id="vlt-team-role" style="width:100%;padding:11px;border:1px solid #d9dfe7;border-radius:8px;background:white"><option value="employee">Employé</option><option value="manager">Responsable</option></select>
   <p style="font-size:11px;color:#697586;margin:8px 0 0">Les droits d’accès sont contrôlés par Supabase (RLS), pas uniquement par l’interface.</p>
  </div>
  <div id="vlt-cloud-status">Non connecté. Utilise uniquement la Publishable key, jamais une Secret key.</div>
 </div>
</div>
<script>
(function(){
 const $=id=>document.getElementById(id);
 const modal=$('vlt-cloud-modal'), status=$('vlt-cloud-status');
 const cfgKey='vlt_supabase_config_v1', authKey='vlt_supabase_session_v1';
 let cfg={url:'https://rpqkyddidnnhtwczethm.supabase.co',key:''}, session=null;
 try{cfg={...cfg,...JSON.parse(localStorage.getItem(cfgKey)||'{}')};session=JSON.parse(localStorage.getItem(authKey)||'null')}catch(e){}
 $('vlt-sb-url').value=cfg.url||'';
 $('vlt-sb-key').value=cfg.key||'';
 if(session?.user?.email)$('vlt-sb-email').value=session.user.email;
 function say(s){status.textContent=s}
 function saveCfg(){cfg={url:$('vlt-sb-url').value.trim().replace(/\/+$/,''),key:$('vlt-sb-key').value.trim()};localStorage.setItem(cfgKey,JSON.stringify(cfg))}
 async function request(path,opts={}){
   saveCfg();
   if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(cfg.url))throw Error('Vérifie l’URL du projet Supabase.');
   if(!cfg.key.startsWith('sb_publishable_')&&!cfg.key.startsWith('eyJ'))throw Error('Colle la Publishable key, pas une clé secrète.');
   const headers={'Content-Type':'application/json','apikey':cfg.key,...(opts.headers||{})};
   const resp=await fetch(cfg.url+path,{...opts,headers});
   const body=await resp.text();let data;try{data=body?JSON.parse(body):null}catch{data=body}
   if(!resp.ok)throw Error(data?.msg||data?.message||data?.error_description||data?.error||('Erreur Supabase '+resp.status));
   return data;
 }
 function token(){if(!session?.access_token)throw Error('Connecte-toi d’abord.');return session.access_token}
 async function auth(action){
   const email=$('vlt-sb-email').value.trim(), password=$('vlt-sb-password').value;
   if(!email||!password)throw Error('Renseigne ton e-mail et ton mot de passe.');
   const data=await request('/auth/v1/'+action,{method:'POST',body:JSON.stringify({email,password})});
   if(data.access_token){session=data;localStorage.setItem(authKey,JSON.stringify(session));say('Connecté avec '+(data.user?.email||email)+'.')}
   else if(action==='signup')say('Compte créé. Si une confirmation par e-mail est demandée, confirme-la puis connecte-toi.');
   return data;
 }
 function collectLocal(){const out={};for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k&&k.startsWith('km_')){try{out[k]=JSON.parse(localStorage.getItem(k))}catch{out[k]=localStorage.getItem(k)}}}return out}
 function validateLocalSnapshot(local){
   const required=['km_establishments','km_active_establishment_id','km_establishment_data'];
   const missing=required.filter(k=>!(k in local));
   if(missing.length)throw Error('Sauvegarde interrompue : clés essentielles manquantes ('+missing.join(', ')+').');
   const active=local.km_active_establishment_id;
   if(typeof active!=='string'||!active.trim())throw Error('Aucun établissement actif valide n’a été trouvé.');
   const establishments=local.km_establishments;
   if(!Array.isArray(establishments)||!establishments.some(e=>e&&String(e.id)===active))throw Error('L’établissement actif ne correspond pas à la liste des établissements.');
   const allData=local.km_establishment_data;
   if(!allData||typeof allData!=='object'||Array.isArray(allData)||!allData[active]||typeof allData[active]!=='object')throw Error('Les données de l’établissement actif sont absentes ou invalides.');
   const d=allData[active];
   const requiredArrays=['stocks','recipes','preps','temps','movements','events','quotes'];
   const bad=requiredArrays.filter(k=>!Array.isArray(d[k]));
   if(bad.length)throw Error('Sauvegarde interrompue : sections absentes ou invalides ('+bad.join(', ')+').');
   return {active,sections:requiredArrays.length,items:requiredArrays.reduce((n,k)=>n+d[k].length,0)};
 }
 function downloadJsonFile(filename,object){
   const blob=new Blob([JSON.stringify(object,null,2)],{type:'application/json'});
   const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);
 }
 function scopedSnapshot(local, active){
   const establishments=Array.isArray(local.km_establishments)?local.km_establishments:[];
   const selected=establishments.find(e=>e&&String(e.id)===String(active));
   const allData=local.km_establishment_data||{};
   if(!selected||!allData[active]||typeof allData[active]!=='object')throw Error('Établissement actif introuvable ou sans données.');
   const scoped={
     km_establishments:[selected],
     km_active_establishment_id:String(active),
     km_establishment_data:{[String(active)]:allData[active]}
   };
   for(const [k,v] of Object.entries(local)){
     if(['km_establishments','km_active_establishment_id','km_establishment_data'].includes(k))continue;
     if(k.startsWith('km_') && (k.endsWith('_'+active) || k.endsWith('-'+active) || k.includes('_'+active+'_')))scoped[k]=v;
   }
   return scoped;
 }
 async function upload(){
   if(!session?.user?.id)throw Error('Connecte-toi d’abord.');
   const local=collectLocal();
   const active=local.km_active_establishment_id;
   if(typeof active!=='string'||!active.trim())throw Error('Choisis un établissement avant la synchronisation.');
   const scoped=scopedSnapshot(local,active);
   const check=validateLocalSnapshot(scoped);
   const payload={schemaVersion:1,source:'VLT Food Management V1.40 Team',establishmentId:String(active),localStorage:scoped,savedAt:new Date().toISOString(),validation:{sections:check.sections,items:check.items}};
   await request('/rest/v1/rpc/vlt_save_establishment_data',{method:'POST',headers:{Authorization:'Bearer '+token()},body:JSON.stringify({p_establishment_id:String(active),p_data:payload})});
   say('Synchronisation partagée terminée pour cet établissement : '+check.sections+' sections, '+check.items+' éléments. Les autres établissements ne sont pas envoyés.');
 }
 async function download(){
   if(!session?.user?.id)throw Error('Connecte-toi d’abord.');
   const localBefore=collectLocal();
   const active=localBefore.km_active_establishment_id;
   if(typeof active!=='string'||!active.trim())throw Error('Choisis un établissement avant de récupérer les données.');
   const qs='?select=data,updated_at&establishment_id=eq.'+encodeURIComponent(String(active))+'&limit=1';
   const rows=await request('/rest/v1/vlt_establishment_data'+qs,{headers:{Authorization:'Bearer '+token()}});
   if(!Array.isArray(rows)||!rows.length)throw Error('Aucune sauvegarde partagée trouvée pour cet établissement. Vérifie que tu es membre de cet établissement.');
   const cloud=rows[0].data?.localStorage;
   if(!cloud||typeof cloud!=='object'||Array.isArray(cloud))throw Error('La sauvegarde cloud ne contient pas de données reconnues.');
   try{validateLocalSnapshot(cloud)}catch(e){throw Error('La sauvegarde cloud n’a pas passé le contrôle de cohérence : '+e.message+' Aucune donnée locale n’a été modifiée.');}
   if(String(cloud.km_active_establishment_id)!==String(active))throw Error('La sauvegarde reçue ne correspond pas à l’établissement actif. Aucune donnée locale n’a été modifiée.');
   if(!confirm('Les données de cet établissement ont passé les contrôles. Un fichier de secours sera téléchargé avant restauration. Continuer ?'))return;
   downloadJsonFile('VLT_'+String(active)+'_avant_restauration_'+new Date().toISOString().replace(/[:.]/g,'-')+'.json',{source:'VLT - sauvegarde locale avant restauration',savedAt:new Date().toISOString(),localStorage:localBefore});
   if(!confirm('Confirme que le fichier de secours a bien été téléchargé. Seules les données de l’établissement actif seront remplacées.'))return;
   const merged={...localBefore,...cloud};
   const existingEstablishments=Array.isArray(localBefore.km_establishments)?localBefore.km_establishments:[];
   const selected=cloud.km_establishments[0];
   merged.km_establishments=[...existingEstablishments.filter(e=>String(e?.id)!==String(active)),selected];
   const existingData=localBefore.km_establishment_data&&typeof localBefore.km_establishment_data==='object'?localBefore.km_establishment_data:{};
   merged.km_establishment_data={...existingData,[String(active)]:cloud.km_establishment_data[String(active)]};
   merged.km_active_establishment_id=String(active);
   for(const [k,v] of Object.entries(merged)){if(k.startsWith('km_'))localStorage.setItem(k,JSON.stringify(v));}
   say('Données de cet établissement récupérées. Les autres établissements locaux ont été conservés. Recharge la page pour les afficher.');
 }
 async function inviteEmployee(){
   if(!session?.user?.id)throw Error('Connecte-toi d’abord.');
   const local=collectLocal(), active=local.km_active_establishment_id;
   if(!active)throw Error('Aucun établissement actif.');
   const email=$('vlt-team-email').value.trim().toLowerCase();
   const role=$('vlt-team-role').value;
   if(!email||!email.includes('@'))throw Error('Saisis une adresse e-mail valide.');
   const result=await request('/functions/v1/vlt-invite-employee',{method:'POST',headers:{Authorization:'Bearer '+token()},body:JSON.stringify({email,establishment_id:String(active),role})});
   say('Invitation envoyée à '+email+'. L’employé devra ouvrir l’e-mail, accepter l’invitation et créer son mot de passe.');
   $('vlt-team-email').value='';
   return result;
 }
 async function wrap(fn,msg){try{say(msg);await fn()}catch(e){say('Erreur : '+e.message)}}
 $('vlt-cloud-launch').addEventListener('click',function(e){e.preventDefault();modal.classList.add('open');modal.style.display='block';say('Panneau ouvert. Renseigne tes informations pour continuer.')});
 $('vlt-cloud-close').addEventListener('click',()=>{modal.classList.remove('open');modal.style.display='none'});
 $('vlt-cloud-register').addEventListener('click',()=>wrap(()=>auth('signup'),'Création du compte…'));
 $('vlt-cloud-login').addEventListener('click',()=>wrap(()=>auth('token?grant_type=password'),'Connexion…'));
 $('vlt-cloud-upload').addEventListener('click',()=>wrap(upload,'Envoi des données…'));
 $('vlt-cloud-download').addEventListener('click',()=>wrap(download,'Recherche de la sauvegarde…'));
 $('vlt-team-invite').addEventListener('click',()=>wrap(inviteEmployee,'Envoi de l’invitation…'));
 $('vlt-cloud-logout').addEventListener('click',()=>{session=null;localStorage.removeItem(authKey);say('Déconnecté. Les données locales restent sur cet appareil.')});
})();
</script>

<style id="vlt-v129-account-settings-help">
#vlt-v129-scan-shortcut{position:fixed;right:14px;bottom:126px;z-index:1450;border:0!important;border-radius:999px!important;background:#f3a712!important;color:#241a06!important;padding:12px 16px!important;box-shadow:0 8px 24px #10182735!important;font-weight:800!important}
#vlt-v129-open{position:fixed;right:14px;bottom:72px;z-index:1450;border:0!important;border-radius:999px!important;background:#17233b!important;color:#fff!important;padding:12px 16px!important;box-shadow:0 8px 24px #10182735!important;font-weight:800!important}
#vlt-v129-modal{display:none;position:fixed;inset:0;z-index:1700;background:#101827a8;padding:12px;overflow:auto}
#vlt-v129-modal.open{display:block}
#vlt-v129-card{max-width:720px;margin:3vh auto;background:#fff;color:#172033;border-radius:18px;padding:18px;box-shadow:0 20px 60px #10182740}
.vlt129-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.vlt129-head h2{margin:0;font-size:22px!important}
.vlt129-tabs{display:flex;gap:7px;overflow:auto;padding:3px 0 12px}
.vlt129-tabs button{white-space:nowrap;border:1px solid #dfe5ef!important;background:#f7f9fc!important;padding:10px 12px!important}
.vlt129-tabs button.active{background:#eaf0ff!important;border-color:#b8c8ff!important;color:#234cc3!important}
.vlt129-pane{display:none}.vlt129-pane.active{display:block}
.vlt129-box{border:1px solid #e5eaf2;border-radius:13px;padding:14px;margin:8px 0}
.vlt-profile-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:12px 0;padding:12px;background:#f8faff;border:1px solid #e5eaf2;border-radius:14px}
.vlt-profile-avatar{width:76px;height:76px;flex:0 0 76px;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#e8edf7;border:2px solid #d5def2;font-size:34px}
.vlt-profile-avatar img{width:100%;height:100%;object-fit:cover}
.vlt-profile-choices{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
.vlt-profile-choice{width:38px;height:38px;border:1px solid #d8dfeb;border-radius:50%;background:#fff;font-size:21px;cursor:pointer}
.vlt-profile-choice.active{outline:3px solid #d6a23b;border-color:#bd8a24;background:#fff8e6}
#vlt-v129-open{display:flex;align-items:center;gap:8px}
#vlt-v129-open .vlt-profile-mini{width:26px;height:26px;border-radius:50%;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;background:#e8edf7;font-size:16px}
#vlt-v129-open .vlt-profile-mini img{width:100%;height:100%;object-fit:cover}
.account-avatar{width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;vertical-align:middle;margin-right:8px;border-radius:50%;overflow:hidden;background:#e8edf7;font-size:20px;border:1px solid #dbe3f1}
.account-avatar img{width:100%;height:100%;object-fit:cover}

.vlt129-box h3{margin:0 0 8px}
.vlt129-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.vlt129-muted{color:#667085;font-size:13px;line-height:1.5}
.vlt129-help details{padding:12px 0;border-bottom:1px solid #e7ebf2}
.vlt129-help summary{font-weight:750;cursor:pointer}
#vlt129-status{font-size:12px;color:#667085;margin-top:8px}
@media(max-width:560px){#vlt-v129-card{padding:13px;margin:1vh auto}.vlt129-grid{grid-template-columns:1fr}#vlt-v129-open{right:10px;bottom:68px}#vlt-v129-scan-shortcut{right:10px;bottom:120px}}
</style>
<button id="vlt-v129-scan-shortcut" type="button" aria-haspopup="dialog">📸 Scanner</button>
<button id="vlt-v129-open" type="button" aria-haspopup="dialog"><span class="vlt-profile-mini" id="vlt129-global-avatar">👨‍🍳</span><span>☰ Mon espace</span></button>
<div id="vlt-v129-modal" role="dialog" aria-modal="true" aria-label="Mon espace VLT">
 <section id="vlt-v129-card">
  <div class="vlt129-head"><h2>Mon espace VLT</h2><button id="vlt-v129-close" type="button" aria-label="Fermer">✕ Fermer</button></div>
  <div class="vlt129-tabs" role="tablist">
   <button type="button" class="active" data-vlt129-tab="account">👤 Mon compte</button>
   <button type="button" data-vlt129-tab="scanner">📸 Scanner</button>
   <button type="button" data-vlt129-tab="settings">⚙️ Paramètres</button>
   <button type="button" data-vlt129-tab="help">❔ Aide</button>
  </div>
  <div id="vlt129-account" class="vlt129-pane active">
   <div class="vlt129-box"><h3>Profil local</h3><p class="vlt129-muted">Ces informations personnalisent l’affichage sur cet appareil. Ce profil n’est pas un compte sécurisé et ne remplace pas une connexion Supabase.</p>
    <div class="vlt-profile-row"><div class="vlt-profile-avatar" id="vlt129-avatar-preview" aria-label="Aperçu de la photo de profil">👨‍🍳</div><div style="flex:1;min-width:210px"><label for="vlt129-avatar-file">Photo de profil</label><input id="vlt129-avatar-file" type="file" accept="image/*"><small class="vlt129-muted">Choisis une photo depuis ton ordinateur ou ton téléphone, ou sélectionne un avatar ci-dessous.</small><div class="vlt-profile-choices" id="vlt129-avatar-choices" aria-label="Choisir un avatar"><button type="button" class="vlt-profile-choice" data-avatar="👨‍🍳" aria-label="Cuisinier">👨‍🍳</button><button type="button" class="vlt-profile-choice" data-avatar="👩‍🍳" aria-label="Cuisinière">👩‍🍳</button><button type="button" class="vlt-profile-choice" data-avatar="🧑‍🍳" aria-label="Chef cuisinier">🧑‍🍳</button><button type="button" class="vlt-profile-choice" data-avatar="🙂" aria-label="Souriant">🙂</button><button type="button" class="vlt-profile-choice" data-avatar="😎" aria-label="Lunettes de soleil">😎</button><button type="button" class="vlt-profile-choice" data-avatar="⭐" aria-label="Étoile">⭐</button><button type="button" class="vlt-profile-choice" data-avatar="🍔" aria-label="Burger">🍔</button></div></div></div>
    <div class="vlt129-grid"><div><label for="vlt129-name">Nom affiché</label><input id="vlt129-name" placeholder="Nom ou prénom"></div><div><label for="vlt129-email">E-mail (facultatif)</label><input id="vlt129-email" type="email" placeholder="vous@exemple.fr"></div></div>
    <div style="margin-top:12px"><button type="button" class="btn primary" id="vlt129-save-profile">Enregistrer le profil</button></div><div id="vlt129-status">Profil enregistré uniquement dans ce navigateur.</div>
   </div>
   <div class="vlt129-box"><h3>Compte et sécurité</h3><p class="vlt129-muted">La création d’un compte sécurisé et la récupération du mot de passe doivent être configurées dans Supabase. Ne saisis jamais ici de clé secrète.</p></div>
  </div>
  <div id="vlt129-scanner" class="vlt129-pane">
   <div class="vlt129-box"><h3>📸 Scanner un produit</h3><p class="vlt129-muted">Prends en photo une étiquette ou un emballage. Le site peut tenter de lire le texte et le code-barres, puis tu vérifies la fiche avant de l’ajouter.</p><button type="button" class="btn primary" data-vlt129-go="photo">Ouvrir le scanner produit →</button></div>
   <div class="vlt129-box"><h3>📋 Scanner un cadencier</h3><p class="vlt129-muted">Photographie le cadencier ou choisis l’image dans la galerie. La lecture prépare les lignes à vérifier. Les tableaux serrés ou les références peu lisibles peuvent nécessiter une correction manuelle.</p><button type="button" class="btn primary" data-vlt129-go="invoices" data-vlt129-doc="cadencier">Lire un cadencier →</button></div>
   <div class="vlt129-box"><h3>🧾 Scanner une facture ou un bon de livraison</h3><p class="vlt129-muted">Importe une photo de la facture. Le site extrait les lignes et te laisse vérifier les quantités, références et prix avant de valider l’entrée en stock.</p><button type="button" class="btn primary" data-vlt129-go="invoices">Scanner une facture →</button></div>
   <div class="vlt129-box" role="note" style="border:1px solid #efc36a;background:#fff7df;color:#754b00"><strong>⚠️ À savoir avant d’utiliser le scanner</strong><p>Les photos peuvent être mal lues : vérifie toujours les noms, références, quantités et prix. Une photo nette, bien éclairée et prise de face réduit les erreurs, sans les supprimer.</p></div>
   <p class="vlt129-muted">La reconnaissance utilise une bibliothèque de lecture chargée depuis Internet. Les données ne sont pas ajoutées automatiquement sans validation. Pour les PDF, cette version demande une photo ou une capture d’écran.</p>
  </div>
  <div id="vlt129-settings" class="vlt129-pane">
   <div class="vlt129-box"><h3>Préférences</h3>
    <div class="vlt129-grid"><div><label for="vlt129-density">Taille d’affichage</label><select id="vlt129-density"><option value="normal">Normale</option><option value="large">Plus grande (téléphone)</option></select></div><div><label for="vlt129-motion">Animations</label><select id="vlt129-motion"><option value="on">Activées</option><option value="off">Réduites</option></select></div></div>
    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn primary" id="vlt129-save-settings">Enregistrer les paramètres</button><button type="button" class="btn" id="vlt129-reset-settings">Réinitialiser l’affichage</button></div>
   </div>
   <div class="vlt129-box"><h3>Données</h3><p class="vlt129-muted">Les données de l’application peuvent être enregistrées localement dans ce navigateur. Pour l’instant, fais régulièrement une sauvegarde et ne vide pas les données du navigateur si tu n’as pas de copie.</p></div>
  </div>
  <div id="vlt129-help" class="vlt129-pane vlt129-help">
   <div class="vlt129-box"><h3>Centre d’aide</h3><p class="vlt129-muted">Choisis un sujet pour afficher les conseils de base.</p>
    <details><summary>Comment utiliser le stock ?</summary><p class="vlt129-muted">Ouvre la rubrique Stock dans le menu principal. Mets à jour les quantités et vérifie les alertes de stock bas. Vérifie les unités avant d’enregistrer.</p></details>
    <details><summary>Comment gérer les recettes et les coûts ?</summary><p class="vlt129-muted">Ouvre Recettes, ajoute les ingrédients et leurs quantités, puis contrôle les coûts calculés avant d’utiliser les chiffres pour fixer un prix.</p></details>
    <details><summary>Comment gérer les températures et l’hygiène ?</summary><p class="vlt129-muted">Enregistre les contrôles au moment où ils sont effectués. N’inscris pas une mesure estimée à la place d’une mesure réelle.</p></details>
    <details><summary>Comment utiliser l’application sur deux appareils ?</summary><p class="vlt129-muted">Les données locales ne se transfèrent pas automatiquement entre téléphone et ordinateur. La synchronisation Supabase doit être configurée et testée avant de compter dessus.</p></details>
    <details><summary>Le site affiche une page blanche ou un bouton ne répond pas</summary><p class="vlt129-muted">Actualise la page. Si le problème persiste, garde l’ancienne version et une sauvegarde, puis signale le nom du bouton et le message d’erreur exact.</p></details>
   </div>
  </div>
 </section>
</div>
<script id="vlt-v129-account-settings-help-js">
(function(){
 const $=id=>document.getElementById(id);
 const modal=$('vlt-v129-modal');
 if(!modal||!$('vlt-v129-open'))return;
 const key='vlt_v129_preferences';
 let prefs={name:'',email:'',photo:'',avatar:'👨‍🍳',density:'normal',motion:'on'};
 try{prefs={...prefs,...JSON.parse(localStorage.getItem(key)||'{}')}}catch(e){}
 $('vlt129-name').value=prefs.name||'';
 $('vlt129-email').value=prefs.email||'';
 function profileAvatarHTML(){return prefs.photo?'<img alt="Photo de profil" src="'+prefs.photo+'">':(prefs.avatar||'👨‍🍳')}
 function updateProfileAvatar(){const preview=$('vlt129-avatar-preview'),global=$('vlt129-global-avatar');if(preview)preview.innerHTML=profileAvatarHTML();if(global)global.innerHTML=profileAvatarHTML();document.querySelectorAll('[data-avatar]').forEach(b=>b.classList.toggle('active',!prefs.photo&&b.dataset.avatar===prefs.avatar));}
 function profileImageDataUrl(file,maxSize=320){return new Promise((resolve,reject)=>{if(!file||!file.type.startsWith('image/'))return reject(new Error('Choisis un fichier image.'));const reader=new FileReader();reader.onload=()=>{const img=new Image();img.onload=()=>{const scale=Math.min(1,maxSize/Math.max(img.width,img.height));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*scale));c.height=Math.max(1,Math.round(img.height*scale));c.getContext('2d').drawImage(img,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.78));};img.onerror=()=>reject(new Error('Impossible de lire cette image.'));img.src=reader.result;};reader.onerror=()=>reject(new Error('Lecture du fichier impossible.'));reader.readAsDataURL(file);});}
 updateProfileAvatar();
 $('vlt129-avatar-file').addEventListener('change',async e=>{const file=e.target.files?.[0];if(!file)return;try{prefs.photo=await profileImageDataUrl(file);updateProfileAvatar();$('vlt129-status').textContent='Photo choisie. Clique sur « Enregistrer le profil » pour la conserver.';}catch(err){alert(err.message||'Impossible de charger la photo.');e.target.value='';}});
 document.querySelectorAll('[data-avatar]').forEach(b=>b.addEventListener('click',()=>{prefs.avatar=b.dataset.avatar;prefs.photo='';$('vlt129-avatar-file').value='';updateProfileAvatar();$('vlt129-status').textContent='Avatar choisi. Clique sur « Enregistrer le profil » pour le conserver.';}));
 $('vlt129-density').value=prefs.density||'normal';
 $('vlt129-motion').value=prefs.motion||'on';
 function save(){localStorage.setItem(key,JSON.stringify(prefs))}
 function open(tab){modal.classList.add('open');modal.style.display='block';if(tab)activate(tab)}
 function close(){modal.classList.remove('open');modal.style.display='none'}
 function activate(tab){
  document.querySelectorAll('[data-vlt129-tab]').forEach(b=>b.classList.toggle('active',b.dataset.vlt129Tab===tab));
  document.querySelectorAll('.vlt129-pane').forEach(p=>p.classList.toggle('active',p.id==='vlt129-'+tab));
 }
 $('vlt-v129-open').addEventListener('click',()=>open('account'));
 const scannerShortcut=$('vlt-v129-scan-shortcut');
 scannerShortcut.addEventListener('click',function(ev){ev.preventDefault();ev.stopPropagation();open('scanner');});
 function goToVltPage(page){
  close();
  if(typeof window.showPage==='function'){window.showPage(page);return true;}
  const nav=document.querySelector('.nav button[data-page="'+page+'"]');
  if(nav){nav.click();return true;}
  const target=document.getElementById(page);
  if(target){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p===target));return true;}
  return false;
 }
 document.querySelectorAll('[data-vlt129-go]').forEach(b=>b.addEventListener('click',function(ev){
  ev.preventDefault();
  const page=b.getAttribute('data-vlt129-go');
  const ok=goToVltPage(page);
  if(page==='invoices' && b.getAttribute('data-vlt129-doc')==='cadencier'){
    const heading=document.querySelector('#invoices .panel-head h2');
    if(heading)heading.textContent='1. Photographier ou importer un cadencier / une facture';
    const label=document.querySelector('label[for="invoice-file"]');
    if(label)label.textContent='Photo du cadencier, facture ou bon de livraison';
    const status=document.getElementById('invoice-status');
    if(status)status.textContent='Choisis une photo de cadencier pour commencer. Vérifie chaque ligne avant de valider.';
  }
  if(!ok){open('scanner');alert('La rubrique demandée n’a pas été trouvée. Ouvre le menu principal et essaie la rubrique Photo produit ou Factures & livraisons.');}
 }));
 $('vlt-v129-close').addEventListener('click',close);
 modal.addEventListener('click',e=>{if(e.target===modal)close()});
 document.querySelectorAll('[data-vlt129-tab]').forEach(b=>b.addEventListener('click',()=>activate(b.dataset.vlt129Tab)));
 $('vlt129-save-profile').addEventListener('click',()=>{
  prefs.name=$('vlt129-name').value.trim();prefs.email=$('vlt129-email').value.trim();save();updateProfileAvatar();
  $('vlt129-status').textContent='Profil et photo enregistrés sur cet appareil. La photo apparaît aussi sur le bouton Mon espace.';
 });
 $('vlt129-save-settings').addEventListener('click',()=>{
  prefs.density=$('vlt129-density').value;prefs.motion=$('vlt129-motion').value;save();
  document.documentElement.style.fontSize=prefs.density==='large'?'17px':'';
  document.documentElement.style.scrollBehavior=prefs.motion==='off'?'auto':'smooth';
  $('vlt129-status').textContent='Paramètres enregistrés.';
 });
 $('vlt129-reset-settings').addEventListener('click',()=>{
  prefs.density='normal';prefs.motion='on';$('vlt129-density').value='normal';$('vlt129-motion').value='on';
  document.documentElement.style.fontSize='';document.documentElement.style.scrollBehavior='smooth';save();
 });
 if(prefs.density==='large')document.documentElement.style.fontSize='17px';
 if(prefs.motion==='off')document.documentElement.style.scrollBehavior='auto';
})();

/* V1.40 — navigation carte mentale. Ne modifie aucune donnée métier ni clé de stockage. */
(function(){
 const map=document.getElementById('vlt-mindmap');
 const openBtn=document.getElementById('vlt-mindmap-open');
 const closeBtn=document.getElementById('vlt-mindmap-close');
 const search=document.getElementById('vlt-mindmap-search');
 const collapse=document.getElementById('vlt-mindmap-collapse');
 const home=document.getElementById('vlt-mindmap-home');
 if(!map||!openBtn||!closeBtn)return;
 let previousFocus=null;
 function syncAccess(){
   map.querySelectorAll('[data-mm-page]').forEach(node=>{
     const page=node.getAttribute('data-mm-page');
     const nav=document.querySelector('.nav button[data-page="'+page+'"]');
     const role=node.getAttribute('data-mm-role');
     const roleSelect=document.getElementById('role-select');
     const roleValue=roleSelect?roleSelect.value:'admin';
     let allowed=!!nav && getComputedStyle(nav).display!=='none';
     if(role==='admin' && roleValue!=='admin') allowed=false;
     if(role==='patron' && roleValue==='employe') allowed=false;
     node.hidden=!allowed;
   });
   map.querySelectorAll('.vlt-mm-branch').forEach(branch=>{
     const any=[...branch.querySelectorAll('[data-mm-page]')].some(n=>!n.hidden);
     branch.hidden=!any;
   });
 }
 function openMap(){previousFocus=document.activeElement;syncAccess();map.classList.add('open');map.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';openBtn.setAttribute('aria-expanded','true');setTimeout(()=>search&&search.focus(),30)}
 function closeMap(){map.classList.remove('open');map.setAttribute('aria-hidden','true');document.body.style.overflow='';openBtn.setAttribute('aria-expanded','false');openBtn.focus()}
 function filterMap(){const q=(search.value||'').trim().toLocaleLowerCase('fr');let visible=0;
   map.querySelectorAll('.vlt-mm-branch').forEach(branch=>{let branchHas=false;const head=branch.querySelector('.vlt-mm-branch-head');const headText=(head?head.innerText:'').toLocaleLowerCase('fr');
     branch.querySelectorAll('[data-mm-page]').forEach(node=>{if(node.hidden)return;const hit=!q||node.innerText.toLocaleLowerCase('fr').includes(q)||headText.includes(q);node.style.display=hit?'':'none';if(hit){branchHas=true;visible++}});
     const show=!q||branchHas||headText.includes(q);branch.hidden=!show;if(q&&show){branch.classList.add('open');const h=branch.querySelector('.vlt-mm-branch-head');if(h)h.setAttribute('aria-expanded','true')}else if(!q){branch.classList.remove('open');const h=branch.querySelector('.vlt-mm-branch-head');if(h)h.setAttribute('aria-expanded','false')}
     if(q&&headText.includes(q)){branch.querySelectorAll('[data-mm-page]').forEach(n=>{if(!n.hidden){n.style.display='';visible++}})}
   });
   const empty=document.getElementById('vlt-mindmap-empty');if(empty)empty.hidden=visible>0;
 }
 openBtn.addEventListener('click',openMap);closeBtn.addEventListener('click',closeMap);
 map.addEventListener('click',e=>{if(e.target===map)closeMap()});
 map.querySelectorAll('.vlt-mm-branch-head').forEach(head=>head.addEventListener('click',()=>{const branch=head.closest('.vlt-mm-branch');const expanded=branch.classList.toggle('open');head.setAttribute('aria-expanded',String(expanded));head.querySelector('.vlt-mm-chevron').textContent=expanded?'−':'＋'}));
 map.querySelectorAll('[data-mm-page]').forEach(node=>node.addEventListener('click',()=>{if(node.hidden)return;const page=node.getAttribute('data-mm-page');closeMap();if(typeof window.showPage==='function')window.showPage(page);else{const nav=document.querySelector('.nav button[data-page="'+page+'"]');if(nav)nav.click()}}));
 if(search)search.addEventListener('input',filterMap);
 if(collapse)collapse.addEventListener('click',()=>{map.querySelectorAll('.vlt-mm-branch').forEach(b=>{b.classList.remove('open');const h=b.querySelector('.vlt-mm-branch-head');if(h){h.setAttribute('aria-expanded','false');const c=h.querySelector('.vlt-mm-chevron');if(c)c.textContent='＋'};b.querySelectorAll('[data-mm-page]').forEach(n=>n.style.display='')});if(search){search.value='';filterMap()}});
 if(home)home.addEventListener('click',()=>{closeMap();if(typeof window.showPage==='function')window.showPage('dashboard')});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&map.classList.contains('open'))closeMap()});
 const roleSelect=document.getElementById('role-select');if(roleSelect)roleSelect.addEventListener('change',syncAccess);
})();

</script>
</body>
</html>
